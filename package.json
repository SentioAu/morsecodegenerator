{
  "name": "morsecodegenerator-com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/postbuild-glossary-links.mjs && node ./scripts/postbuild-sitemap.mjs && node ./scripts/postbuild-news-sitemap.mjs && node ./scripts/postbuild-og.mjs && node ./scripts/verify-build.mjs && node ./scripts/indexnow-ping.mjs",
    "verify": "node ./scripts/verify-build.mjs",
    "indexnow": "node ./scripts/indexnow-ping.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true})); import('node:fs').then(fs=>fs.rmSync('.astro',{recursive:true,force:true}));\""
  },
  "dependencies": {
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@resvg/resvg-js": "^2.6.2"
  }
}
