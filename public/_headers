# Cloudflare Pages headers
# ----------------------------------------------------------------------
# Two goals: (1) make cache behaviour explicit so the service worker
# and the CDN cooperate instead of fighting over freshness, and
# (2) set the security headers an independent audit (Mozilla
# Observatory, SecurityHeaders.com) looks for.
#
# Headers are scoped by path glob, with later-matching rules
# overriding earlier ones on the same header.
# ----------------------------------------------------------------------

# --- Global defaults (apply to every URL) ----------------------------
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), geolocation=(), payment=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Default frame-ancestors locks pages to same-origin. /embed.html
  # opens this up explicitly further down because the whole point of
  # that file is third-party embedding.
  Content-Security-Policy: frame-ancestors 'self'

# --- HTML pages -----------------------------------------------------
# HTML should never be edge-cached for long — the SW is now
# network-first and we want every navigation to see fresh HTML when
# the network is healthy. Cloudflare honours `must-revalidate` and the
# 0-second max-age, so the edge caches the response (good for the
# busy second after publish) but every visit revalidates with origin.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# --- Service worker -------------------------------------------------
# The SW file itself must not be long-cached or new SW versions can't
# propagate. Browsers also enforce a 24h cap on SW caching, but the
# header makes the intent explicit.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# --- Astro hashed assets (immutable) --------------------------------
# Filenames carry a content hash so we can lock the cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# --- /morse.json — short browser cache, long edge cache --------------
# 5 min browser cache, 1 day CDN cache, 1 week stale-while-revalidate.
# Updates to morse.json propagate to readers within 5 min while
# spreading edge load over a much longer window.
/morse.json
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# --- Static brand assets -------------------------------------------
/favicon.svg
  Cache-Control: public, max-age=604800
/og-image.svg
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# --- /llms.txt + /llms-full.txt + /ai.txt --------------------------
# AI/LLM crawlers should always see the freshest policy.
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/ai.txt
  Cache-Control: public, max-age=86400

# --- /embed.html — open frame-ancestors so users can iframe it ------
# This is the one file that *must* be embeddable from any origin,
# because the whole point is third-party blogs and classroom sites
# putting the translator on their page. Everything else stays
# locked to same-origin via the global rule above.
#
# Cloudflare Pages JOINS duplicate header values with commas across
# matching path globs rather than letting later blocks override
# earlier ones. The `! Header-Name` directive detaches the inherited
# value before we set a fresh one. Without `!` the browser would see
#   Content-Security-Policy: frame-ancestors 'self', frame-ancestors *
# and apply the stricter directive, breaking third-party embeds.
/embed.html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors *
  ! Cache-Control
  Cache-Control: public, max-age=300
