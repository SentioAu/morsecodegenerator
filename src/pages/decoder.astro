---
import Layout from "../components/Layout.astro";

const title = "Morse Code Decoder – Decode Dots and Dashes to Text";
const description =
  "Free Morse code decoder. Paste dots and dashes and instantly get plain text. Auto-detect, audio playback, copy and share — runs in your browser.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/decoder/`;
const robots = "index,follow";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Decoder", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
    {
      "@type": "HowTo",
      name: "How to decode Morse code to text",
      description: "Convert dots and dashes to plain English in seconds.",
      totalTime: "PT30S",
      tool: [{ "@type": "HowToTool", name: "MorseCodeGenerator.com decoder" }],
      step: [
        { "@type": "HowToStep", name: "Open the decoder (this page)" },
        { "@type": "HowToStep", name: "Paste your Morse code into the input box (e.g. '... --- ...')." },
        { "@type": "HowToStep", name: "The tool auto-detects Morse and shows the decoded text." },
        { "@type": "HowToStep", name: "Copy the result or play it back as audio." },
      ],
    },
  ],
};

const examples = [
  ["... --- ...", "SOS"],
  [".... . .-.. .-.. ---", "HELLO"],
  [".... . .-.. .-.. --- / .-- --- .-. .-.. -..", "HELLO WORLD"],
  ["-- .- -.-- -.. .- -.--", "MAYDAY"],
  [".. / .-.. --- ...- . / -.-- --- ..-", "I LOVE YOU"],
  ["- .... .- -. -.- / -.-- --- ..-", "THANK YOU"],
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Decoder</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">Decode · Auto-detect · Audio</p>
    <h1 class="page-hero-title">Morse code decoder</h1>
    <p class="muted page-hero-sub">
      Paste dots, dashes, and slashes — get plain text instantly. Runs in your browser, no upload, no
      account. Need to encode the other direction? Use the <a href="/translate/">translator</a>.
    </p>
  </header>

  <section class="decoder" aria-label="Morse code decoder">
    <div class="decoder-head">
      <span class="dot-on" aria-hidden="true"></span>
      <span class="d-meta">Spaces between letters · <span class="k">/</span> between words</span>
    </div>

    <div class="decoder-body">
      <label class="field">
        <span class="field-label">Morse code</span>
        <textarea
          id="dec-input"
          class="t-area mono"
          rows="6"
          placeholder="... --- ..."
          spellcheck="false"
          autocorrect="off"
          autocapitalize="off"
          maxlength="5000"
        >... --- ...</textarea>
      </label>

      <div class="decoder-actions">
        <button id="dec-clear" type="button" class="ghost">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          Clear
        </button>
        <button id="dec-paste" type="button" class="ghost">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Paste
        </button>
      </div>

      <label class="field">
        <span class="field-label">Decoded text</span>
        <textarea
          id="dec-output"
          class="t-area"
          rows="3"
          readonly
          placeholder="Decoded text appears here…"
          spellcheck="false"
        ></textarea>
      </label>

      <div class="decoder-actions">
        <button id="dec-copy" type="button" class="primary-action">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy text
        </button>
        <button id="dec-play" type="button" class="ghost">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 3v18l14-9L5 3z"/></svg>
          Play
        </button>
        <a class="btn ghost" href="/translate/">Switch to encoder →</a>
      </div>

      <p id="dec-status" class="muted decoder-status" aria-live="polite"></p>
    </div>
  </section>

  {/* ============== Live mic decoder (experimental) ============== */}
  <section class="mic" aria-label="Live microphone decoder">
    <div class="mic-head">
      <div class="mic-head-left">
        <span class="mic-badge">Experimental</span>
        <h2 class="mic-title">Listen with your microphone</h2>
      </div>
      <p class="mic-sub muted">
        Tap <strong>Start listening</strong>, then play or send Morse near your mic. We detect tones,
        time their length, and decode them in real time. Works best with a clean 500–800 Hz tone at
        15–25 WPM.
      </p>
    </div>

    <div class="mic-body">
      <div class="mic-controls">
        <button id="mic-start" type="button" class="primary-action">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <path d="M12 19v3"/>
          </svg>
          Start listening
        </button>
        <button id="mic-stop" type="button" class="ghost" disabled>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
          Stop
        </button>
        <button id="mic-clear" type="button" class="ghost">Clear</button>

        <label class="mic-thresh">
          <span class="mic-thresh-label">Sensitivity</span>
          <input id="mic-thresh" type="range" min="20" max="80" value="40" step="1" />
        </label>
      </div>

      <div class="mic-meter" aria-hidden="true">
        <div id="mic-level" class="mic-meter-fill"></div>
        <div id="mic-threshold-line" class="mic-meter-line"></div>
      </div>

      <div class="mic-grid">
        <div class="mic-field">
          <span class="field-label">Detected dots &amp; dashes</span>
          <pre id="mic-morse" class="mic-out mono" aria-live="polite"></pre>
        </div>
        <div class="mic-field">
          <span class="field-label">Decoded text</span>
          <pre id="mic-text" class="mic-out" aria-live="polite"></pre>
        </div>
      </div>

      <p id="mic-status" class="muted mic-status" aria-live="polite">
        Microphone access is requested only when you press Start. Audio never leaves your device.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Examples</p>
        <h2 class="section-title">Common patterns</h2>
      </div>
      <p class="section-sub muted">Click any row to decode it instantly.</p>
    </div>
    <div class="ex-list">
      {examples.map(([code, plain]) => (
        <button class="ex" type="button" data-morse={code}>
          <span class="ex-morse mono">{code}</span>
          <span class="ex-arrow" aria-hidden="true">→</span>
          <span class="ex-plain">{plain}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">How decoding works</p>
        <h2 class="section-title">The format in one line</h2>
      </div>
    </div>
    <dl class="reading-key">
      <div>
        <dt>Dot</dt>
        <dd><span class="k">.</span> &nbsp; short signal (1 unit)</dd>
      </div>
      <div>
        <dt>Dash</dt>
        <dd><span class="k">-</span> &nbsp; long signal (3 units)</dd>
      </div>
      <div>
        <dt>Letter gap</dt>
        <dd>a single space between letters (3 units)</dd>
      </div>
      <div>
        <dt>Word gap</dt>
        <dd><span class="k">/</span> &nbsp; with surrounding spaces (7 units)</dd>
      </div>
    </dl>
    <p class="muted" style="margin-top: var(--s-4);">
      The decoder also accepts middle-dot (<span class="k">·</span>), bullet (<span class="k">•</span>),
      en-dash (<span class="k">–</span>), em-dash (<span class="k">—</span>), and pipe (<span class="k">|</span>) as separators.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Related</p>
        <h2 class="section-title">Keep going</h2>
      </div>
    </div>
    <div class="pill-grid">
      <a href="/translate/">Text → Morse</a>
      <a href="/practice/">Practice / Koch trainer</a>
      <a href="/chart/">Printable chart</a>
      <a href="/morse-code/">Alphabet A–Z</a>
      <a href="/phrases/">Common phrases</a>
      <a href="/faq/">FAQ</a>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (function () {
      const input = document.getElementById("dec-input");
      const output = document.getElementById("dec-output");
      const clearBtn = document.getElementById("dec-clear");
      const pasteBtn = document.getElementById("dec-paste");
      const copyBtn = document.getElementById("dec-copy");
      const playBtn = document.getElementById("dec-play");
      const statusEl = document.getElementById("dec-status");

      let MAP = null, REV = null;

      function buildRev(map) {
        const r = {};
        for (const k in map) if (Object.hasOwn(map, k) && !r[map[k]]) r[map[k]] = k;
        return r;
      }
      function normalize(s) {
        return (s || "")
          .replaceAll("·", ".").replaceAll("•", ".")
          .replaceAll("–", "-").replaceAll("—", "-")
          .replace(/\s*\|\s*/g, " / ")
          .replace(/\s*\/+\s*/g, " / ")
          .replace(/\s+/g, " ")
          .trim();
      }
      function decode(raw) {
        if (!REV) return "";
        const s = normalize(raw);
        if (!s) return "";
        const unsupported = new Set();
        const text = s.split(/\s*\/\s*/).filter(Boolean).map(word =>
          word.trim().split(/\s+/).filter(Boolean).map(code => {
            const c = REV[code];
            if (!c) unsupported.add(code);
            return c || "";
          }).join("")
        ).join(" ");
        if (statusEl) {
          if (unsupported.size) {
            statusEl.textContent = `Unsupported codes: ${[...unsupported].slice(0, 8).join(", ")}`;
          } else if (text) {
            statusEl.textContent = `✓ ${text.length} character${text.length === 1 ? "" : "s"} decoded`;
          } else {
            statusEl.textContent = "";
          }
        }
        return text;
      }

      let t;
      function autoRun() {
        clearTimeout(t);
        t = setTimeout(() => {
          if (!input || !output) return;
          output.value = decode(input.value || "");
        }, 120);
      }

      // Load morse map with an 8-second timeout. The file is 4 KB and
      // CDN-cached so the happy path is sub-100ms; we'd rather surface
      // an error after 8s than let the decoder hang indefinitely.
      (function loadMorse(){
        const ctrl = new AbortController();
        const t = setTimeout(() => ctrl.abort(), 8000);
        fetch("/morse.json", { signal: ctrl.signal }).then(r => r.json()).then(j => {
          clearTimeout(t);
          const raw = j?.morseMap || j || {};
          MAP = {};
          for (const k in raw) if (Object.hasOwn(raw, k) && k !== " ") MAP[k.toUpperCase()] = raw[k];
          REV = buildRev(MAP);
          autoRun();
        }).catch((e) => {
          clearTimeout(t);
          const msg = e?.name === "AbortError"
            ? "Network slow — Morse data didn't load in 8 s. Reload to retry."
            : "Failed to load Morse data. Refresh the page.";
          if (statusEl) statusEl.textContent = msg;
        });
      })();

      input?.addEventListener("input", autoRun);
      clearBtn?.addEventListener("click", () => { input.value = ""; output.value = ""; statusEl.textContent = ""; input.focus(); });
      pasteBtn?.addEventListener("click", async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) { input.value = text; autoRun(); }
        } catch {
          input?.focus();
        }
      });
      copyBtn?.addEventListener("click", async () => {
        const v = (output?.value || "").trim();
        if (!v) return;
        try {
          await navigator.clipboard.writeText(v);
          const old = copyBtn.innerHTML;
          copyBtn.innerHTML = "<span style='font-weight:600;'>Copied ✓</span>";
          setTimeout(() => (copyBtn.innerHTML = old), 1100);
        } catch {}
      });

      // Simple audio playback of the Morse input
      let audioCtx;
      playBtn?.addEventListener("click", async () => {
        const seq = (input?.value || "").trim();
        if (!seq) return;
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        const ctx = audioCtx;
        const unit = 1200 / 18; // 18 WPM
        let tt = ctx.currentTime + 0.05;
        const cleaned = seq.replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return;
        const parts = cleaned.split(/\s+/);
        for (const part of parts) {
          if (part === "/") { tt += (unit * 7) / 1000; continue; }
          for (const sym of part) {
            const dur = sym === "-" ? unit * 3 : unit;
            const osc = ctx.createOscillator();
            const g = ctx.createGain();
            osc.type = "sine"; osc.frequency.value = 600;
            g.gain.setValueAtTime(0.001, tt);
            g.gain.exponentialRampToValueAtTime(0.18, tt + 0.01);
            g.gain.exponentialRampToValueAtTime(0.001, tt + dur / 1000);
            osc.connect(g); g.connect(ctx.destination);
            osc.start(tt); osc.stop(tt + dur / 1000);
            tt += dur / 1000 + unit / 1000;
          }
          tt += (unit * 2) / 1000;
        }
      });

      // Example rows fill the input
      document.querySelectorAll(".ex[data-morse]").forEach(b => {
        b.addEventListener("click", () => {
          input.value = b.getAttribute("data-morse") || "";
          autoRun();
          input.scrollIntoView({ behavior: "smooth", block: "center" });
          input.focus();
        });
      });

      // ============================================================
      // Mic-input decoder
      // ============================================================
      // Strategy:
      //  1. getUserMedia({audio}) → AudioContext → AnalyserNode.
      //  2. Read time-domain samples ~60Hz. Compute RMS to get a level
      //     (0..1). Threshold against the user's sensitivity slider.
      //  3. State machine: rising edge = key down (record press start),
      //     falling edge = key up (record press length + gap that follows).
      //  4. Estimate the dot-unit (in ms) by tracking the shortest recent
      //     press; classify each press as dot (<= 2 units) or dash (> 2 units).
      //  5. Classify each gap: ≤2u nothing, ~3u letter boundary, >5u word boundary.
      //  6. As letters/words form, look them up in REV and append to text.

      const micStart = document.getElementById("mic-start");
      const micStop = document.getElementById("mic-stop");
      const micClear = document.getElementById("mic-clear");
      const micThresh = document.getElementById("mic-thresh");
      const micLevel = document.getElementById("mic-level");
      const micLine = document.getElementById("mic-threshold-line");
      const micMorseEl = document.getElementById("mic-morse");
      const micTextEl = document.getElementById("mic-text");
      const micStatus = document.getElementById("mic-status");

      let micCtx, micStream, micAnalyser, micRAF;
      let pressStart = 0, lastUp = 0, isDown = false;
      let unitMs = 120; // initial guess; adapts to shortest press
      let currentLetter = "";
      let morseBuffer = "";
      let textBuffer = "";

      function setThresholdLine() {
        if (!micThresh || !micLine) return;
        const pct = (Number(micThresh.value) || 40); // already 0..100 friendly
        micLine.style.left = `${pct}%`;
      }
      micThresh?.addEventListener("input", setThresholdLine);
      setThresholdLine();

      function classifyPress(durMs) {
        // Adapt unit to the shortest reasonable press observed (lower bound 40ms).
        if (durMs >= 40 && durMs < unitMs * 1.5) {
          unitMs = Math.min(unitMs, Math.max(50, Math.round(durMs)));
        }
        return durMs <= unitMs * 2 ? "." : "-";
      }
      function classifyGap(gapMs) {
        if (gapMs >= unitMs * 5) return "word";
        if (gapMs >= unitMs * 2.5) return "letter";
        return null;
      }
      function commitLetter() {
        if (!currentLetter) return;
        const c = REV ? REV[currentLetter] : null;
        if (c) textBuffer += c;
        else textBuffer += `[${currentLetter}]`; // unknown code marker
        morseBuffer += currentLetter + " ";
        currentLetter = "";
        renderMic();
      }
      function commitWord() {
        commitLetter();
        if (textBuffer && !textBuffer.endsWith(" ")) textBuffer += " ";
        if (morseBuffer && !morseBuffer.endsWith("/ ")) morseBuffer += "/ ";
        renderMic();
      }
      function renderMic() {
        if (micMorseEl) micMorseEl.textContent = (morseBuffer + currentLetter).trim();
        if (micTextEl) micTextEl.textContent = textBuffer.trim();
      }

      async function startMic() {
        if (micCtx) return;
        try {
          micStatus.textContent = "Requesting microphone…";
          micStream = await navigator.mediaDevices.getUserMedia({
            audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
          });
          micCtx = new (window.AudioContext || window.webkitAudioContext)();
          const src = micCtx.createMediaStreamSource(micStream);
          micAnalyser = micCtx.createAnalyser();
          micAnalyser.fftSize = 1024;
          src.connect(micAnalyser);

          const buf = new Float32Array(micAnalyser.fftSize);
          pressStart = 0;
          lastUp = performance.now();
          isDown = false;
          unitMs = 120;
          currentLetter = "";
          morseBuffer = "";
          textBuffer = "";
          renderMic();

          micStart.disabled = true;
          micStop.disabled = false;
          micStatus.textContent = "Listening… play Morse near your mic.";

          // Idle auto-commit flags: each silence period can commit a letter
          // at most once and a word at most once, until the next key-down
          // event resets both. (Previous implementation reset a setTimeout
          // every animation frame so it never fired — Codex P1.)
          let letterCommittedOnIdle = false;
          let wordCommittedOnIdle = false;

          function loop() {
            micAnalyser.getFloatTimeDomainData(buf);
            // RMS
            let sum = 0;
            for (let i = 0; i < buf.length; i++) sum += buf[i] * buf[i];
            const rms = Math.sqrt(sum / buf.length);
            // Map to 0..100 with a gentle curve
            const lvl = Math.min(100, Math.round(Math.sqrt(rms) * 220));
            if (micLevel) micLevel.style.width = `${lvl}%`;

            const threshold = Number(micThresh?.value || 40);
            const now = performance.now();
            const above = lvl >= threshold;

            if (above && !isDown) {
              // Rising edge — key down. The gap that just ended is from lastUp to now.
              const gapMs = now - lastUp;
              const gapKind = classifyGap(gapMs);
              if (gapKind === "word") commitWord();
              else if (gapKind === "letter") commitLetter();
              isDown = true;
              pressStart = now;
              letterCommittedOnIdle = false;
              wordCommittedOnIdle = false;
            } else if (!above && isDown) {
              // Falling edge — key up.
              const dur = now - pressStart;
              isDown = false;
              lastUp = now;
              if (dur >= 30) { // ignore micro-bursts
                currentLetter += classifyPress(dur);
                renderMic();
              }
            } else if (!isDown) {
              // Idle: while no key is pressed, commit on long-enough silences.
              // Each transition only fires once per silence period.
              const elapsed = now - lastUp;
              if (!letterCommittedOnIdle && currentLetter && elapsed > unitMs * 3) {
                commitLetter();
                letterCommittedOnIdle = true;
              }
              if (!wordCommittedOnIdle && elapsed > unitMs * 7 &&
                  textBuffer && !textBuffer.endsWith(" ")) {
                commitWord();
                wordCommittedOnIdle = true;
              }
            }
            micRAF = requestAnimationFrame(loop);
          }
          loop();
        } catch (e) {
          micStatus.textContent = `Microphone error: ${e?.message || e}`;
          stopMic();
        }
      }

      function stopMic() {
        try { cancelAnimationFrame(micRAF); } catch {}
        micRAF = null;
        try { micStream?.getTracks().forEach(t => t.stop()); } catch {}
        micStream = null;
        try { micCtx?.close(); } catch {}
        micCtx = null; micAnalyser = null;
        if (micStart) micStart.disabled = false;
        if (micStop) micStop.disabled = true;
        if (micLevel) micLevel.style.width = "0%";
        if (currentLetter) commitLetter();
        if (micStatus) micStatus.textContent = "Stopped. Press Start listening to resume.";
      }

      micStart?.addEventListener("click", startMic);
      micStop?.addEventListener("click", stopMic);
      micClear?.addEventListener("click", () => {
        currentLetter = ""; morseBuffer = ""; textBuffer = "";
        renderMic();
        if (micStatus) micStatus.textContent = "Cleared.";
      });

      // Stop the mic loop and release the stream when the page becomes
      // hidden or unloads. Without this, the requestAnimationFrame
      // loop keeps running in the background tab and the getUserMedia
      // stream keeps the microphone-indicator light on — both look
      // like privacy bugs even though they're just resource leaks.
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden" && micRAF) stopMic();
      });
      window.addEventListener("pagehide", () => { if (micRAF) stopMic(); });

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        micStart && (micStart.disabled = true);
        if (micStatus) micStatus.textContent = "Microphone API not available in this browser.";
      }
    })();
  </script>

  <style>
    .decoder{
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }
    .decoder-head{
      display: flex;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-5);
      background: var(--surface-2);
      border-bottom: 1px solid var(--line);
      font-size: var(--fs-xs);
      color: var(--text-muted);
    }
    .dot-on{
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--good);
      box-shadow: 0 0 0 3px rgba(34,197,94,0.16);
    }
    .d-meta{ font-family: var(--font-mono); font-size: 11px; }

    .decoder-body{ padding: var(--s-5); display: grid; gap: var(--s-3); }
    .field{ display: grid; gap: var(--s-2); }
    .field-label{
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
      font-weight: 600;
    }
    .decoder-body .t-area{
      min-height: 120px;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg);
      padding: var(--s-3) var(--s-4);
      font-size: var(--fs-base);
    }
    .decoder-body .t-area.mono{ letter-spacing: 0.06em; font-size: var(--fs-md); }
    .decoder-actions{ display: flex; gap: var(--s-2); flex-wrap: wrap; }
    /* 40px is the site-wide button standard (matches .btn). */
    .decoder-actions button{ height: 40px; padding: 0 var(--s-3); font-size: var(--fs-sm); }
    .decoder-status{ margin: 0; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--text-muted); min-height: 18px; }

    /* Example list */
    .ex-list{ display: grid; gap: var(--s-2); }
    @media (min-width: 720px){ .ex-list{ grid-template-columns: repeat(2, 1fr); } }
    .ex{
      height: auto;
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: var(--s-3);
      padding: var(--s-3) var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      color: var(--text);
      transition: background .12s ease, border-color .12s ease;
    }
    .ex:hover{ background: var(--surface-2); border-color: var(--accent-line); }
    .ex-morse{ font-size: var(--fs-sm); color: var(--accent); letter-spacing: 0.06em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-arrow{ color: var(--text-subtle); }
    .ex-plain{ font-weight: 600; font-size: var(--fs-sm); }

    /* ============== Live mic decoder ============== */
    .mic{
      margin-top: var(--s-7);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
      overflow: hidden;
    }
    .mic-head{
      display: grid;
      gap: var(--s-2);
      padding: var(--s-5);
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }
    .mic-head-left{
      display: flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .mic-badge{
      display: inline-flex;
      align-items: center;
      padding: 2px var(--s-2);
      border-radius: var(--r-pill);
      background: var(--accent-soft);
      border: 1px solid var(--accent-line);
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .mic-title{
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--fs-lg);
      letter-spacing: -0.02em;
    }
    .mic-sub{
      margin: 0;
      font-size: var(--fs-sm);
      max-width: 64ch;
    }

    .mic-body{
      padding: var(--s-5);
      display: grid;
      gap: var(--s-3);
    }
    .mic-controls{
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      align-items: center;
    }
    .mic-controls button{
      height: 40px;
      padding: 0 var(--s-4);
      font-size: var(--fs-sm);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .mic-controls button[disabled]{ opacity: 0.5; cursor: not-allowed; }

    .mic-thresh{
      display: flex;
      align-items: center;
      gap: var(--s-2);
      margin-left: auto;
    }
    .mic-thresh-label{
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-subtle);
      font-weight: 600;
    }
    .mic-thresh input{ width: 140px; height: 4px; padding: 0; border: 0; background: var(--line); border-radius: 999px; }
    .mic-thresh input::-webkit-slider-thumb{
      -webkit-appearance: none; appearance: none;
      width: 14px; height: 14px;
      background: var(--accent);
      border: 2px solid var(--surface);
      border-radius: 50%;
      cursor: pointer;
    }
    .mic-thresh input::-moz-range-thumb{
      width: 14px; height: 14px;
      background: var(--accent);
      border: 2px solid var(--surface);
      border-radius: 50%;
      cursor: pointer;
    }

    /* Level meter with a threshold marker */
    .mic-meter{
      position: relative;
      height: 12px;
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      overflow: hidden;
    }
    .mic-meter-fill{
      position: absolute;
      top: 0; bottom: 0; left: 0;
      width: 0%;
      background: linear-gradient(90deg, var(--good), var(--accent));
      transition: width 30ms linear;
    }
    .mic-meter-line{
      position: absolute;
      top: -2px; bottom: -2px;
      width: 2px;
      background: var(--warn);
      transform: translateX(-1px);
    }

    .mic-grid{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    @media (min-width: 720px){ .mic-grid{ grid-template-columns: 1fr 1fr; } }

    .mic-field{ display: grid; gap: var(--s-2); }
    .mic-out{
      margin: 0;
      padding: var(--s-3) var(--s-4);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg);
      min-height: 80px;
      max-height: 200px;
      overflow: auto;
      font-size: var(--fs-base);
      white-space: pre-wrap;
      word-break: break-word;
      color: var(--text);
    }
    .mic-out.mono{
      font-family: var(--font-mono);
      letter-spacing: 0.06em;
      color: var(--accent);
    }
    .mic-status{
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      min-height: 18px;
    }

    @media (max-width: 600px){
      .mic-thresh{ margin-left: 0; width: 100%; }
      .mic-thresh input{ flex: 1; }
    }

    /* Reading-key reused from word-slug page */
    .reading-key{
      display: grid;
      gap: 0;
      margin: 0;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      overflow: hidden;
    }
    .reading-key > div{
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      padding: var(--s-3) var(--s-4);
      border-bottom: 1px solid var(--line);
    }
    @media (min-width: 720px){
      .reading-key > div{ grid-template-columns: 160px 1fr; gap: var(--s-5); align-items: baseline; }
    }
    .reading-key > div:last-child{ border-bottom: 0; }
    .reading-key dt{ font-weight: 600; color: var(--text); font-size: var(--fs-sm); margin: 0; }
    .reading-key dd{ margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }
  </style>
</Layout>
