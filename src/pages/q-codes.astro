---
import Layout from "../components/Layout.astro";
import GearPick from "../components/GearPick.astro";
import { TAGS } from "../data/affiliate-products.js";
import { books } from "../data/gear.js";
import { qcodes } from "../data/q-codes.js";

const title = "Q-Codes in Morse Code – Full Reference (QTH, QSY, QRZ, ...)";
const description =
  "Complete Q-code reference for ham radio CW: QTH, QSY, QRZ, QSL, QRM, QRN, QRP, QRO, and more. Each Q-code links to a full page with examples, context, and Morse rendering.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/q-codes/`;
const robots = "index,follow";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Q-codes", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "Article",
      headline: title,
      description,
      url: canonical,
      author: { "@type": "Organization", name: "MorseCodeGenerator.com" },
      publisher: { "@id": `${site}#org` },
      mainEntityOfPage: canonical,
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#index`,
      name: "Q-codes index",
      url: canonical,
      itemListElement: qcodes.map((q, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site}/q-codes/${q.code.toLowerCase()}/`,
        name: q.code,
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots} ogType="article">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Q-codes</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">CW operating • ITU origin</p>
    <h1 class="page-hero-title">Q-codes in Morse code</h1>
    <p class="muted page-hero-sub">
      Q-codes are three-letter abbreviations starting with <span class="k">Q</span>. Each works as both a
      <strong>question</strong> (with a <span class="k">?</span>) and an <strong>answer</strong>
      (without). Originally from international maritime/aero use, now standard in ham CW. Tap any code
      for its full page with examples and Morse rendering.
    </p>
    <div class="page-hero-actions">
      <a class="btn primary" href="/translate/">Open translator</a>
      <a class="btn secondary" href="/abbreviations/">CW abbreviations</a>
      <a class="btn ghost" href="/prosigns/">Prosigns</a>
    </div>
  </header>

  <section class="card qcodes-card">
    <h2 class="qcodes-h">Reference table</h2>
    <div class="tablewrap">
      <table>
        <thead>
          <tr><th>Code</th><th>As a question</th><th>As an answer</th><th>More</th></tr>
        </thead>
        <tbody>
          {qcodes.map((q) => (
            <tr>
              <td><strong class="k">{q.code}</strong></td>
              <td>{q.question}</td>
              <td class="muted">{q.answer}</td>
              <td><a class="qcodes-more" href={`/q-codes/${q.code.toLowerCase()}/`}>Detail →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card soft qcodes-card">
    <h2 class="qcodes-h">Examples</h2>
    <ul>
      <li><span class="k">QRZ?</span> — “Who is calling me?”</li>
      <li><span class="k">QTH? FN31</span> — “Where are you? — FN31 (Maidenhead grid)”</li>
      <li><span class="k">QSY 14.040</span> — “Move to 14.040 MHz.”</li>
      <li><span class="k">QSL TNX 73</span> — “Confirmed. Thanks. Best regards.”</li>
    </ul>
  </section>

  <GearPick
    tag={TAGS.reference}
    picks={[books[0], books[1]]}
    heading="Going further on the air"
    intro="Q-codes are the vocabulary; operating practice is the grammar. These two are the books CW operators actually recommend to each other — one on building speed and technique, one on how a real contact runs."
    guideHref="/gear/"
    guideLabel="See all the gear picks"
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .qcodes-card{ margin-top: var(--s-4); }
    .qcodes-h{ margin-top: 0; }
    .qcodes-more{
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--accent);
      white-space: nowrap;
    }
    .qcodes-more:hover{ color: var(--accent-hover); }
  </style>
</Layout>
