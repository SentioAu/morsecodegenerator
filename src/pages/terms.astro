---
import Layout from "../components/Layout.astro";

const title = "Terms of Use – Morse Code Generator";
const description =
  "Terms of use for MorseCodeGenerator.com. Read the rules, disclaimers, and limitations of liability.";
const canonical = "https://morsecodegenerator.com/terms/";
---

<Layout title={title} description={description} canonical={canonical}>
  <article class="prose">
    <h1>Terms of Use</h1>
    <p class="muted">Last updated: {new Date().toISOString().slice(0, 10)}</p>

    <div class="card">
      <p>
        By accessing or using this website, you agree to these Terms of Use. If
        you do not agree, please do not use the site.
      </p>
    </div>

    <h2>Use of the site</h2>
    <ul>
      <li>
        You may use the site for personal or educational purposes.
      </li>
      <li>
        You agree not to misuse the site (for example: attempting to break,
        disrupt, or overload it).
      </li>
      <li>
        You are responsible for how you use the outputs generated by the tool.
      </li>
    </ul>

    <h2>No warranties</h2>
    <p>
      The site and its content are provided “as is” and “as available” without
      warranties of any kind, express or implied. We do not guarantee accuracy,
      completeness, or availability.
    </p>

    <h2>Limitation of liability</h2>
    <p>
      To the maximum extent permitted by law, we will not be liable for any
      indirect, incidental, special, consequential, or punitive damages, or any
      loss of data, profits, or revenues, arising from your use of the site.
    </p>

    <h2>Third-party services and links</h2>
    <p>
      The site may include third-party services such as analytics and advertising
      (for example Google Analytics and Google AdSense), and may include links to
      third-party websites. We are not responsible for third-party content,
      policies, or practices.
    </p>

    <h2>Advertising</h2>
    <p>
      We may display ads served by third-party advertising partners. These
      partners may use cookies or similar technologies to measure performance and
      show relevant ads.
    </p>

    <h2>Intellectual property</h2>
    <p>
      Unless otherwise stated, the site design, text, and original content are
      owned by MorseCodeGenerator.com and/or its licensors. You may not copy,
      reproduce, or redistribute substantial portions of the site without prior
      permission, except as permitted by law.
    </p>

    <h2>Changes</h2>
    <p>
      We may update these Terms at any time. The “Last updated” date above will
      reflect the latest version.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about these Terms? Email
      <a href="mailto:morsecodegenerator@gmail.com">morsecodegenerator@gmail.com</a>.
    </p>
  </article>
</Layout>
