---
import Layout from "../components/Layout.astro";

const CONTACT_EMAIL = "morsecodegenerator@gmail.com";

const title = "Contact – Morse Code Generator";
const description =
  "Contact MorseCodeGenerator.com for feedback, corrections, partnerships, or bug reports.";
---

<Layout title={title} description={description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Contact</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">Feedback · Corrections · Partnerships</p>
    <h1 class="page-hero-title">Contact</h1>
    <p class="muted page-hero-sub">
      Send feedback, report an issue, or request a feature. If you're reporting a bug, please
      include the page URL and what you expected to happen.
    </p>
  </header>

  <section class="contact-card">
    <p class="contact-eyebrow">Email us at</p>
    <div class="email-row">
      <code class="email" id="emailText">{CONTACT_EMAIL}</code>
      <button type="button" id="copyEmail" class="email-copy">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copy
      </button>
    </div>
    <p class="muted contact-fineprint">
      If the Copy button doesn't work, select the address and copy it manually.
    </p>
  </section>

  <section class="section">
    <h2 class="section-title">What to include</h2>
    <dl class="contact-list">
      <div>
        <dt>Bug report</dt>
        <dd>Page URL · device / browser · steps to reproduce.</dd>
      </div>
      <div>
        <dt>Correction</dt>
        <dd>Which page is wrong, plus your suggested correction.</dd>
      </div>
      <div>
        <dt>Partnership</dt>
        <dd>Who you are and what you're proposing.</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <h2 class="section-title">Explore more</h2>
    <div class="pill-grid">
      <a href="/translate/">Translator</a>
      <a href="/practice/">Practice</a>
      <a href="/morse-code/">Learn</a>
      <a href="/chart/">Chart</a>
      <a href="/morse-code/numbers/">Numbers</a>
      <a href="/morse-code/punctuation/">Punctuation</a>
      <a href="/phrases/">Phrases</a>
      <a href="/about/">About</a>
    </div>
  </section>

  <script is:inline>
    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    const btn = document.getElementById("copyEmail");
    const emailEl = document.getElementById("emailText");
    btn?.addEventListener("click", async () => {
      const email = (emailEl?.textContent || "").trim();
      if (!email) return;
      const ok = await copyText(email);
      if (!ok) return;
      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <style>
    .contact-card{
      margin-top: var(--s-3);
      padding: var(--s-6);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
      text-align: center;
    }
    .contact-eyebrow{
      margin: 0 0 var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
    }
    .email-row{
      display: inline-flex;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      max-width: 100%;
    }
    .email{
      font-family: var(--font-mono);
      font-size: var(--fs-base);
      color: var(--text);
      background: transparent;
      padding: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .email-copy{
      display: inline-flex;
      align-items: center;
      gap: 4px;
      height: 32px;
      padding: 0 var(--s-3);
      border-radius: var(--r-pill);
      border: 0;
      background: var(--accent);
      color: var(--accent-text);
      font-size: var(--fs-xs);
      font-weight: 600;
      cursor: pointer;
      transition: background .12s ease;
    }
    .email-copy:hover{ background: var(--accent-hover); }
    .contact-fineprint{
      margin-top: var(--s-3);
      font-size: var(--fs-xs);
      color: var(--text-subtle);
    }

    .contact-list{
      display: grid;
      gap: 0;
      margin: 0;
      max-width: 100%;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      overflow: hidden;
    }
    .contact-list > div{
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      padding: var(--s-4);
      border-bottom: 1px solid var(--line);
    }
    @media (min-width: 760px){
      .contact-list > div{ grid-template-columns: 200px 1fr; gap: var(--s-5); align-items: baseline; }
    }
    .contact-list > div:last-child{ border-bottom: 0; }
    .contact-list dt{ font-weight: 600; color: var(--text); font-size: var(--fs-sm); margin: 0; }
    .contact-list dd{ margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }
  </style>
</Layout>
