---
import Layout from "../components/Layout.astro";
import { abbrs } from "../data/cw-abbreviations.js";

const title = "CW Abbreviations in Morse Code (73, 88, OM, FB, ...)";
const description =
  "Common amateur-radio CW abbreviations used in Morse code: 73, 88, OM, YL, FB, TNX, DE, CQ, DX, RST, and more — each links to a full page with usage examples and context.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/abbreviations/`;
const robots = "index,follow";

// Group entries by their `group` field while preserving the source order.
const groupOrder = [];
const groupMap = new Map();
for (const a of abbrs) {
  if (!groupMap.has(a.group)) {
    groupOrder.push(a.group);
    groupMap.set(a.group, []);
  }
  groupMap.get(a.group).push(a);
}
const groups = groupOrder.map((name) => ({ name, items: groupMap.get(name) }));

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Abbreviations", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "Article",
      headline: title,
      description,
      url: canonical,
      author: { "@type": "Organization", name: "MorseCodeGenerator.com" },
      publisher: { "@id": `${site}#org` },
      mainEntityOfPage: canonical,
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#index`,
      name: "CW abbreviations index",
      url: canonical,
      itemListElement: abbrs.map((a, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site}/abbreviations/${a.slug}/`,
        name: a.code,
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots} ogType="article">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">CW abbreviations</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">Ham radio • CW shorthand</p>
    <h1 class="page-hero-title">CW abbreviations in Morse code</h1>
    <p class="muted page-hero-sub">
      Hams shorten everything on CW. Learn the standard abbreviations once and your QSOs become fast,
      friendly, and surprisingly readable. Tap any abbreviation below for its full page with examples
      and context.
    </p>
    <div class="page-hero-actions">
      <a class="btn primary" href="/translate/">Open translator</a>
      <a class="btn secondary" href="/q-codes/">Q-codes</a>
      <a class="btn ghost" href="/prosigns/">Prosigns</a>
    </div>
  </header>

  {groups.map((g) => (
    <section class="card abbr-section">
      <h2 class="abbr-h">{g.name}</h2>
      <div class="abbr-grid">
        {g.items.map((a) => (
          <a class="abbr abbr-link" href={`/abbreviations/${a.slug}/`}>
            <div class="abbr-key k">{a.code}</div>
            <div class="abbr-val">{a.meaning}</div>
            <span class="abbr-go">Detail →</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="card soft abbr-section">
    <h2 class="abbr-h">Tip</h2>
    <p class="muted">
      A typical CQ goes: <span class="k">CQ CQ CQ DE [your call] [your call] K</span>. Replies often
      include <span class="k">RST</span>, <span class="k">QTH</span>, name, and rig.
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .abbr-section{ margin-top: var(--s-4); }
    .abbr-h{ margin-top: 0; }
    .abbr-grid{
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--s-3);
    }
    .abbr{
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
      border: 1px solid var(--line);
      background: var(--surface-2);
      border-radius: var(--r-md);
      padding: var(--s-3) var(--s-4);
      text-decoration: none;
      color: var(--text);
      transition: background .12s ease, border-color .12s ease;
    }
    .abbr-link:hover{
      background: var(--surface-hi);
      border-color: var(--accent-line);
      text-decoration: none;
    }
    .abbr-key{ font-weight: 700; letter-spacing: 0.04em; font-size: var(--fs-md); color: var(--text); }
    .abbr-val{ color: var(--text-muted); font-size: var(--fs-sm); }
    .abbr-go{
      margin-top: var(--s-1);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--accent);
    }
  </style>
</Layout>
