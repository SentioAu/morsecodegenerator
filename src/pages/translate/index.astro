---
import Layout from "../../components/Layout.astro";
import slugs from "../../data/seo-slugs.json";

const lang = (Astro.url.searchParams.get("lang") ?? "en").toString();

const translations = {
  en: {
    title: "Text to Morse Translator – Copy & Convert Instantly",
    description:
      "Translate text to Morse code or decode Morse to text. Copy results instantly. Free online tool.",
    kicker: "Fast • Private • No logins",
    heroTitle: "Text to Morse Translator",
    heroSub:
      "Paste text, convert to Morse, decode Morse back to text, and copy results instantly. Runs locally in your browser.",
    practicePhrases: "Practice phrases",
    learnMorse: "Learn Morse",
    practiceWords: "Practice words",
    home: "Home",
    input: "Input",
    output: "Output",
    textToMorse: "Text → Morse",
    morseToText: "Morse → Text",
    copyOutput: "Copy output",
    copyLink: "Copy share link",
    clear: "Clear",
    play: "Play Morse",
    stop: "Stop",
    speed: "Speed",
    popularTitle: "Popular translations",
    popularSub: "Quick links to common phrases people translate.",
  },
  es: {
    title: "Traductor de texto a Morse – Copia y convierte al instante",
    description:
      "Traduce texto a código Morse o decodifica Morse a texto. Copia resultados al instante.",
    kicker: "Rápido • Privado • Sin inicios",
    heroTitle: "Traductor de texto a Morse",
    heroSub:
      "Pega texto, convierte a Morse, decodifica Morse a texto y copia resultados al instante.",
    practicePhrases: "Practicar frases",
    learnMorse: "Aprender Morse",
    practiceWords: "Practicar palabras",
    home: "Inicio",
    input: "Entrada",
    output: "Salida",
    textToMorse: "Texto → Morse",
    morseToText: "Morse → Texto",
    copyOutput: "Copiar salida",
    copyLink: "Copiar enlace",
    clear: "Borrar",
    play: "Reproducir Morse",
    stop: "Detener",
    speed: "Velocidad",
    popularTitle: "Traducciones populares",
    popularSub: "Enlaces rápidos a frases comunes.",
  },
};

const t = translations[lang] ?? translations.en;

const withLang = (href) => {
  if (!lang || lang === "en") return href;
  const joiner = href.includes("?") ? "&" : "?";
  return `${href}${joiner}lang=${encodeURIComponent(lang)}`;
};

const title = t.title;
const description = t.description;

const q = (Astro.url.searchParams.get("q") ?? "").toString();
const initial = q.trim() ? q.trim().slice(0, 5000) : "";
const hasInitial = Boolean(initial);

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/translate/`;
const robots = "index,follow";
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <header class="t-hero">
    <p class="page-hero-kicker">{t.kicker}</p>
    <h1 class="t-hero-title">{t.heroTitle}</h1>
    <p class="t-hero-sub">{t.heroSub}</p>
  </header>

  <section class="translator" aria-label="Morse code translator">
    <div class="translator-head">
      <div class="translator-status">
        <span class="dot-on" aria-hidden="true"></span>
        <span class="t-meta">Auto-detect &middot; runs in your browser</span>
      </div>
      <div class="translator-spec">
        <span><span class="k">.</span> dot &middot; <span class="k">-</span> dash</span>
        <span class="sep">&middot;</span>
        <span>letter = space &middot; word = <span class="k">/</span></span>
      </div>
    </div>

    <div class="translator-body">
      <div class="t-side">
        <div class="t-side-head">
          <span class="t-side-label">Text</span>
          <div class="t-side-actions">
            <button id="mcg-clear" type="button" class="t-icon-btn" aria-label="Clear input">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
        <textarea
          id="mcg-input"
          class="t-area"
          rows="8"
          placeholder="Type or paste text — HELLO WORLD"
          spellcheck="false"
          autocorrect="off"
          autocapitalize="off"
          maxlength="5000"
        ></textarea>
        <div class="t-side-foot">
          <button id="mcg-text-to-morse" type="button" class="primary-action">{t.textToMorse}</button>
        </div>
      </div>

      <button id="mcg-swap" type="button" class="t-swap" aria-label="Swap input and output">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg>
      </button>

      <div class="t-side">
        <div class="t-side-head">
          <span class="t-side-label">Morse</span>
          <div class="t-side-actions">
            <button id="mcg-copy" type="button" class="t-icon-btn" aria-label="Copy output">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
            <button id="mcg-copy-link" type="button" class="t-icon-btn" aria-label="Copy share link">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
            </button>
          </div>
        </div>
        <textarea
          id="mcg-output"
          class="t-area mono"
          rows="8"
          readonly
          placeholder="Result appears here…"
          spellcheck="false"
        ></textarea>
        <div class="t-side-foot">
          <button id="mcg-morse-to-text" type="button" class="ghost">{t.morseToText}</button>
        </div>
      </div>
    </div>

    <div class="translator-controls">
      <div class="ctrl-row">
        <button id="mcg-play" type="button" class="ctrl-btn" aria-label={t.play}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 3v18l14-9L5 3z"/></svg>
          <span>{t.play}</span>
        </button>
        <button id="mcg-stop" type="button" class="ctrl-btn ghost" aria-label={t.stop}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
          <span>{t.stop}</span>
        </button>
        <button id="mcg-flash" type="button" class="ctrl-btn ghost" aria-label="Flash light Morse">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
          <span>Flash</span>
        </button>
        <button id="mcg-buzz" type="button" class="ctrl-btn ghost" aria-label="Vibrate Morse (mobile)">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M12 18h.01"/></svg>
          <span>Vibrate</span>
        </button>
      </div>

      <div class="ctrl-grid">
        <div class="slider">
          <div class="slider-head">
            <span class="slider-label">Speed</span>
            <span id="mcg-speed-value" class="slider-value">18 WPM</span>
          </div>
          <input id="mcg-speed" type="range" min="10" max="30" value="18" step="1" aria-label="Words per minute" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="slider-label">Volume</span>
            <span id="mcg-volume-value" class="slider-value">40%</span>
          </div>
          <input id="mcg-volume" type="range" min="0" max="100" value="40" step="1" aria-label="Volume" />
        </div>
      </div>

      <label class="nato-toggle">
        <input id="mcg-nato" type="checkbox" />
        <span>Show NATO phonetic spelling alongside Morse</span>
      </label>
      <pre id="mcg-nato-out" class="mono nato-out" hidden></pre>
    </div>
  </section>

  {/* Full-viewport flasher overlay */}
  <div id="mcg-flash-screen" class="flash-screen" hidden role="dialog" aria-label="Morse light flasher" aria-modal="true">
    <button type="button" id="mcg-flash-close" class="flash-close" aria-label="Close flasher">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="flash-hint">Tap anywhere to stop</div>
  </div>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">{t.popularTitle}</p>
        <h2 class="section-title">Try one of these</h2>
      </div>
      <p class="muted section-sub">{t.popularSub}</p>
    </div>
    <div class="quick-grid">
      <a class="quick" href={withLang("/translate/?q=SOS")}>SOS</a>
      <a class="quick" href={withLang("/translate/?q=HELP")}>HELP</a>
      <a class="quick" href={withLang("/translate/?q=HELLO")}>HELLO</a>
      <a class="quick" href={withLang("/translate/?q=THANK%20YOU")}>THANK YOU</a>
      <a class="quick" href={withLang("/translate/?q=I%20LOVE%20YOU")}>I LOVE YOU</a>
      <a class="quick" href={withLang("/translate/?q=MAYDAY")}>MAYDAY</a>
      <a class="quick" href={withLang("/translate/?q=PLEASE")}>PLEASE</a>
      <a class="quick" href={withLang("/translate/?q=GOOD%20NIGHT")}>GOOD NIGHT</a>
    </div>
  </section>

  <div id="mcg-toast" class="toast" role="status" aria-live="polite"></div>

  <script defer src="/mcg-tool.js"></script>

  <script is:inline>
    (function () {
      function ready(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      async function copyText(text) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          try {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return ok;
          } catch {
            return false;
          }
        }
      }

      let audioCtx;
      let stopFlag = false;

      function getAudioContext() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        return audioCtx;
      }

      async function playMorse(sequence, wpm, volume) {
        if (!sequence) return;
        const ctx = getAudioContext();
        const unit = 1200 / wpm;
        const peak = Math.max(0, Math.min(1, (volume == null ? 0.4 : volume)));
        const now = ctx.currentTime;
        let t = now;

        const trimmed = sequence.split("\n")[0];
        const cleaned = trimmed.replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return;

        const parts = cleaned.split(/\s+/);

        for (let i = 0; i < parts.length; i += 1) {
          if (stopFlag) return;
          const part = parts[i];
          if (part === "/") {
            t += (unit * 7) / 1000;
            continue;
          }
          for (let j = 0; j < part.length; j += 1) {
            if (stopFlag) return;
            const symbol = part[j];
            const duration = symbol === "-" ? unit * 3 : unit;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "sine";
            osc.frequency.value = 600;
            gain.gain.setValueAtTime(0.001, t);
            gain.gain.exponentialRampToValueAtTime(Math.max(0.001, peak), t + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.001, t + duration / 1000);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(t);
            osc.stop(t + duration / 1000);
            t += duration / 1000;
            t += unit / 1000;
          }
          t += (unit * 2) / 1000;
        }
      }

      // ---- Flasher (light) ----
      let flashTimers = [];
      function clearFlash() {
        flashTimers.forEach((id) => clearTimeout(id));
        flashTimers = [];
      }
      function flashMorse(sequence, wpm, screen) {
        clearFlash();
        if (!sequence || !screen) return;
        const unit = 1200 / wpm;
        const cleaned = sequence.split("\n")[0].replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return;
        const parts = cleaned.split(/\s+/);
        let offset = 0;
        const on = () => screen.classList.add("on");
        const off = () => screen.classList.remove("on");

        for (const part of parts) {
          if (part === "/") {
            offset += unit * 7;
            continue;
          }
          for (const sym of part) {
            const dur = sym === "-" ? unit * 3 : unit;
            flashTimers.push(setTimeout(on, offset));
            flashTimers.push(setTimeout(off, offset + dur));
            offset += dur + unit; // intra-element gap
          }
          offset += unit * 2; // letter gap (3-1=2 added)
        }
        flashTimers.push(setTimeout(() => screen.removeAttribute("data-running"), offset + 30));
      }

      // ---- Vibration ----
      function vibrateMorse(sequence, wpm) {
        if (!("vibrate" in navigator)) return false;
        const unit = Math.round(1200 / wpm);
        const cleaned = sequence.split("\n")[0].replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return false;
        const parts = cleaned.split(/\s+/);
        const pattern = [];
        let pendingPause = 0;
        for (const part of parts) {
          if (part === "/") { pendingPause += unit * 7; continue; }
          for (const sym of part) {
            const dur = sym === "-" ? unit * 3 : unit;
            // wait: intra-element gap (1u) plus any accumulated pause
            pattern.push(pendingPause || unit);
            pattern.push(dur);
            pendingPause = unit; // intra-element default
          }
          pendingPause = unit * 3; // letter gap
        }
        // Strip first wait if it's exactly the default unit
        if (pattern.length && pattern[0] === unit) pattern[0] = 0;
        navigator.vibrate(pattern);
        return true;
      }

      // ---- NATO phonetic ----
      const NATO = {
        A: "Alpha", B: "Bravo", C: "Charlie", D: "Delta", E: "Echo",
        F: "Foxtrot", G: "Golf", H: "Hotel", I: "India", J: "Juliett",
        K: "Kilo", L: "Lima", M: "Mike", N: "November", O: "Oscar",
        P: "Papa", Q: "Quebec", R: "Romeo", S: "Sierra", T: "Tango",
        U: "Uniform", V: "Victor", W: "Whiskey", X: "X-ray", Y: "Yankee",
        Z: "Zulu",
        0: "Zero", 1: "One", 2: "Two", 3: "Three", 4: "Four",
        5: "Five", 6: "Six", 7: "Seven", 8: "Eight", 9: "Niner",
      };
      function toNato(text) {
        const s = (text || "").toUpperCase();
        const out = [];
        for (const ch of s) {
          if (ch === " ") { out.push("/"); continue; }
          if (NATO[ch]) out.push(NATO[ch]);
        }
        return out.join(" ");
      }

      ready(function () {
        const input = document.getElementById("mcg-input");
        const copyBtn = document.getElementById("mcg-copy");
        const copyLinkBtn = document.getElementById("mcg-copy-link");
        const playBtn = document.getElementById("mcg-play");
        const stopBtn = document.getElementById("mcg-stop");
        const output = document.getElementById("mcg-output");
        const speed = document.getElementById("mcg-speed");
        const speedValue = document.getElementById("mcg-speed-value");
        const vol = document.getElementById("mcg-volume");
        const volVal = document.getElementById("mcg-volume-value");
        const flashBtn = document.getElementById("mcg-flash");
        const buzzBtn = document.getElementById("mcg-buzz");
        const flashScreen = document.getElementById("mcg-flash-screen");
        const flashClose = document.getElementById("mcg-flash-close");
        const natoToggle = document.getElementById("mcg-nato");
        const natoOut = document.getElementById("mcg-nato-out");
        if (!input || !copyLinkBtn) return;

        // Copy Morse output
        copyBtn?.addEventListener("click", async () => {
          const value = (output?.value || "").trim();
          if (!value) return;
          const ok = await copyText(value);
          if (!ok) return;
          const old = copyBtn.innerHTML;
          copyBtn.innerHTML = "<span style='font-size:13px;font-weight:600;'>✓</span>";
          copyBtn.style.color = "var(--good)";
          setTimeout(() => { copyBtn.innerHTML = old; copyBtn.style.color = ""; }, 1100);
        });

        // Restore persisted prefs
        try {
          const savedSpeed = localStorage.getItem("mcg.speed");
          const savedVol = localStorage.getItem("mcg.volume");
          const savedNato = localStorage.getItem("mcg.nato");
          if (savedSpeed && speed) { speed.value = savedSpeed; if (speedValue) speedValue.textContent = `${savedSpeed} WPM`; }
          if (savedVol && vol) { vol.value = savedVol; if (volVal) volVal.textContent = `${savedVol}%`; }
          if (savedNato === "1" && natoToggle) natoToggle.checked = true;
        } catch {}

        copyLinkBtn.addEventListener("click", async () => {
          const value = (input.value || "").trim();
          const url = new URL(window.location.href);
          if (value) {
            url.searchParams.set("q", value);
          } else {
            url.searchParams.delete("q");
          }
          const ok = await copyText(url.toString());
          if (!ok) return;
          const old = copyLinkBtn.textContent;
          copyLinkBtn.textContent = "Copied link ✓";
          setTimeout(() => (copyLinkBtn.textContent = old), 1200);
        });

        speed?.addEventListener("input", () => {
          if (!speedValue || !speed) return;
          speedValue.textContent = `${speed.value} WPM`;
          try { localStorage.setItem("mcg.speed", speed.value); } catch {}
        });
        vol?.addEventListener("input", () => {
          if (!volVal || !vol) return;
          volVal.textContent = `${vol.value}%`;
          try { localStorage.setItem("mcg.volume", vol.value); } catch {}
        });

        playBtn?.addEventListener("click", async () => {
          if (!output) return;
          stopFlag = false;
          const wpm = Number(speed?.value || 18);
          const v = Number(vol?.value || 40) / 100;
          await playMorse(output.value || "", wpm, v);
        });

        stopBtn?.addEventListener("click", () => {
          stopFlag = true;
          clearFlash();
          flashScreen?.removeAttribute("data-running");
          flashScreen?.classList.remove("on");
          flashScreen?.setAttribute("hidden", "");
          if ("vibrate" in navigator) navigator.vibrate(0);
          if (audioCtx) {
            audioCtx.close();
            audioCtx = undefined;
          }
        });

        flashBtn?.addEventListener("click", () => {
          if (!flashScreen) return;
          flashScreen.removeAttribute("hidden");
          flashScreen.setAttribute("data-running", "1");
          const wpm = Number(speed?.value || 18);
          flashMorse(output?.value || "", wpm, flashScreen);
        });
        const closeFlash = () => {
          clearFlash();
          flashScreen?.classList.remove("on");
          flashScreen?.setAttribute("hidden", "");
          flashScreen?.removeAttribute("data-running");
        };
        flashClose?.addEventListener("click", closeFlash);
        flashScreen?.addEventListener("click", (e) => { if (e.target === flashScreen) closeFlash(); });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && flashScreen && !flashScreen.hasAttribute("hidden")) closeFlash();
        });

        buzzBtn?.addEventListener("click", () => {
          const wpm = Number(speed?.value || 18);
          const ok = vibrateMorse(output?.value || "", wpm);
          if (!ok) {
            const old = buzzBtn.textContent;
            buzzBtn.textContent = "Not supported";
            setTimeout(() => (buzzBtn.textContent = old), 1200);
          }
        });

        function refreshNato() {
          if (!natoToggle || !natoOut) return;
          if (natoToggle.checked) {
            natoOut.hidden = false;
            natoOut.textContent = toNato(input.value || "");
          } else {
            natoOut.hidden = true;
          }
          try { localStorage.setItem("mcg.nato", natoToggle.checked ? "1" : "0"); } catch {}
        }
        natoToggle?.addEventListener("change", refreshNato);
        input?.addEventListener("input", refreshNato);
        refreshNato();
      });
    })();
  </script>

  <!-- ✅ FIXED auto-run logic -->
  <script is:inline define:vars={{ initial, hasInitial }}>
    (function () {
      function ready(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      ready(function () {
        const input = document.getElementById("mcg-input");
        const output = document.getElementById("mcg-output");
        const runBtn = document.getElementById("mcg-text-to-morse");

        if (!input || !runBtn) return;

        if (initial && !input.value.trim()) {
          input.value = initial;
        }

        if (!initial && !input.value.trim()) {
          input.value = "HELLO";
        }

        // 🔑 WAIT until mcg-tool.js has attached handlers
        function tryRun(attempt = 0) {
          if (attempt > 20) return;

          // tool attaches listeners to the button
          const hasHandler =
            runBtn.onclick || runBtn._mcgReady || runBtn.getAttribute("data-ready");

          if (hasHandler) {
            runBtn.click();
          } else {
            setTimeout(() => tryRun(attempt + 1), 50);
          }
        }

        if (hasInitial) {
          tryRun();
        }
      });
    })();
  </script>

  <style>
    /* Hero — left aligned, focused */
    .t-hero{ margin: var(--s-3) 0 var(--s-6); max-width: 720px; }
    .t-hero-title{
      margin: 0 0 var(--s-3);
      font-size: clamp(28px, 4vw, 44px);
      letter-spacing: -0.025em;
      line-height: 1.1;
    }
    .t-hero-sub{ margin: 0; color: var(--text-muted); font-size: var(--fs-md); max-width: 60ch; }

    /* Translator surface */
    .translator{
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }
    .translator-head{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
      padding: var(--s-3) var(--s-5);
      background: var(--surface-2);
      border-bottom: 1px solid var(--line);
      font-size: var(--fs-xs);
      color: var(--text-muted);
      flex-wrap: wrap;
    }
    .translator-status{ display: flex; align-items: center; gap: var(--s-2); }
    .dot-on{
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--good);
      box-shadow: 0 0 0 3px rgba(34,197,94,0.16);
    }
    .t-meta, .translator-spec{ font-family: var(--font-mono); font-size: 11px; }
    .translator-spec{ display: inline-flex; gap: var(--s-2); align-items: center; }
    .translator-spec .sep{ color: var(--text-subtle); }

    /* Body: text | swap | morse */
    .translator-body{
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }
    @media (min-width: 820px){
      .translator-body{
        grid-template-columns: 1fr 56px 1fr;
        align-items: stretch;
      }
    }
