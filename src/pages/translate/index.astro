---
import Layout from "../../components/Layout.astro";

const title = "Text to Morse Translator – Copy & Convert Instantly";
const description =
  "Translate text to Morse code or decode Morse to text. Copy results instantly. Free online tool.";

// Read ?q= from the URL (SSR-safe)
const q = (Astro.url.searchParams.get("q") ?? "").toString();
const initial = q.trim() ? q.trim().slice(0, 5000) : ""; // safety cap
const hasInitial = Boolean(initial);
---

<Layout title={title} description={description}>
  <header class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker muted">Fast • Private • No logins</p>
        <h1 class="hero-title">Text to Morse Translator</h1>
        <p class="muted hero-sub">
          Paste text, convert to Morse, decode Morse back to text, and copy results instantly.
          Runs locally in your browser (no account needed).
        </p>

        <div class="hero-actions">
          <a class="cta primary" href="/phrases/">Practice phrases</a>
          <a class="cta ghost" href="/morse-code/a/">Learn alphabet</a>
          <a class="cta ghost" href="/">Back to home</a>
        </div>

        <div class="hint-row">
          <span class="hint">Letters: spaces</span>
          <span class="hint">Words: “/”</span>
          <span class="hint muted">Example: <span class="k">SOS</span> → <span class="k">... --- ...</span></span>
        </div>
      </div>
    </div>
  </header>

  <section class="card tool-card" aria-label="Translator tool">
    <div class="tool-head">
      <div>
        <h2 class="tool-title">Translator</h2>
        <p class="muted tool-sub">Spaces separate letters • “/” separates words</p>
      </div>

      <div class="tool-mini-links muted">
        <a href="/translate/?q=HELLO">HELLO</a> •
        <a href="/translate/?q=SOS">SOS</a> •
        <a href="/translate/?q=I%20LOVE%20YOU">I LOVE YOU</a>
      </div>
    </div>

    <div class="grid tool-grid">
      <div class="col">
        <label for="mcg-input" class="lbl">Input</label>
        <textarea
          id="mcg-input"
          rows="9"
          placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
        ></textarea>

        <div class="actions">
          <div class="action-group primary">
            <button id="mcg-text-to-morse" type="button">Text → Morse</button>
            <button id="mcg-morse-to-text" type="button">Morse → Text</button>
            <button id="mcg-copy" type="button">Copy output</button>
          </div>

          <div class="action-group secondary">
            <button id="mcg-swap" type="button" class="ghost-btn">Swap</button>
            <button id="mcg-clear" type="button" class="ghost-btn">Clear</button>
          </div>
        </div>

        <p class="muted micro">
          Example:
          <span class="k">.... . .-.. .-.. --- / .-- --- .-. .-.. -..</span>
        </p>
      </div>

      <div class="col">
        <label for="mcg-output" class="lbl">Output</label>
        <textarea
          id="mcg-output"
          rows="9"
          class="mono"
          placeholder="Result appears here..."
        ></textarea>

        <p class="muted micro">
          Tip: you can share links like <span class="k">/translate/?q=YOUR+TEXT</span>.
        </p>
      </div>
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">How to use</h2>
    <ol>
      <li>Enter text or Morse code in the input box.</li>
      <li>Choose <strong>Text → Morse</strong> or <strong>Morse → Text</strong>.</li>
      <li>Copy the output for practice, notes, or messages.</li>
    </ol>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Common phrases</h2>
      <p class="muted section-note">Practice using phrases people recognize.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;" role="list">
      <a role="listitem" href="/phrases/sos/">SOS</a>
      <a role="listitem" href="/phrases/help/">HELP</a>
      <a role="listitem" href="/phrases/mayday/">MAYDAY</a>
      <a role="listitem" href="/phrases/emergency/">EMERGENCY</a>

      <a role="listitem" href="/phrases/ok/">OK</a>
      <a role="listitem" href="/phrases/yes/">YES</a>
      <a role="listitem" href="/phrases/no/">NO</a>
      <a role="listitem" href="/phrases/hello/">HELLO</a>

      <a role="listitem" href="/phrases/thank-you/">THANK YOU</a>
      <a role="listitem" href="/phrases/please/">PLEASE</a>
      <a role="listitem" href="/phrases/sorry/">SORRY</a>
      <a role="listitem" href="/phrases/i-love-you/">I LOVE YOU</a>
    </div>

    <p class="muted" style="margin-top:10px;">
      Want more? Browse the <a href="/phrases/">phrases section</a>.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>

    <h3 style="margin-bottom:6px;">How do I separate letters and words in Morse?</h3>
    <p class="muted" style="margin-top:0;">
      Use spaces between letters, and use “/” between words.
      Example: <span class="k">.... . .-.. .-.. --- / .-- --- .-. .-.. -..</span>.
    </p>

    <h3 style="margin-bottom:6px;">Can I decode Morse back to text?</h3>
    <p class="muted" style="margin-top:0;">
      Yes. Paste Morse code into the input box and click <strong>Morse → Text</strong>.
    </p>
  </section>

  <p style="margin-top:16px;">
    Next: <a href="/morse-code/a/">learn the alphabet</a> or <a href="/morse-code/numbers/">numbers</a>.
  </p>

  <!-- Runtime script -->
  <script defer src="/mcg-tool.js"></script>

  <!-- UX glue: set initial value safely + swap/clear + auto-run when ?q= -->
  <script is:inline define:vars={{ initial, hasInitial }}>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      onReady(function () {
        const input = document.getElementById("mcg-input");
        const output = document.getElementById("mcg-output");
        const swap = document.getElementById("mcg-swap");
        const clear = document.getElementById("mcg-clear");
        const btnT2M = document.getElementById("mcg-text-to-morse");

        if (!input || !output) return;

        // Fix: don't render text inside <textarea>...</textarea> (whitespace + selection bugs)
        if (initial && !input.value.trim()) input.value = String(initial);
        if (!initial && !input.value.trim()) input.value = "HELLO";

        input.focus();

        if (hasInitial && btnT2M && !output.value.trim()) {
          setTimeout(() => btnT2M.click(), 0);
        }

        swap?.addEventListener("click", () => {
          const a = input.value;
          input.value = output.value;
          output.value = a;
          input.focus();
        });

        clear?.addEventListener("click", () => {
          input.value = "";
          output.value = "";
          input.focus();
        });
      });
    })();
  </script>

  <style>
    .hero { margin-bottom: 14px; }
    .hero-kicker{
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
      text-align: center;
    }
    .hero-title { margin: 0 0 8px; text-align: center; }
    .hero-sub { margin: 0 auto; max-width: 72ch; text-align: center; }

    .hero-actions{
      margin-top: 14px;
      display:flex;
      gap: 10px;
      justify-content:center;
      flex-wrap:wrap;
    }

    .cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height: 38px;
      padding: 0 14px;
      border-radius: 999px;
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
      color: rgba(255,255,255,0.92);
      font-weight: 850;
      line-height: 1;
    }
    .cta:hover { opacity: 0.95; }
    .cta.primary{
      border-color: rgba(138,180,255,0.30);
      background: rgba(138,180,255,0.12);
    }
    .cta.ghost{
      border-color: rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
      font-weight: 750;
    }

    .hint-row{
      margin-top: 14px;
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      justify-content:center;
      align-items:center;
    }
    .hint{
      display:inline-flex;
      align-items:center;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.82);
      font-size: 13px;
      line-height: 1.2;
    }

    .tool-card { margin-top: 16px; }
    .tool-head{
      display:flex;
      flex-wrap:wrap;
      gap: 10px 14px;
      align-items: baseline;
      justify-content: space-between;
    }
    .tool-title { margin: 0 0 6px; }
    .tool-sub { margin: 0; }
    .tool-mini-links { font-size: 13px; }
    .tool-mini-links a { text-decoration: none; }
    .tool-mini-links a:hover { text-decoration: underline; }

    .tool-grid { margin-top: 12px; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }
    .section-title{ margin: 0; }
    .section-note{ margin: 0; }

    .lbl{
      display:inline-block;
      font-weight: 800;
      margin-bottom: 6px;
    }

    textarea{
      resize: none;
      min-height: 190px;
    }

    .mono{
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .25px;
    }

    .actions{
      margin-top: 12px;
      display:flex;
      flex-direction: column;
      gap: 10px;
    }

    .action-group{
      display:flex;
      flex-wrap:wrap;
      gap: 10px;
      align-items:center;
    }

    .ghost-btn{
      border-color: rgba(255,255,255,0.18) !important;
      background: rgba(255,255,255,0.03) !important;
      font-weight: 750;
    }

    .micro{
      margin-top: 10px;
    }

    @media (min-width: 860px){
      .tool-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 520px) {
      .hero-kicker, .hero-title, .hero-sub { text-align: left; }
      .hero-sub { margin-left: 0; }
      .hero-actions { justify-content: flex-start; }
      .hint-row { justify-content: flex-start; }

      .action-group.primary button,
      .action-group.secondary button{
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</Layout>
