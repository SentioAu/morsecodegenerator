---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Fast, Free Morse Translator";
const description =
  "Translate text to Morse code, decode Morse back to plain text, and practice letters, words, and phrases with instant copy tools.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/`;
const robots = "index,follow";

const crumbs = [{ name: "Home", url: canonical }];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="kicker">Free • Fast • Private</p>

        <h1 class="hero-title">Translate & Learn Morse Code in Seconds</h1>

        <p class="muted hero-sub">
          Convert text to Morse, decode Morse back to plain text, and drill letters, words, and phrases.
          Everything runs in your browser with instant copy tools and zero sign-up.
        </p>

        <div class="hero-actions">
          <a class="btn primary" href="/translate/">
            Start translating
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn secondary" href="/morse-code/">Explore the learning hub</a>
        </div>

        <div class="hero-stats" role="list">
          <div class="stat" role="listitem">
            <p class="stat-value">A–Z + 0–9</p>
            <p class="muted stat-label">Complete alphabet</p>
          </div>
          <div class="stat" role="listitem">
            <p class="stat-value">20+ symbols</p>
            <p class="muted stat-label">Punctuation & prosigns</p>
          </div>
          <div class="stat" role="listitem">
            <p class="stat-value">Instant copy</p>
            <p class="muted stat-label">Ready for sharing</p>
          </div>
        </div>

        <div class="hint-row" aria-label="Morse formatting tips">
          <span class="hint">Letters separated by spaces</span>
          <span class="hint">Words separated by “/”</span>
          <span class="hint muted">Example: <span class="k">SOS</span> → <span class="k">... --- ...</span></span>
        </div>
      </div>

      <section class="card glow tool" aria-label="Quick translate">
        <div class="tool-head">
          <div>
            <p class="muted tool-eyebrow">Quick translator</p>
            <h2 style="margin:0;">Try it now</h2>
            <p class="muted" style="margin:6px 0 0;">
              Type text or Morse and convert instantly. The full translator adds autoswap, sharing, and practice tips.
            </p>
          </div>

          <div class="tool-mini-links">
            <a href="/morse-code/words/">Words</a>
            <span aria-hidden="true">•</span>
            <a href="/morse-code/numbers/">Numbers</a>
            <span aria-hidden="true">•</span>
            <a href="/morse-code/punctuation/">Punctuation</a>
          </div>
        </div>

        <div class="grid tool-grid" style="margin-top:12px;">
          <div>
            <label for="mcg-input"><strong>Input</strong></label><br />
            <textarea
              id="mcg-input"
              rows="7"
              placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
              inputmode="text"
              maxlength="5000"
            >HELLO</textarea>

            <div class="tool-row" style="margin-top:10px;">
              <button id="mcg-text-to-morse" type="button">Text → Morse</button>
              <button id="mcg-morse-to-text" type="button">Morse → Text</button>
              <button id="mcg-copy" type="button">Copy output</button>

              <span class="spacer" aria-hidden="true"></span>

              <button id="mcg-swap" type="button">Swap</button>
              <button id="mcg-clear" type="button">Clear</button>
            </div>

            <p class="muted" style="margin-top:10px;">
              Tip: Use <span class="k">/</span> between words and double-check spacing.
            </p>
          </div>

          <div>
            <label for="mcg-output"><strong>Output</strong></label><br />
            <textarea
              id="mcg-output"
              rows="7"
              class="mono"
              placeholder="Your result will appear here..."
              readonly
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
            ></textarea>

            <div class="output-actions">
              <p class="muted" style="margin:0;">
                Want more controls?
              </p>
              <a class="btn ghost" href="/translate/">Open the translator</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </header>

  <!-- Toast for copy feedback -->
  <div id="mcg-toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="kicker">Everything you need</p>
        <h2 class="section-title">Learn, practice, and share in one place</h2>
      </div>
      <p class="muted section-sub">Every page is optimized for quick study sessions, classroom demos, or emergency prep.</p>
    </div>
    <div class="grid feature-grid">
      <article class="feature-card">
        <div class="feature-icon" aria-hidden="true">⚡️</div>
        <h3>Instant conversion</h3>
        <p class="muted">Paste text or Morse and get results immediately with copy-ready output.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon" aria-hidden="true">📚</div>
        <h3>Learning-friendly</h3>
        <p class="muted">Reference pages cover letters, numbers, punctuation, and common words.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon" aria-hidden="true">🎯</div>
        <h3>Practice workflows</h3>
        <p class="muted">Use phrases, word lists, and the translator to drill patterns fast.</p>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-head">
      <div>
        <p class="kicker">Fast navigation</p>
        <h2 class="section-title">Jump into the learning hubs</h2>
      </div>
      <p class="muted section-sub">Choose a path: letters, numbers, punctuation, or full words and phrases.</p>
    </div>
    <div class="grid hub">
      <section class="card hub-card">
        <h3>Learn Morse Code</h3>
        <p class="muted">
          Start with the alphabet, then move to numbers and punctuation.
        </p>
        <div class="pill-grid">
          <a href="/morse-code/a/">Alphabet (A–Z)</a>
          <a href="/morse-code/numbers/">Numbers (0–9)</a>
          <a href="/morse-code/punctuation/">Punctuation</a>
          <a href="/morse-code/words/">Words (A–Z)</a>
          <a href="/translate/">Practice in Translator</a>
        </div>
        <p class="muted">
          Practice tip: learn a few letters per day and test yourself using the translator.
        </p>
      </section>

      <section class="card hub-card">
        <h3>Common Phrases</h3>
        <p class="muted">
          Popular phrases people search for and copy.
        </p>
        <div class="pill-grid">
          <a href="/phrases/sos/">SOS</a>
          <a href="/phrases/help/">HELP</a>
          <a href="/phrases/mayday/">MAYDAY</a>
          <a href="/phrases/emergency/">EMERGENCY</a>
          <a href="/phrases/stop/">STOP</a>
          <a href="/phrases/wait/">WAIT</a>
          <a href="/phrases/call-me/">CALL ME</a>
          <a href="/phrases/i-love-you/">I LOVE YOU</a>
        </div>
        <p class="muted">
          Browse all phrases in the <a href="/phrases/">phrases section</a>.
        </p>
      </section>

      <section class="card hub-card">
        <h3>Morse Code Words</h3>
        <p class="muted">
          Click any word to open a dedicated page with its Morse code.
        </p>
        <div class="pill-grid">
          <a href="/morse-code/words/">Browse words A–Z</a>
          <a href="/hello-in-morse-code/">HELLO</a>
          <a href="/thank-you-in-morse-code/">THANK YOU</a>
          <a href="/good-night-in-morse-code/">GOOD NIGHT</a>
          <a href="/i-love-you-in-morse-code/">I LOVE YOU</a>
          <a href="/help-in-morse-code/">HELP</a>
          <a href="/water-in-morse-code/">WATER</a>
          <a href="/welcome-in-morse-code/">WELCOME</a>
        </div>
        <p class="muted">
          Tip: you can also practice any word instantly in the <a href="/translate/">translator</a>.
        </p>
      </section>
    </div>
  </section>

  <section class="section steps">
    <div class="section-head">
      <div>
        <p class="kicker">How it works</p>
        <h2 class="section-title">Translate in three simple steps</h2>
      </div>
      <p class="muted section-sub">Perfect for quick conversions or structured practice sessions.</p>
    </div>
    <div class="grid step-grid">
      <div class="step-card">
        <span class="step-number">01</span>
        <h3>Paste or type your message</h3>
        <p class="muted">Use plain text or Morse symbols. The tool detects both.</p>
      </div>
      <div class="step-card">
        <span class="step-number">02</span>
        <h3>Convert instantly</h3>
        <p class="muted">Tap Text → Morse or Morse → Text to get results fast.</p>
      </div>
      <div class="step-card">
        <span class="step-number">03</span>
        <h3>Copy + practice</h3>
        <p class="muted">Save output to share or drill patterns with words and phrases.</p>
      </div>
    </div>
  </section>

  <section class="section card soft">
    <div class="section-head">
      <h2 class="section-title">Common words to practice</h2>
      <p class="muted section-sub">Open a dedicated word page or practice in the translator.</p>
    </div>
    <div class="pill-grid">
      <a href="/help-in-morse-code/">HELP</a>
      <a href="/water-in-morse-code/">WATER</a>
      <a href="/danger-in-morse-code/">DANGER</a>
      <a href="/safe-in-morse-code/">SAFE</a>
      <a href="/ready-in-morse-code/">READY</a>
      <a href="/hello-in-morse-code/">HELLO</a>
      <a href="/thank-you-in-morse-code/">THANK YOU</a>
      <a href="/sorry-in-morse-code/">SORRY</a>
    </div>
  </section>

  <section class="section card soft">
    <div class="section-head">
      <h2 class="section-title">Quick answers</h2>
      <p class="muted section-sub">Common searches with direct links to learn or translate faster.</p>
    </div>
    <ul>
      <li>
        <strong>SOS in Morse code:</strong> <span class="k">... --- ...</span>. Try it in the
        <a href="/translate/?q=SOS"> translator</a>.
      </li>
      <li>
        <strong>Morse alphabet chart:</strong> Browse the
        <a href="/morse-code/a/"> A–Z reference</a>.
      </li>
      <li>
        <strong>Morse numbers:</strong> Learn 0–9 on the
        <a href="/morse-code/numbers/"> numbers page</a>.
      </li>
      <li>
        <strong>Common phrases:</strong> Explore the
        <a href="/phrases/"> phrases library</a> for practice.
      </li>
    </ul>
  </section>

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <!-- Runtime tool (owns conversion + swap + clear + auto-detect) -->
  <script defer src="/mcg-tool.js"></script>

  <!-- Page-only UX: Copy toast -->
  <script is:inline>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      onReady(function () {
        const output = document.getElementById("mcg-output");
        const copyBtn = document.getElementById("mcg-copy");
        const toast = document.getElementById("mcg-toast");

        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add("show");
          window.clearTimeout(showToast._t);
          showToast._t = window.setTimeout(
            () => toast.classList.remove("show"),
            1800
          );
        }

        copyBtn?.addEventListener("click", async () => {
          const v = (output?.value || "").trim();
          if (!v) return showToast("Nothing to copy");

          try {
            await navigator.clipboard.writeText(v);
            showToast("Copied output");
          } catch {
            try {
              output?.focus();
              output?.select();
              const ok = document.execCommand("copy");
              showToast(ok ? "Copied output" : "Copy failed");
              window.getSelection()?.removeAllRanges?.();
            } catch {
              showToast("Copy failed");
            }
          }
        });
      });
    })();
  </script>

  <style>
    .hero{
      position: relative;
    }
    .hero-grid{
      display:grid;
      grid-template-columns: 1fr;
      gap: 20px;
      align-items: start;
    }

    .kicker{
      margin: 0 0 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
      color: var(--accentStrong);
    }

    .hero-title{ margin: 0 0 12px; font-size: clamp(34px, 3.6vw, 52px); }
    .hero-sub{ margin: 0; max-width: 70ch; }

    .hero-actions{
      margin-top: 18px;
      display:flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .hero-stats{
      margin-top: 18px;
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
    }
    .stat{
      padding: 12px 14px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.03);
    }
    .stat-value{
      margin: 0;
      font-weight: 800;
      font-size: 16px;
    }
    .stat-label{
      margin: 4px 0 0;
      font-size: 13px;
    }

    .hint-row{
      margin-top: 16px;
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      align-items:center;
    }
    .hint{
      display:inline-flex;
      align-items:center;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.82);
      font-size: 13px;
      line-height: 1.2;
    }

    .tool-head{
      display:flex;
      flex-wrap:wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px 14px;
    }
    .tool-eyebrow{
      margin: 0 0 6px;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .tool-mini-links{
      font-size: 13px;
      display:flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items:center;
    }
    .tool-mini-links a{ text-decoration:none; }
    .tool-mini-links a:hover{ text-decoration: underline; }

    .tool-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
    .spacer{ flex:1; min-width: 8px; }

    .output-actions{
      margin-top: 12px;
      display:flex;
      align-items:center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .feature-grid{
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .feature-card{
      padding: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
    }
    .feature-card h3{
      margin: 12px 0 6px;
      font-size: 16px;
    }
    .feature-icon{
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display:flex;
      align-items:center;
      justify-content:center;
      background: rgba(138,180,255,0.18);
      border: 1px solid rgba(138,180,255,0.35);
      font-size: 18px;
    }

    .hub{
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .hub-card{
      display:flex;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
      border-color: rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.02);
    }
    .hub-card h3{
      margin: 0;
    }
    .hub-card .pill-grid{
      margin: 0;
    }
    .hub-card p{ margin: 0; }

    .steps{
      padding: 0;
    }
    .step-grid{
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .step-card{
      padding: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.03);
    }
    .step-number{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid rgba(126,240,255,0.35);
      background: rgba(126,240,255,0.14);
      font-weight: 800;
      margin-bottom: 10px;
    }
    @media (min-width: 980px){
      .hero-grid{ grid-template-columns: 0.95fr 1.05fr; }
      .feature-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .hub{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .step-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 520px){
      .hero-actions .btn{ width:100%; }
      .spacer{ display:none; }
      .tool-row button{ width:100%; }
    }

    /* Toast */
    .toast{
      position: fixed;
      left: 50%;
      bottom: 18px;
      max-width: min(560px, calc(100vw - 24px));
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,0.78);
      backdrop-filter: blur(10px);
      color: rgba(255,255,255,0.92);
      box-shadow: var(--shadow);
      opacity: 0;
      pointer-events: none;
      transition: opacity .14s ease, transform .14s ease;
      transform: translateX(-50%) translateY(8px);
      font-weight: 750;
      z-index: 50;
    }
    .toast.show{
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>
</Layout>
