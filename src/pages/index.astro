---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Translate Text to Morse Instantly";
const description =
  "Free online Morse code generator. Convert text to Morse code, decode Morse to text, and copy results instantly.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/`;
const robots = "index,follow";

const crumbs = [{ name: "Home", url: canonical }];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="muted kicker">Free • Fast • Private</p>

        <h1 class="hero-title">Morse Code Generator</h1>

        <p class="muted hero-sub">
          Translate text to Morse code instantly, decode Morse back to text, and copy results in one click.
          Runs entirely in your browser — no accounts, no logins.
        </p>

        <div class="hero-actions">
          <a class="btn primary" href="/translate/">Open Translator</a>
          <a class="btn" href="/morse-code/">Learn hub</a>
          <a class="btn" href="/morse-code/words/">Practice Words</a>
          <a class="btn" href="/phrases/">Practice Phrases</a>
        </div>

        <div class="hint-row" aria-label="Morse formatting tips">
          <span class="hint">Letters: spaces</span>
          <span class="hint">Words: “/”</span>
          <span class="hint muted">Example: <span class="k">SOS</span> → <span class="k">... --- ...</span></span>
        </div>
      </div>

      <section class="card tool" aria-label="Quick translate">
        <div class="tool-head">
          <div>
            <h2 style="margin:0;">Quick translate</h2>
            <p class="muted" style="margin:6px 0 0;">
              Type text or Morse and convert instantly. (Full tool available on the translator page.)
            </p>
          </div>

          <div class="muted tool-mini-links">
            <a href="/morse-code/words/">Words</a> •
            <a href="/morse-code/numbers/">Numbers</a> •
            <a href="/morse-code/punctuation/">Punctuation</a>
          </div>
        </div>

        <div class="grid tool-grid" style="margin-top:12px;">
          <div>
            <label for="mcg-input"><strong>Input</strong></label><br />
            <textarea
              id="mcg-input"
              rows="7"
              placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
              inputmode="text"
              maxlength="5000"
            >HELLO</textarea>

            <div class="tool-row" style="margin-top:10px;">
              <button id="mcg-text-to-morse" type="button">Text → Morse</button>
              <button id="mcg-morse-to-text" type="button">Morse → Text</button>
              <button id="mcg-copy" type="button">Copy output</button>

              <span class="spacer" aria-hidden="true"></span>

              <button id="mcg-swap" type="button">Swap</button>
              <button id="mcg-clear" type="button">Clear</button>
            </div>

            <p class="muted" style="margin-top:10px;">
              Tip: Use <span class="k">/</span> between words.
            </p>
          </div>

          <div>
            <label for="mcg-output"><strong>Output</strong></label><br />
            <textarea
              id="mcg-output"
              rows="7"
              class="mono"
              placeholder="Your result will appear here..."
              readonly
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
            ></textarea>

            <p class="muted" style="margin-top:10px;">
              Want the full tool? <a href="/translate/">Open the translator</a>.
            </p>
          </div>
        </div>
      </section>
    </div>
  </header>

  <!-- Toast for copy feedback -->
  <div id="mcg-toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <section class="grid hub" style="margin-top:16px;">
    <section class="card">
      <h2 style="margin-top:0;">Learn Morse Code</h2>
      <p class="muted" style="margin-top:0;">
        Start with the alphabet, then numbers and punctuation.
      </p>

      <div class="pill-grid" style="margin-top:12px;">
        <a href="/morse-code/a/">Alphabet (A–Z)</a>
        <a href="/morse-code/numbers/">Numbers (0–9)</a>
        <a href="/morse-code/punctuation/">Punctuation</a>
        <a href="/morse-code/words/">Words (A–Z)</a>
        <a href="/translate/">Practice in Translator</a>
      </div>

      <p class="muted" style="margin-top:12px;">
        Practice tip: learn a few letters per day and test yourself using the translator.
      </p>
    </section>

    <section class="card">
      <h2 style="margin-top:0;">Common Phrases</h2>
      <p class="muted" style="margin-top:0;">
        Popular phrases people search for and copy.
      </p>

      <div class="pill-grid" style="margin-top:12px;">
        <a href="/phrases/sos/">SOS</a>
        <a href="/phrases/help/">HELP</a>
        <a href="/phrases/mayday/">MAYDAY</a>
        <a href="/phrases/emergency/">EMERGENCY</a>
        <a href="/phrases/stop/">STOP</a>
        <a href="/phrases/wait/">WAIT</a>
        <a href="/phrases/call-me/">CALL ME</a>
        <a href="/phrases/i-love-you/">I LOVE YOU</a>
      </div>

      <p class="muted" style="margin-top:10px;">
        Browse all phrases in the <a href="/phrases/">phrases section</a>.
      </p>
    </section>

    <section class="card">
      <h2 style="margin-top:0;">Morse Code Words</h2>
      <p class="muted" style="margin-top:0;">
        Click any word to open a dedicated page with its Morse code.
      </p>

      <div class="pill-grid" style="margin-top:12px;">
        <a href="/morse-code/words/">Browse words A–Z</a>
        <a href="/hello-in-morse-code/">HELLO</a>
        <a href="/thank-you-in-morse-code/">THANK YOU</a>
        <a href="/good-night-in-morse-code/">GOOD NIGHT</a>
        <a href="/i-love-you-in-morse-code/">I LOVE YOU</a>
        <a href="/help-in-morse-code/">HELP</a>
        <a href="/water-in-morse-code/">WATER</a>
        <a href="/welcome-in-morse-code/">WELCOME</a>
      </div>

      <p class="muted" style="margin-top:10px;">
        Tip: you can also practice any word instantly in the <a href="/translate/">translator</a>.
      </p>
    </section>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">How it works</h2>
    <ol>
      <li>Type text or paste Morse into the input box.</li>
      <li>Use the convert buttons (Text → Morse / Morse → Text).</li>
      <li>Copy output and practice using alphabet, words, and phrases.</li>
    </ol>
  </section>

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <!-- Runtime tool (owns conversion + swap + clear + auto-detect) -->
  <script defer src="/mcg-tool.js"></script>

  <!-- Page-only UX: Copy toast -->
  <script is:inline>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      onReady(function () {
        const output = document.getElementById("mcg-output");
        const copyBtn = document.getElementById("mcg-copy");
        const toast = document.getElementById("mcg-toast");

        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add("show");
          window.clearTimeout(showToast._t);
          showToast._t = window.setTimeout(
            () => toast.classList.remove("show"),
            1800
          );
        }

        copyBtn?.addEventListener("click", async () => {
          const v = (output?.value || "").trim();
          if (!v) return showToast("Nothing to copy");

          try {
            await navigator.clipboard.writeText(v);
            showToast("Copied output");
          } catch {
            try {
              output?.focus();
              output?.select();
              const ok = document.execCommand("copy");
              showToast(ok ? "Copied output" : "Copy failed");
              window.getSelection()?.removeAllRanges?.();
            } catch {
              showToast("Copy failed");
            }
          }
        });
      });
    })();
  </script>

  <style>
    .hero-grid{
      display:grid;
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }

    .kicker{
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
    }

    .hero-title{ margin: 0 0 10px; }
    .hero-sub{ margin: 0; max-width: 72ch; }

    .hero-actions{
      margin-top: 14px;
      display:flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .hint-row{
      margin-top: 14px;
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      align-items:center;
    }
    .hint{
      display:inline-flex;
      align-items:center;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.82);
      font-size: 13px;
      line-height: 1.2;
    }

    .tool-head{
      display:flex;
      flex-wrap:wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px 14px;
    }
    .tool-mini-links{ font-size: 13px; }
    .tool-mini-links a{ text-decoration:none; }
    .tool-mini-links a:hover{ text-decoration: underline; }

    .tool-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
    .spacer{ flex:1; min-width: 8px; }

    .hub{
      grid-template-columns: 1fr;
    }
    @media (min-width: 980px){
      .hero-grid{ grid-template-columns: 0.95fr 1.05fr; }
      .hub{ grid-template-columns: 1fr 1fr 1fr; }
    }

    @media (max-width: 520px){
      .hero-actions .btn{ width:100%; }
      .spacer{ display:none; }
      .tool-row button{ width:100%; }
    }

    /* Toast */
    .toast{
      position: fixed;
      left: 50%;
      bottom: 18px;
      max-width: min(560px, calc(100vw - 24px));
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,0.78);
      backdrop-filter: blur(10px);
      color: rgba(255,255,255,0.92);
      box-shadow: var(--shadow);
      opacity: 0;
      pointer-events: none;
      transition: opacity .14s ease, transform .14s ease;
      transform: translateX(-50%) translateY(8px);
      font-weight: 750;
      z-index: 50;
    }
    .toast.show{
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>
</Layout>
