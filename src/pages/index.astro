  <!-- Runtime tool (owns conversion + swap + clear + auto-detect) -->
  <script defer src="/mcg-tool.js"></script>

  <!-- Page-only UX: Copy toast -->
  <script is:inline>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      onReady(function () {
        const input = document.getElementById("mcg-input");
        const output = document.getElementById("mcg-output");
        const copyBtn = document.getElementById("mcg-copy");
        const playBtn = document.getElementById("mcg-play");
        const downloadBtn = document.getElementById("mcg-download");
        const historyBtn = document.getElementById("mcg-history");
        const voiceBtn = document.getElementById("mcg-voice");
        const toast = document.getElementById("mcg-toast");

        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add("show");
          window.clearTimeout(showToast._t);
          showToast._t = window.setTimeout(
            () => toast.classList.remove("show"),
            1800
          );
        }



        downloadBtn?.addEventListener("click", () => {
          const v = (output?.value || "").trim();
          if (!v) return showToast("Nothing to download");
          const blob = new Blob([v], { type: "text/plain;charset=utf-8" });
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = "morse-output.txt";
          a.click();
          URL.revokeObjectURL(a.href);
        });

        historyBtn?.addEventListener("click", () => {
          const key = "mcg-history";
          const v = (output?.value || "").trim();
          if (v) {
            const arr = JSON.parse(localStorage.getItem(key) || "[]");
            arr.unshift(v);
            localStorage.setItem(key, JSON.stringify(arr.slice(0, 10)));
            showToast("Saved to history");
            return;
          }
          const arr = JSON.parse(localStorage.getItem(key) || "[]");
          if (!arr.length) return showToast("No history yet");
          input.value = arr[0];
          showToast("Loaded latest history item");
        });

        playBtn?.addEventListener("click", () => {
          const text = (output?.value || "").split("\n")[0].replace(/[^.\-\/\s]/g, "").trim();
          if (!text) return showToast("Nothing to play");
          const ctx = new (window.AudioContext || window.webkitAudioContext)();
          let t = ctx.currentTime;
          const unit = 0.09;
          for (const token of text.split(/\s+/)) {
            if (token === "/") { t += unit * 7; continue; }
            for (const c of token) {
              const dur = c === "-" ? unit * 3 : unit;
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.frequency.value = 620;
              gain.gain.value = 0.18;
              osc.connect(gain); gain.connect(ctx.destination);
              osc.start(t); osc.stop(t + dur);
              t += dur + unit;
            }
            t += unit * 2;
          }
          showToast("Playing Morse");
        });

        voiceBtn?.addEventListener("click", () => {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) return showToast("Voice input not supported");
          const rec = new SR();
          rec.lang = "en-US";
          rec.onresult = (e) => {
            const txt = e.results?.[0]?.[0]?.transcript || "";
            if (input) input.value = txt;
            showToast("Voice captured");
          };
          rec.start();
        });

        const checkboxes = Array.from(document.querySelectorAll("#quickChecklist input[type=checkbox]"));
        const checkCount = document.getElementById("checkCount");
        const saveChecklist = () => {
          const done = checkboxes.filter((c) => c.checked).length;
          if (checkCount) checkCount.textContent = String(done);
          localStorage.setItem("mcg-checklist", JSON.stringify(checkboxes.map((c) => c.checked)));
        };
        try {
          const saved = JSON.parse(localStorage.getItem("mcg-checklist") || "[]");
          checkboxes.forEach((c, i) => (c.checked = !!saved[i]));
        } catch {}
        checkboxes.forEach((c) => c.addEventListener("change", saveChecklist));
        saveChecklist();

        const word = "COURAGE";
        const wordMorse = "-.-. --- ..- .-. .- --. .";
        const dayPlay = document.getElementById("wordDayPlay");
        const dayCopy = document.getElementById("wordDayCopy");
        dayCopy?.addEventListener("click", async () => {
          try { await navigator.clipboard.writeText(word + " — " + wordMorse); showToast("Word copied"); } catch {}
        });
        dayPlay?.addEventListener("click", () => {
          if (output) output.value = wordMorse;
          playBtn?.click();
        });

        copyBtn?.addEventListener("click", async () => {
          const v = (output?.value || "").trim();
          if (!v) return showToast("Nothing to copy");

          try {
            await navigator.clipboard.writeText(v);
            showToast("Copied output");
          } catch {
            try {
              output?.focus();
              output?.select();
              const ok = document.execCommand("copy");
              showToast(ok ? "Copied output" : "Copy failed");
              window.getSelection()?.removeAllRanges?.();
            } catch {
              showToast("Copy failed");
            }
          }
        });
      });
    })();
  </script>

