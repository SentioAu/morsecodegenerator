---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Translate Text to Morse Instantly";
const description =
  "Free online Morse code generator. Convert text to Morse code, decode Morse to text, and copy results instantly.";
---

<Layout title={title} description={description}>
  <header class="hero">
    <p class="hero-kicker muted">Free • Fast • Private</p>

    <h1 class="hero-title">Morse Code Generator</h1>

    <p class="hero-sub muted">
      Translate text to Morse code instantly, decode Morse back to text, and copy results in one click.
      Runs entirely in your browser — no accounts, no logins.
    </p>

    <div class="hero-actions">
      <a class="cta" href="/translate/">Open Translator</a>
      <a class="cta ghost" href="/morse-code/a/">Morse Alphabet</a>
      <a class="cta ghost" href="/phrases/">Common Phrases</a>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Quick translate</h2>
      <p class="muted section-note">Tip: use spaces between letters and “/” between words.</p>
    </div>

    <div class="grid tool-grid">
      <div>
        <label for="mcg-input"><strong>Input</strong></label><br />
        <textarea
          id="mcg-input"
          rows="8"
          placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
        >HELLO</textarea>

        <div class="tool-row">
          <button id="mcg-text-to-morse" type="button">Text → Morse</button>
          <button id="mcg-morse-to-text" type="button">Morse → Text</button>
          <button id="mcg-copy" type="button">Copy output</button>
        </div>

        <p class="muted" style="margin-top: 10px;">
          Input tips: letters/numbers work best in uppercase. For Morse, use spaces between characters and “/” between words.
        </p>
      </div>

      <div>
        <label for="mcg-output"><strong>Output</strong></label><br />
        <textarea id="mcg-output" rows="8" placeholder="Your result will appear here..."></textarea>

        <p class="muted" style="margin-top: 10px;">
          Copy the output, or switch direction to decode Morse back into readable text.
        </p>
      </div>
    </div>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top:0;">How to use this tool</h2>
    <ol>
      <li>Type text (or Morse code) in the <strong>Input</strong> box.</li>
      <li>Click <strong>Text → Morse</strong> or <strong>Morse → Text</strong>.</li>
      <li>Use <strong>Copy output</strong> to copy the result instantly.</li>
    </ol>
    <p class="muted">
      Morse basics: a dot (·) is a short signal and a dash (–) is a long signal.
      In this tool, spaces separate characters and “/” separates words.
    </p>
  </section>

  <section class="card" style="margin-top: 16px;">
    <div class="section-head">
      <h2 class="section-title">Common Morse Code Phrases</h2>
      <p class="muted section-note">Popular phrases people search for (each page includes a copy button).</p>
    </div>

    <div class="pill-grid home-pills" style="margin-top:12px;">
      <a href="/phrases/sos/">SOS</a>
      <a href="/phrases/help/">HELP</a>
      <a href="/phrases/mayday/">MAYDAY</a>
      <a href="/phrases/emergency/">EMERGENCY</a>

      <a href="/phrases/danger/">DANGER</a>
      <a href="/phrases/stop/">STOP</a>
      <a href="/phrases/wait/">WAIT</a>
      <a href="/phrases/come-here/">COME HERE</a>

      <a href="/phrases/call-me/">CALL ME</a>
      <a href="/phrases/call-police/">CALL POLICE</a>
      <a href="/phrases/call-ambulance/">CALL AMBULANCE</a>
      <a href="/phrases/i-need-help/">I NEED HELP</a>

      <a href="/phrases/i-am-lost/">I AM LOST</a>
      <a href="/phrases/where-are-you/">WHERE ARE YOU</a>
      <a href="/phrases/i-am-here/">I AM HERE</a>
      <a href="/phrases/meet-me/">MEET ME</a>

      <a href="/phrases/ok/">OK</a>
      <a href="/phrases/yes/">YES</a>
      <a href="/phrases/no/">NO</a>
      <a href="/phrases/hello/">HELLO</a>

      <a href="/phrases/thank-you/">THANK YOU</a>
      <a href="/phrases/please/">PLEASE</a>
      <a href="/phrases/sorry/">SORRY</a>
      <a href="/phrases/i-love-you/">I LOVE YOU</a>
    </div>
  </section>

  <section class="card" style="margin-top: 16px;">
    <div class="section-head">
      <h2 class="section-title">Learn Morse Code</h2>
      <p class="muted section-note">Start with the basics, then practice.</p>
    </div>

    <div class="pill-grid home-pills" style="margin-top:12px;">
      <a href="/morse-code/a/">Alphabet (A–Z)</a>
      <a href="/morse-code/numbers/">Numbers (0–9)</a>
      <a href="/morse-code/punctuation/">Punctuation</a>
      <a href="/translate/">Practice in Translator</a>
    </div>

    <p class="muted" style="margin-top: 12px;">
      Practice tip: read Morse visually first, then try listening (dot/dash rhythm) once you recognize patterns.
    </p>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top: 0;">FAQ</h2>
    <p>
      <strong>How do you separate letters in Morse code?</strong><br />
      <span class="muted">Use spaces between characters. Example: <span class="k">HELLO</span> → <span class="k">.... . .-.. .-.. ---</span></span>
    </p>
    <p>
      <strong>How do you separate words?</strong><br />
      <span class="muted">Use “/” between words. Example: <span class="k">HELP ME</span> → <span class="k">.... . .-.. .--. / -- .</span></span>
    </p>
    <p>
      <strong>Can I decode Morse back to text?</strong><br />
      <span class="muted">Yes — paste Morse into Input and click <span class="k">Morse → Text</span>.</span>
    </p>
  </section>

  <!-- Reliable runtime script -->
  <script defer src="/mcg-tool.js"></script>

  <!-- Homepage-only layout polish (NO component restyling) -->
  <style>
    .hero {
      text-align: center;
      padding: 8px 0 2px;
    }

    .hero-kicker {
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
    }

    .hero-title {
      margin: 0 0 10px;
    }

    .hero-sub {
      margin: 0 auto;
      max-width: 70ch;
    }

    .hero-actions {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* Home CTAs only (safe) */
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid rgba(138,180,255,0.30);
      background: rgba(138,180,255,0.12);
      color: rgba(255,255,255,0.92);
      font-weight: 750;
    }
    .cta:hover { opacity: 0.95; }
    .cta.ghost {
      border-color: rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
    }

    .section-head {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .section-title { margin: 0; }
    .section-note { margin: 0; }

    .tool-grid { margin-top: 12px; }

    .tool-row {
      margin-top: 12px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    /* Mobile: left-align hero for better reading */
    @media (max-width: 520px) {
      .hero { text-align: left; }
      .hero-sub { margin-left: 0; }
      .hero-actions { justify-content: flex-start; }
    }
  </style>
</Layout>
