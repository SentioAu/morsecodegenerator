---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Translate Text to Morse Instantly";
const description =
  "Free online Morse code generator. Convert text to Morse code, decode Morse to text, and copy results instantly.";
---

<Layout title={title} description={description}>
  <header class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker muted">Free • Fast • Private</p>
        <h1 class="hero-title">Morse Code Generator</h1>
        <p class="hero-sub muted">
          Translate text to Morse code instantly, decode Morse back to text, and copy results in one click.
          Runs entirely in your browser — no accounts, no logins.
        </p>

        <div class="hero-actions">
          <a class="cta primary" href="/translate/">Open Translator</a>
          <a class="cta" href="/morse-code/a/">Morse Alphabet</a>
          <a class="cta" href="/phrases/">Common Phrases</a>
        </div>

        <p class="muted hero-note">
          Tip: spaces separate letters • “/” separates words
        </p>
      </div>

      <div class="hero-side card">
        <h2 class="side-title">Quick translate</h2>
        <p class="muted side-sub">Type text or Morse, then convert and copy.</p>

        <div class="grid tool-grid">
          <div>
            <label for="mcg-input"><strong>Input</strong></label><br />
            <textarea
              id="mcg-input"
              rows="8"
              placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
            >HELLO</textarea>

            <div class="tool-row">
              <button id="mcg-text-to-morse" type="button">Text → Morse</button>
              <button id="mcg-morse-to-text" type="button">Morse → Text</button>
              <button id="mcg-copy" type="button">Copy output</button>
            </div>

            <p class="muted micro">
              For Morse: spaces between letters, “/” between words.
            </p>
          </div>

          <div>
            <label for="mcg-output"><strong>Output</strong></label><br />
            <textarea id="mcg-output" rows="8" placeholder="Your result will appear here..."></textarea>
            <p class="muted micro">
              Switch direction to decode Morse back into readable text.
            </p>
          </div>
        </div>

        <div class="side-links muted">
          <a href="/translate/">Open full translator</a> •
          <a href="/morse-code/punctuation/">Punctuation</a> •
          <a href="/morse-code/numbers/">Numbers</a>
        </div>
      </div>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Common Morse Code Phrases</h2>
      <p class="muted section-note">Popular phrases people search for.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;">
      <a href="/phrases/sos/">SOS</a>
      <a href="/phrases/help/">HELP</a>
      <a href="/phrases/mayday/">MAYDAY</a>
      <a href="/phrases/emergency/">EMERGENCY</a>
      <a href="/phrases/stop/">STOP</a>
      <a href="/phrases/wait/">WAIT</a>
      <a href="/phrases/call-me/">CALL ME</a>
      <a href="/phrases/i-love-you/">I LOVE YOU</a>
    </div>

    <p class="muted" style="margin-top:10px;">
      Browse all phrases in the <a href="/phrases/">phrases section</a>.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Learn Morse Code</h2>
      <p class="muted section-note">Start with basics, then practice.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;">
      <a href="/morse-code/a/">Alphabet (A–Z)</a>
      <a href="/morse-code/numbers/">Numbers (0–9)</a>
      <a href="/morse-code/punctuation/">Punctuation</a>
      <a href="/translate/">Practice in Translator</a>
    </div>

    <p class="muted" style="margin-top: 12px;">
      Practice tip: read Morse visually first, then try listening (dot/dash rhythm) once you recognize patterns.
    </p>
  </section>

  <!-- Reliable runtime script -->
  <script defer src="/mcg-tool.js"></script>

  <style>
    .hero { margin-top: 6px; }
    .hero-inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }

    .hero-kicker {
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
    }

    .hero-title { margin: 0 0 10px; }
    .hero-sub { margin: 0; max-width: 70ch; }
    .hero-note { margin-top: 12px; }

    .hero-actions {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .cta{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
      color: rgba(255,255,255,0.92);
      font-weight: 800;
    }
    .cta:hover { opacity: 0.95; }
    .cta.primary{
      border-color: rgba(138,180,255,0.30);
      background: rgba(138,180,255,0.12);
    }

    .hero-side { padding: 16px; }
    .side-title { margin: 0 0 6px; }
    .side-sub { margin: 0 0 10px; }

    .tool-grid { margin-top: 10px; }
    .tool-row {
      margin-top: 10px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .micro { margin-top: 10px; }

    .side-links { margin-top: 12px; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }
    .section-title { margin: 0; }
    .section-note { margin: 0; }

    @media (min-width: 980px){
      .hero-inner { grid-template-columns: 0.95fr 1.05fr; }
      .hero-actions { max-width: 560px; }
    }

    @media (max-width: 520px){
      .hero-actions .cta { width: 100%; }
    }
  </style>
</Layout>
