---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Fast, Free Morse Translator";
const description =
  "Translate text to Morse code, decode Morse back to plain text, and practice letters, words, and phrases with instant copy tools.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/`;
const robots = "index,follow";

const crumbs = [{ name: "Home", url: canonical }];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="kicker">Free • Fast • Private</p>

