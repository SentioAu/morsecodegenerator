---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – Translate Text to Morse Instantly";
const description =
  "Free online Morse code generator. Convert text to Morse code, decode Morse to text, and copy results instantly.";
---

<Layout title={title} description={description}>
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker muted">Free • Fast • Private</p>

        <h1 class="hero-title">Morse Code Generator</h1>

        <p class="muted hero-sub">
          Translate text to Morse code instantly, decode Morse back to text, and copy results in one click.
          Runs entirely in your browser — no accounts, no logins.
        </p>

        <div class="hero-actions">
          <a class="cta primary" href="/translate/">Open Translator</a>
          <a class="cta" href="/morse-code/a/">Morse Alphabet</a>
          <a class="cta" href="/phrases/">Common Phrases</a>
        </div>

        <div class="hint-row">
          <span class="hint">Letters: separated by spaces</span>
          <span class="hint">Words: separated by “/”</span>
          <a class="hint link" href="/translate/">Practice →</a>
        </div>
      </div>

      <section class="tool card" aria-label="Quick translate">
        <div class="tool-head">
          <div>
            <h2 class="tool-title">Quick translate</h2>
            <p class="muted tool-sub">Type text or Morse, then convert and copy.</p>
          </div>
          <div class="tool-mini-links muted">
            <a href="/morse-code/numbers/">Numbers</a> •
            <a href="/morse-code/punctuation/">Punctuation</a>
          </div>
        </div>

        <div class="grid tool-grid">
          <div>
            <label for="mcg-input"><strong>Input</strong></label><br />
            <textarea
              id="mcg-input"
              rows="8"
              placeholder="Type text (HELLO) or Morse (.... . .-.. .-.. ---) here..."
            ></textarea>

            <div class="tool-row">
              <button id="mcg-text-to-morse" type="button">Text → Morse</button>
              <button id="mcg-morse-to-text" type="button">Morse → Text</button>
              <button id="mcg-copy" type="button">Copy output</button>

              <span class="spacer" aria-hidden="true"></span>

              <button id="mcg-swap" type="button" class="ghost">Swap</button>
              <button id="mcg-clear" type="button" class="ghost">Clear</button>
            </div>

            <p class="muted micro">
              Example: <span class="k">.... . .-.. .-.. --- / .-- --- .-. .-.. -..</span>
            </p>
          </div>

          <div>
            <label for="mcg-output"><strong>Output</strong></label><br />
            <textarea id="mcg-output" rows="8" placeholder="Your result will appear here..."></textarea>

            <p class="muted micro">
              Want a full page? <a href="/translate/">Open the translator</a>.
            </p>
          </div>
        </div>
      </section>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Common Morse Code Phrases</h2>
      <p class="muted section-note">Popular phrases people search for.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;">
      <a href="/phrases/sos/">SOS</a>
      <a href="/phrases/help/">HELP</a>
      <a href="/phrases/mayday/">MAYDAY</a>
      <a href="/phrases/emergency/">EMERGENCY</a>
      <a href="/phrases/stop/">STOP</a>
      <a href="/phrases/wait/">WAIT</a>
      <a href="/phrases/call-me/">CALL ME</a>
      <a href="/phrases/i-love-you/">I LOVE YOU</a>
    </div>

    <p class="muted" style="margin-top:10px;">
      Browse all phrases in the <a href="/phrases/">phrases section</a>.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 class="section-title">Learn Morse Code</h2>
      <p class="muted section-note">Start with basics, then practice.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;">
      <a href="/morse-code/a/">Alphabet (A–Z)</a>
      <a href="/morse-code/numbers/">Numbers (0–9)</a>
      <a href="/morse-code/punctuation/">Punctuation</a>
      <a href="/translate/">Practice in Translator</a>
    </div>

    <p class="muted" style="margin-top: 12px;">
      Practice tip: read Morse visually first, then try listening (dot/dash rhythm) once you recognize patterns.
    </p>
  </section>

  <!-- Runtime tool -->
  <script defer src="/mcg-tool.js"></script>

  <!-- Fix textarea whitespace + add swap/clear UX -->
  <script is:inline>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }

      onReady(() => {
        const input = document.getElementById("mcg-input");
        const output = document.getElementById("mcg-output");
        const swap = document.getElementById("mcg-swap");
        const clear = document.getElementById("mcg-clear");

        // Fix: don't put default text inside <textarea>...</textarea> (whitespace bugs)
        if (input && !input.value.trim()) input.value = "HELLO";

        swap?.addEventListener("click", () => {
          if (!input || !output) return;
          const a = input.value;
          input.value = output.value;
          output.value = a;
          input.focus();
        });

        clear?.addEventListener("click", () => {
          if (!input || !output) return;
          input.value = "";
          output.value = "";
          input.focus();
        });
      });
    })();
  </script>

  <style>
    /* HERO */
    .hero { margin-top: 6px; }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }

    .hero-kicker {
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
    }

    .hero-title { margin: 0 0 10px; }
    .hero-sub { margin: 0; max-width: 70ch; }

    .hero-actions {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .cta{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
      color: rgba(255,255,255,0.92);
      font-weight: 800;
    }
    .cta:hover { opacity: 0.95; }
    .cta.primary{
      border-color: rgba(138,180,255,0.30);
      background: rgba(138,180,255,0.12);
    }

    .hint-row{
      margin-top: 14px;
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      align-items:center;
    }
    .hint{
      display:inline-flex;
      align-items:center;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.78);
      font-size: 13px;
      line-height: 1.2;
    }
    .hint.link{
      border-color: rgba(138,180,255,0.26);
      background: rgba(138,180,255,0.10);
      color: rgba(255,255,255,0.90);
      text-decoration:none;
      font-weight: 750;
    }

    /* TOOL CARD */
    .tool { padding: 16px; }
    .tool-head{
      display:flex;
      flex-wrap:wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px 14px;
      margin-bottom: 10px;
    }
    .tool-title { margin: 0 0 6px; }
    .tool-sub { margin: 0; }

    .tool-mini-links { font-size: 13px; }
    .tool-mini-links a { text-decoration: none; }
    .tool-mini-links a:hover { text-decoration: underline; }

    .tool-grid { margin-top: 10px; }
    .tool-row {
      margin-top: 10px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .spacer { flex: 1; min-width: 8px; }

    .ghost {
      border-color: rgba(255,255,255,0.18) !important;
      background: rgba(255,255,255,0.03) !important;
      font-weight: 650;
    }

    .micro { margin-top: 10px; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }
    .section-title { margin: 0; }
    .section-note { margin: 0; }

    /* BREAKPOINTS */
    @media (min-width: 980px){
      .hero-grid { grid-template-columns: 0.95fr 1.05fr; }
      .hero-actions { max-width: 560px; }
    }

    /* Ensure tool grid is 2-col on desktop widths */
    @media (min-width: 860px){
      .tool-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 520px){
      .hero-actions .cta { width: 100%; }
      .spacer { display:none; }
    }
  </style>
</Layout>
