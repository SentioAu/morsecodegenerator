---
import Layout from "../components/Layout.astro";

const title = "Morse Code Generator – The Hub of Morse Code";
const description =
  "Free Morse code translator, audio practice (Koch + Farnsworth), printable chart, full reference (alphabet, numbers, punctuation, prosigns, Q-codes), and a developer API. The hub of Morse.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/`;
const robots = "index,follow";

const crumbs = [{ name: "Home", url: canonical }];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
    {
      "@type": "HowTo",
      name: "How to translate text to Morse code",
      description: "Convert any text into International Morse code in seconds.",
      totalTime: "PT30S",
      tool: [{ "@type": "HowToTool", name: "MorseCodeGenerator.com translator" }],
      step: [
        { "@type": "HowToStep", name: "Open the translator", url: `${site}/translate/` },
        { "@type": "HowToStep", name: "Type or paste your text into the input box." },
        { "@type": "HowToStep", name: "Tap “Text → Morse” (or wait — auto-detect runs as you type)." },
        { "@type": "HowToStep", name: "Tap Copy or Play to listen at adjustable WPM." },
      ],
    },
    /*
      DataCatalog + Datasets — declares the machine-readable resources
      this site publishes so LLM crawlers, HuggingFace, Kaggle, and any
      research-data discovery tool can surface them. Each dataset
      points at a stable URL (no auth, no rate limit, CC-BY style
      attribution per /ai.txt).
    */
    {
      "@type": "DataCatalog",
      "@id": `${site}#catalog`,
      name: "MorseCodeGenerator.com open data",
      description:
        "Machine-readable Morse code reference data and content maps published by MorseCodeGenerator.com.",
      url: `${site}/`,
      publisher: { "@id": `${site}#org` },
      license: `${site}/ai.txt`,
      inLanguage: "en",
      dataset: [
        {
          "@type": "Dataset",
          "@id": `${site}/morse.json#dataset`,
          name: "International Morse Code reference (morse.json)",
          description:
            "ITU-R M.1677-1 International Morse code mapping for the Latin alphabet, digits, punctuation, prosigns, and common phrases in a single JSON payload.",
          url: `${site}/morse.json`,
          encodingFormat: "application/json",
          isAccessibleForFree: true,
          license: `${site}/ai.txt`,
          creator: { "@id": `${site}#org` },
          keywords: "morse code, ITU-R M.1677-1, alphabet, prosigns, Q-codes, dataset",
          distribution: [
            {
              "@type": "DataDownload",
              encodingFormat: "application/json",
              contentUrl: `${site}/morse.json`,
            },
          ],
        },
        {
          "@type": "Dataset",
          "@id": `${site}/llms.txt#dataset`,
          name: "Site map for LLMs (llms.txt)",
          description:
            "Human-readable index of MorseCodeGenerator.com structured for large-language-model agents, per the llms.txt convention.",
          url: `${site}/llms.txt`,
          encodingFormat: "text/plain",
          isAccessibleForFree: true,
          license: `${site}/ai.txt`,
          creator: { "@id": `${site}#org` },
        },
        {
          "@type": "Dataset",
          "@id": `${site}/llms-full.txt#dataset`,
          name: "Full reference dump for LLMs (llms-full.txt)",
          description:
            "Concatenated plain-text reference of Morse alphabet, prosigns, Q-codes, and history — designed to fit in a single LLM context window.",
          url: `${site}/llms-full.txt`,
          encodingFormat: "text/plain",
          isAccessibleForFree: true,
          license: `${site}/ai.txt`,
          creator: { "@id": `${site}#org` },
        },
      ],
    },
  ],
};

// Toolkit cards with proper SVG icons (Lucide-style line set)
const toolkit = [
  {
    href: "/translate/",
    title: "Translator",
    desc: "Text ⇄ Morse with audio playback, share links, and instant copy.",
    icon: `<path d="M7 17 17 7M7 7h10v10"/>`,
  },
  {
    href: "/decoder/",
    title: "Decoder",
    desc: "Paste dots and dashes — get plain text instantly. Auto-detect.",
    icon: `<path d="M3 12h18"/><path d="M7 7h2v10H7zM13 7h2v10h-2zM18 7h3v10h-3z"/>`,
  },
  {
    href: "/practice/",
    title: "Practice",
    desc: "Koch trainer + single-character quiz with Farnsworth timing.",
    icon: `<path d="M5 3v18l14-9L5 3z"/>`,
  },
  {
    href: "/keyer/",
    title: "Keyer (send)",
    desc: "Tap the spacebar like a straight key — it decodes your fist live.",
    icon: `<path d="M4 14h16M7 14V9a5 5 0 0 1 10 0v5"/><circle cx="12" cy="18" r="2"/>`,
  },
  {
    href: "/daily/",
    title: "Daily challenge",
    desc: "Decode today's word from Morse in six tries. New word daily.",
    icon: `<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/>`,
  },
  {
    href: "/morse-bracelet/",
    title: "Bracelet & tattoo maker",
    desc: "Turn a word into a bead pattern or clean dot-dash art. Free PNG/SVG.",
    icon: `<circle cx="5" cy="12" r="2"/><rect x="9" y="10.5" width="6" height="3" rx="1.5"/><circle cx="19" cy="12" r="2"/>`,
  },
  {
    href: "/chart/",
    title: "Printable chart",
    desc: "Full ITU reference on a single page — print or save as PDF.",
    icon: `<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>`,
  },
  {
    href: "/worksheets/",
    title: "Worksheets",
    desc: "Generate printable practice sheets with an answer key. Free for class.",
    icon: `<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h6M8 13h8M8 17h5"/>`,
  },
  {
    href: "/printables/",
    title: "Printable pack",
    desc: "Free: chart, workbook, flashcards & teacher guide — print or save as PDF.",
    icon: `<path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M14 4v6h6"/>`,
  },
  {
    href: "/prosigns/",
    title: "Prosigns",
    desc: "Procedural signals (SK, AR, BT, KN…) for real CW operating.",
    icon: `<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>`,
  },
  {
    href: "/q-codes/",
    title: "Q-codes",
    desc: "QTH, QSY, QRZ — the operator's shorthand toolkit.",
    icon: `<circle cx="12" cy="12" r="9"/><path d="m15 15 4 4M14 14l-3-3"/>`,
  },
  {
    href: "/abbreviations/",
    title: "CW abbreviations",
    desc: "73, 88, OM, FB, TNX — and what they actually mean.",
    icon: `<path d="M3 5h18M3 12h12M3 19h18"/>`,
  },
  {
    href: "/nato/",
    title: "NATO phonetic",
    desc: "Alpha, Bravo, Charlie… with Morse on the same row.",
    icon: `<path d="M3 21V7l9-4 9 4v14M3 21h18M9 21v-9h6v9"/>`,
  },
  {
    href: "/history/",
    title: "History",
    desc: "From Morse and Vail (1844) to modern CW.",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>`,
  },
  {
    href: "/api/",
    title: "Developer API",
    desc: "Free static JSON endpoint, CORS open, no key required.",
    icon: `<path d="m8 4-4 8 4 8M16 4l4 8-4 8M14 4l-4 16"/>`,
  },
  {
    href: "/embed/",
    title: "Embed widget",
    desc: "Drop the translator on any site with one iframe line.",
    icon: `<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4"/>`,
  },
  {
    href: "/blog/",
    title: "Articles",
    desc: "Long-form: 30-day learning plan, SOS history, comparisons, more.",
    icon: `<path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z"/><path d="M8 8h8M8 12h8M8 16h5"/>`,
  },
  {
    href: "/glossary/",
    title: "Glossary",
    desc: "Every Morse, CW, and ham-radio term defined in plain English.",
    icon: `<path d="M12 6.5V20"/><path d="M4 4h6a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4z"/><path d="M20 4h-6a3 3 0 0 0-3 3v13h6a3 3 0 0 0 3-3V4z"/>`,
  },
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots} alternates={[{ lang: "en", href: `${site}/` }, { lang: "es", href: `${site}/es/` }]}>
  {/* ============== Hero ============== */}
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">·– &nbsp;The hub of Morse code</p>

        <h1 class="hero-title">
          Translate, hear, and learn Morse code — in one focused workspace.
        </h1>

        <p class="hero-sub">
          A complete reference and toolkit: bidirectional translator, audio playback with adjustable
          WPM, Koch-method practice, printable chart, full ITU reference, NATO phonetic, prosigns,
          Q-codes, and a free developer API. Runs in your browser. No account.
        </p>

        <div class="hero-actions">
          <a class="btn primary lg" href="/translate/">
            Open translator
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <a class="btn secondary lg" href="/practice/">Start practicing</a>
        </div>

        <ul class="hero-highlights" aria-label="Highlights">
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Real-time conversion both ways</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5zM19 12c0-2.5-1.5-4.5-3.5-5.5"/><path d="M22 12c0-4.5-2.5-8-6-9.5"/></svg>
            <span>Audio, light flash, and vibration output</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Full ITU‑R M.1677-1 character map</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.5"/><path d="M21 4v5h-5"/></svg>
            <span>Settings & streaks persist locally</span>
          </li>
        </ul>
      </div>

      {/* Inline mini-tool */}
      <aside class="hero-tool" aria-label="Quick translate">
        <div class="hero-tool-head">
          <span class="dot-on" aria-hidden="true"></span>
          <span class="hero-tool-title">Try it</span>
          <span class="hero-tool-meta">runs in browser</span>
        </div>

        <div class="hero-tool-body">
          <label class="field">
            <span class="field-label">Text</span>
            <textarea
              id="mcg-input"
              rows="3"
              placeholder="Type text or Morse here…"
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
              maxlength="2000"
            >HELLO WORLD</textarea>
          </label>

          <div class="hero-tool-row">
            <button id="mcg-text-to-morse" type="button" class="primary-action">Text → Morse</button>
            <button id="mcg-morse-to-text" type="button" class="ghost">Morse → Text</button>
            <button id="mcg-swap" type="button" class="ghost" aria-label="Swap">
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg>
            </button>
            <button id="mcg-clear" type="button" class="ghost" aria-label="Clear">
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            </button>
          </div>

          <label class="field">
            <span class="field-label">Morse</span>
            <textarea
              id="mcg-output"
              rows="3"
              class="mono"
              placeholder="Result appears here…"
              readonly
              spellcheck="false"
            ></textarea>
          </label>

          <div class="hero-tool-foot">
            <button id="mcg-copy" type="button" class="ghost">
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy
            </button>
            <a class="hero-tool-link" href="/translate/">
              Full translator
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {/* ============== Toolkit ============== */}
  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">What's inside</p>
        <h2 class="section-title">A complete Morse toolkit</h2>
      </div>
      <p class="section-sub muted">Everything an operator, learner, or developer needs — in one project.</p>
    </div>

    <div class="toolkit-grid">
      {toolkit.map((t) => (
        <a class="toolkit-card" href={t.href}>
          <span class="toolkit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg>
          </span>
          <span class="toolkit-body">
            <span class="toolkit-title">{t.title}</span>
            <span class="toolkit-desc">{t.desc}</span>
          </span>
          <svg class="toolkit-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      ))}
    </div>
  </section>

  {/* ============== How it works ============== */}
  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">How it works</p>
        <h2 class="section-title">From text to dits and dahs in three steps</h2>
      </div>
      <p class="section-sub muted">Type, convert, copy or play. Same loop on any device.</p>
    </div>

    <ol class="steps">
      <li>
        <span class="step-num">01</span>
        <h3>Paste or type</h3>
        <p class="muted">Plain text or Morse. The tool detects which one and converts the other direction.</p>
      </li>
      <li>
        <span class="step-num">02</span>
        <h3>Tune it</h3>
        <p class="muted">Pick your speed in WPM (10–30), volume, tone — or switch to light flash and vibration on mobile.</p>
      </li>
      <li>
        <span class="step-num">03</span>
        <h3>Copy or share</h3>
        <p class="muted">One-tap copy of the output, or share-link the input — your settings persist locally.</p>
      </li>
    </ol>
  </section>

  {/* ============== Reference launch ============== */}
  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Reference</p>
        <h2 class="section-title">Jump straight into a chart</h2>
      </div>
      <p class="section-sub muted">Bookmark these — they're built to load instantly and stay clean.</p>
    </div>

    <div class="ref-grid">
      <a class="ref-card" href="/morse-code/">
        <h3>Alphabet</h3>
        <p class="muted">A–Z with sound, examples, and per-letter pages.</p>
        <span class="ref-arrow">View →</span>
      </a>
      <a class="ref-card" href="/morse-code/numbers/">
        <h3>Numbers 0–9</h3>
        <p class="muted">Pattern-based digit chart with practice links.</p>
        <span class="ref-arrow">View →</span>
      </a>
      <a class="ref-card" href="/morse-code/punctuation/">
        <h3>Punctuation</h3>
        <p class="muted">Period, comma, ?, !, slash, parens, @ and more.</p>
        <span class="ref-arrow">View →</span>
      </a>
      <a class="ref-card" href="/phrases/">
        <h3>Common phrases</h3>
        <p class="muted">SOS, MAYDAY, HELP, I LOVE YOU — and 50+ more.</p>
        <span class="ref-arrow">View →</span>
      </a>
    </div>
  </section>

  {/* ============== Quick answers ============== */}
  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Quick answers</p>
        <h2 class="section-title">Most-asked Morse code questions</h2>
      </div>
      <p class="section-sub muted">Direct answers with links to learn or translate.</p>
    </div>

    <dl class="qa">
      <div>
        <dt>SOS in Morse code</dt>
        <dd><span class="k">... --- ...</span> &nbsp;·&nbsp; <a href="/translate/?q=SOS">try it</a></dd>
      </div>
      <div>
        <dt>Morse alphabet</dt>
        <dd><a href="/morse-code/">A–Z reference</a> with audio per letter</dd>
      </div>
      <div>
        <dt>Numbers 0–9</dt>
        <dd>Patterns and tips on the <a href="/morse-code/numbers/">numbers page</a></dd>
      </div>
      <div>
        <dt>How fast should I learn?</dt>
        <dd>Use the <a href="/practice/">Koch trainer</a> at 18–20 WPM with Farnsworth timing</dd>
      </div>
    </dl>
  </section>

  {/* Hidden toast for copy feedback */}
  <div id="mcg-toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  {/* Structured data */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  {/* Runtime tool */}
  <script defer src="/mcg-tool.js"></script>

  <script is:inline>
    (function () {
      function onReady(fn) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else fn();
      }
      onReady(function () {
        const output = document.getElementById("mcg-output");
        const copyBtn = document.getElementById("mcg-copy");
        const toast = document.getElementById("mcg-toast");
        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add("show");
          window.clearTimeout(showToast._t);
          showToast._t = window.setTimeout(() => toast.classList.remove("show"), 1600);
        }
        copyBtn?.addEventListener("click", async () => {
          const v = (output?.value || "").trim();
          if (!v) return showToast("Nothing to copy");
          try {
            await navigator.clipboard.writeText(v);
            showToast("Copied");
          } catch {
            showToast("Copy failed");
          }
        });
      });
    })();
  </script>

  <style>
    /* ============== Hero ============== */
    .hero{ padding-top: var(--s-5); }
    .hero-grid{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-6);
      align-items: start;
    }
    @media (min-width: 980px){
      .hero-grid{ grid-template-columns: 1.05fr 0.95fr; gap: var(--s-7); }
    }

    .hero-eyebrow{
      margin: 0 0 var(--s-4);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .hero-title{
      margin: 0 0 var(--s-4);
      font-size: clamp(32px, 5vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.03em;
      max-width: 18ch;
    }
    .hero-sub{
      margin: 0;
      max-width: 56ch;
      color: var(--text-muted);
      font-size: var(--fs-md);
      line-height: 1.6;
    }
    .hero-actions{
      margin-top: var(--s-5);
      display: flex;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .hero-highlights{
      margin: var(--s-6) 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: var(--s-3);
      max-width: 480px;
    }
    .hero-highlights li{
      display: flex;
      align-items: center;
      gap: var(--s-3);
      font-size: var(--fs-sm);
      color: var(--text-muted);
      margin: 0;
    }
    .hero-highlights svg{ color: var(--accent); flex-shrink: 0; }

    /* Inline mini-tool */
    .hero-tool{
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }
    .hero-tool-head{
      display: flex;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-4);
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
      font-size: var(--fs-xs);
      color: var(--text-muted);
    }
    .dot-on{
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--good);
      box-shadow: 0 0 0 3px rgba(34,197,94,0.18);
    }
    .hero-tool-title{ font-weight: 600; color: var(--text); font-family: var(--font-display); font-size: var(--fs-sm); }
    .hero-tool-meta{ margin-left: auto; font-family: var(--font-mono); font-size: 11px; }

    .hero-tool-body{ padding: var(--s-4); display: grid; gap: var(--s-3); }

    .field{ display: grid; gap: var(--s-2); }
    .field-label{
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
      font-weight: 600;
    }
    .field textarea{ min-height: 90px; }

    .hero-tool-row{
      display: flex;
      gap: var(--s-2);
      flex-wrap: wrap;
    }
    .hero-tool-row button{ height: 36px; padding: 0 var(--s-3); font-size: var(--fs-sm); }
    .hero-tool-row .ghost{ width: 36px; padding: 0; }
    .hero-tool-row .primary-action{ flex: 1; min-width: 140px; }

    .hero-tool-foot{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
      padding-top: var(--s-2);
      border-top: 1px dashed var(--line);
    }
    .hero-tool-foot button{ height: 36px; padding: 0 var(--s-3); font-size: var(--fs-sm); }
    .hero-tool-link{
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: var(--fs-sm);
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }
    .hero-tool-link:hover{ text-decoration: underline; }

    /* ============== Toolkit grid ============== */
    .toolkit-grid{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
    @media (min-width: 600px){ .toolkit-grid{ grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 980px){ .toolkit-grid{ grid-template-columns: repeat(3, 1fr); } }

    .toolkit-card{
      display: grid;
      grid-template-columns: 40px 1fr 16px;
      align-items: center;
      gap: var(--s-3);
      padding: var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      color: var(--text);
      text-decoration: none;
      transition: background .15s ease, border-color .15s ease;
    }
    .toolkit-card:hover{
      background: var(--surface-2);
      border-color: var(--line-strong);
      text-decoration: none;
    }
    .toolkit-card:hover .toolkit-arrow{ color: var(--accent); transform: translateX(2px); }
    .toolkit-icon{
      width: 40px; height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--r-md);
      background: var(--accent-soft);
      color: var(--accent);
    }
    .toolkit-body{ display: grid; gap: 2px; min-width: 0; }
    .toolkit-title{ font-weight: 600; font-size: var(--fs-base); color: var(--text); font-family: var(--font-display); }
    .toolkit-desc{ font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.45; }
    .toolkit-arrow{ color: var(--text-subtle); transition: color .15s ease, transform .15s ease; flex-shrink: 0; }

    /* ============== Steps ============== */
    .steps{
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    @media (min-width: 760px){ .steps{ grid-template-columns: repeat(3, 1fr); } }
    .steps li{
      margin: 0;
      padding: var(--s-5);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
    }
    .step-num{
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.05em;
      color: var(--accent);
      margin-bottom: var(--s-3);
    }
    .steps h3{ margin: 0 0 var(--s-2); font-size: var(--fs-md); }
    .steps p{ margin: 0; font-size: var(--fs-sm); }

    /* ============== Reference grid ============== */
    .ref-grid{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    @media (min-width: 600px){ .ref-grid{ grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 980px){ .ref-grid{ grid-template-columns: repeat(4, 1fr); } }

    .ref-card{
      display: block;
      padding: var(--s-5);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      color: var(--text);
      text-decoration: none;
      transition: border-color .15s ease, background .15s ease;
    }
    .ref-card:hover{ border-color: var(--accent-line); background: var(--surface-2); text-decoration: none; }
    .ref-card h3{ margin: 0 0 var(--s-2); font-size: var(--fs-md); }
    .ref-card p{ margin: 0 0 var(--s-3); font-size: var(--fs-sm); color: var(--text-muted); }
    .ref-arrow{
      font-size: var(--fs-sm);
      color: var(--accent);
      font-weight: 500;
    }

    /* ============== Q&A ============== */
    .qa{
      margin: 0;
      display: grid;
      gap: 0;
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      overflow: hidden;
      background: var(--surface);
    }
    .qa > div{
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      padding: var(--s-4);
      border-bottom: 1px solid var(--line);
    }
    .qa > div:last-child{ border-bottom: 0; }
    @media (min-width: 760px){
      .qa > div{ grid-template-columns: 220px 1fr; gap: var(--s-5); align-items: baseline; }
    }
    .qa dt{ font-weight: 600; color: var(--text); font-size: var(--fs-sm); margin: 0; }
    .qa dd{ margin: 0; font-size: var(--fs-sm); color: var(--text-muted); }
    .qa a{ color: var(--accent); }

    /* ============== Toast ============== */
    .toast{
      position: fixed;
      left: 50%;
      bottom: var(--s-5);
      transform: translateX(-50%) translateY(8px);
      max-width: min(420px, calc(100vw - 32px));
      padding: var(--s-2) var(--s-4);
      border-radius: var(--r-pill);
      background: var(--text);
      color: var(--bg);
      font-size: var(--fs-sm);
      font-weight: 600;
      opacity: 0;
      pointer-events: none;
      transition: opacity .14s ease, transform .14s ease;
      z-index: 50;
      box-shadow: var(--shadow-md);
    }
    .toast.show{ opacity: 1; transform: translateX(-50%) translateY(0); }

    @media (max-width: 520px){
      .hero-actions .btn{ flex: 1; justify-content: center; }
    }
  </style>
</Layout>
