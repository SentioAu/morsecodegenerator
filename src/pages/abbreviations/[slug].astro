---
import Layout from "../../components/Layout.astro";
import { abbrs } from "../../data/cw-abbreviations.js";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

export function getStaticPaths() {
  return abbrs.map((a, i) => ({
    params: { slug: a.slug },
    props: {
      a,
      prev: i > 0 ? abbrs[i - 1] : null,
      next: i < abbrs.length - 1 ? abbrs[i + 1] : null,
    },
  }));
}

const { a, prev, next } = Astro.props;

const site = String(
  Astro.site ?? import.meta.env.SITE ?? "https://morsecodegenerator.com"
).replace(/\/$/, "");

const canonical = `${site}/abbreviations/${a.slug}/`;
const robots = "index,follow";

// Render the abbreviation in Morse so the page can show the rhythm
// pattern. Strip trailing "?" before encoding — it's an interrogative
// marker, not part of the abbreviation's Morse identity.
const rawMap = data?.morseMap ?? {};
const morseMap = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);
const codeForMorse = a.code.replace(/[?\s]/g, "");
const morse = textToMorse(codeForMorse, morseMap, " ");

// ---------------------------------------------------------------------
// "What it saves you" — the reason CW abbreviations exist at all.
//
// These pages were the second-thinnest cluster on the site (28 of 30 under
// 200 words). Rather than pad them, this computes the thing the page is
// actually about: sending "73" instead of "BEST REGARDS" is the entire
// point, so show the airtime saved. Everything is derived from morse.json
// using the site-wide timing convention (CLAUDE.md §11): dit 1 unit, dah 3,
// intra-character gap 1, letter gap 3, word gap 7, unit = 1200/wpm ms.
// ---------------------------------------------------------------------
function unitsFor(text) {
  const words = String(text).toUpperCase().split(/\s+/).filter(Boolean);
  let units = 0;
  words.forEach((word, wi) => {
    const chars = word.split("").map((ch) => morseMap[ch]).filter(Boolean);
    chars.forEach((code, ci) => {
      const syms = code.split("");
      syms.forEach((sym, si) => {
        units += sym === "-" ? 3 : 1;
        if (si < syms.length - 1) units += 1;
      });
      if (ci < chars.length - 1) units += 3;
    });
    if (wi < words.length - 1) units += 7;
  });
  return units;
}

// Compare the abbreviation against the plain-English phrase it replaces.
// Strip any trailing parenthetical gloss so we time the phrase, not the note.
const spelledOut = String(a.meaning).replace(/\s*\([^)]*\)\s*/g, " ").trim();
const shortUnits = unitsFor(codeForMorse);
const longUnits = unitsFor(spelledOut);
const savesUnits = longUnits - shortUnits;
const savesPct = longUnits > 0 ? Math.round((savesUnits / longUnits) * 100) : 0;
const secsAt = (units, wpm) => (units * (1200 / wpm)) / 1000;
const showSaving = savesUnits > 0 && spelledOut.length > a.code.length;

const title = `${a.code} in Morse code – ${a.meaning}`;
// Extended to use the SERP snippet properly (28 of 30 were flagged too
// short) and to surface the airtime comparison these pages now carry.
// Length-aware so a long `summary` can't push it past ~158 characters.
const description = (() => {
  const base = `${a.code} in Morse code — ${a.summary}`.replace(/\s+/g, " ").trim();
  // Longest tail that still fits. Picking from a ladder (rather than
  // truncating) keeps every description a complete sentence.
  const tails = [
    " With on-air examples, and how much keying time it saves over spelling it out.",
    " With on-air examples and the keying time it saves.",
    " With on-air examples.",
    "",
  ];
  const tail = tails.find((t) => (base + t).length <= 158) ?? "";
  return base + tail;
})();
const keywords = `${a.code}, ${a.slug} cw abbreviation, ${a.meaning.toLowerCase()}, ham radio ${a.code}, morse code ${a.code}`;

const related = abbrs
  .filter((r) => r.slug !== a.slug && r.tags?.some((t) => a.tags?.includes(t)))
  .slice(0, 4);

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Abbreviations", url: `${site}/abbreviations/` },
  { name: a.code, url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "DefinedTerm",
      "@id": canonical + "#term",
      name: a.code,
      description: a.summary,
      url: canonical,
      inDefinedTermSet: `${site}/abbreviations/#index`,
      inLanguage: "en",
    },
    {
      "@type": "Article",
      headline: title,
      description,
      url: canonical,
      author: { "@type": "Organization", name: "MorseCodeGenerator.com" },
      publisher: { "@id": `${site}#org` },
      mainEntityOfPage: canonical,
      keywords,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: `What does ${a.code} mean in CW Morse code?`,
          acceptedAnswer: { "@type": "Answer", text: a.summary },
        },
        {
          "@type": "Question",
          name: `When is ${a.code} used on the air?`,
          acceptedAnswer: { "@type": "Answer", text: a.context },
        },
      ],
    },
  ],
};

const prevUrl = prev ? `${site}/abbreviations/${prev.slug}/` : undefined;
const nextUrl = next ? `${site}/abbreviations/${next.slug}/` : undefined;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  robots={robots}
  keywords={keywords}
  ogType="article"
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/abbreviations/">Abbreviations</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">{a.code}</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">CW abbreviation · {a.group}</p>
    <h1 class="page-hero-title">{a.code} in Morse code</h1>
    <p class="muted page-hero-sub">{a.summary}</p>
    <div class="page-hero-actions">
      <a class="btn primary" href={`/translate/?q=${encodeURIComponent(codeForMorse)}`}>Play {a.code} in the translator</a>
      <a class="btn secondary" href="/abbreviations/">All abbreviations</a>
    </div>
  </header>

  <section class="card ab-card">
    <h2 class="ab-h">Morse rendering</h2>
    <p class="ab-morse" aria-label={`Morse rendering of ${a.code}`}>{morse}</p>
    <p class="muted micro">Sent letter-by-letter with standard inter-letter gaps.</p>
  </section>

  {showSaving && (
    <section class="card ab-card">
      <h2 class="ab-h">What it saves you on the air</h2>
      <p class="ab-line">
        This is the whole reason CW abbreviations exist. Sending
        <strong class="k"> {a.code} </strong> instead of spelling out
        “{spelledOut}” cuts <strong>{savesPct}%</strong> of the airtime —
        {" "}{savesUnits} dot-units of keying saved every time you send it.
      </p>
      <div class="tablewrap">
        <table>
          <thead>
            <tr><th>Speed</th><th class="k">{a.code}</th><th>“{spelledOut}”</th><th>Saved</th></tr>
          </thead>
          <tbody>
            {[13, 20, 25].map((wpm) => (
              <tr>
                <td><strong>{wpm} WPM</strong></td>
                <td>{secsAt(shortUnits, wpm).toFixed(1)}s</td>
                <td>{secsAt(longUnits, wpm).toFixed(1)}s</td>
                <td><strong>{secsAt(savesUnits, wpm).toFixed(1)}s</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted micro">
        Timed with standard spacing: dit 1 unit, dah 3, letter gap 3, word gap 7.
        Work out any other speed on the <a href="/timing-calculator/">timing calculator</a>.
      </p>
    </section>
  )}

  <section class="card ab-card">
    <h2 class="ab-h">Meaning</h2>
    <p class="ab-line"><strong class="k">{a.code}</strong> — {a.meaning}</p>
  </section>

  <section class="card soft ab-card">
    <h2 class="ab-h">When this is used</h2>
    <p>{a.context}</p>
  </section>

  <section class="card ab-card">
    <h2 class="ab-h">Examples</h2>
    <table class="ab-table">
      <thead>
        <tr><th>On the air</th><th>Plain English</th></tr>
      </thead>
      <tbody>
        {a.examples.map(([usage, plain]) => (
          <tr>
            <td><strong class="k">{usage}</strong></td>
            <td class="muted">{plain}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="page-hero-kicker">Keep reading</p>
          <h2 class="section-title">Related abbreviations</h2>
        </div>
      </div>
      <div class="pill-grid">
        {related.map((r) => (
          <a href={`/abbreviations/${r.slug}/`}>{r.code} — {r.meaning}</a>
        ))}
      </div>
    </section>
  )}

  <nav class="ab-nav" aria-label="Adjacent abbreviations">
    {prev ? (
      <a class="ab-nav-link prev" href={`/abbreviations/${prev.slug}/`} rel="prev">
        <span class="ab-nav-dir">← Previous</span>
        <span class="ab-nav-label">{prev.code}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="ab-nav-link next" href={`/abbreviations/${next.slug}/`} rel="next">
        <span class="ab-nav-dir">Next →</span>
        <span class="ab-nav-label">{next.code}</span>
      </a>
    ) : <span></span>}
  </nav>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .ab-card{ margin-top: var(--s-4); }
    .ab-h{ margin-top: 0; }
    .ab-morse{
      font-family: var(--font-mono);
      font-size: var(--fs-2xl);
      letter-spacing: 0.12em;
      color: var(--accent);
      margin: var(--s-3) 0 var(--s-2);
      word-break: break-all;
    }
    .ab-line{ font-size: var(--fs-md); margin: 0; }
    .ab-line .k{ color: var(--accent); margin-right: var(--s-2); }
    .ab-table{ margin-top: var(--s-3); }

    .ab-nav{
      display: flex;
      justify-content: space-between;
      align-items: stretch;
      gap: var(--s-3);
      margin-top: var(--s-6);
    }
    .ab-nav-link{
      flex: 0 1 240px;
      display: grid;
      gap: var(--s-1);
      padding: var(--s-3) var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--text);
      text-decoration: none;
    }
    .ab-nav-link.next{ text-align: right; }
    .ab-nav-link:hover{ background: var(--surface-2); border-color: var(--accent-line); }
    .ab-nav-dir{
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--text-subtle);
      letter-spacing: 0.05em;
    }
    .ab-nav-label{
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--text);
    }
  </style>
</Layout>
