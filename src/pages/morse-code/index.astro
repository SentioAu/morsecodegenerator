---
import Layout from "../../components/Layout.astro";

const title = "Learn Morse Code – Alphabet, Numbers, Punctuation";
const description =
  "Learn Morse code step-by-step with clean reference pages: alphabet (A–Z), numbers (0–9), and punctuation. Practice instantly with the translator.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/morse-code/`;
const robots = "index,follow";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Learn Morse Code",
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
  hasPart: [
    { "@type": "WebPage", name: "Morse Code Alphabet (A–Z)", url: `${site}/morse-code/a/` },
    { "@type": "WebPage", name: "Morse Code Numbers (0–9)", url: `${site}/morse-code/numbers/` },
    { "@type": "WebPage", name: "Morse Code Punctuation", url: `${site}/morse-code/punctuation/` },
    { "@type": "WebPage", name: "Morse Code Words", url: `${site}/morse-code/words/` },
    { "@type": "WebPage", name: "Text to Morse Translator", url: `${site}/translate/` },
    { "@type": "WebPage", name: "Common Morse Code Phrases", url: `${site}/phrases/` },
  ],
};

// A tiny “starter set” shown on the hub page (not the full alphabet).
const starter = [
  ["E", "."],
  ["T", "-"],
  ["A", ".-"],
  ["N", "-."],
  ["I", ".."],
  ["M", "--"],
  ["S", "..."],
  ["O", "---"],
];

const popular = [
  { label: "SOS", href: "/phrases/sos/" },
  { label: "HELP", href: "/phrases/help/" },
  { label: "MAYDAY", href: "/phrases/mayday/" },
  { label: "HELLO", href: "/phrases/hello/" },
  { label: "I LOVE YOU", href: "/phrases/i-love-you/" },
  { label: "THANK YOU", href: "/phrases/thank-you/" },
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots} alternates={[{ lang: "en", href: `${site}/morse-code/` }, { lang: "es", href: `${site}/es/alfabeto-morse/` }]}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Learn</span>
  </nav>

  <header class="hero">
    <p class="muted kicker">Learn • Memorize • Practice</p>
    <h1 class="title">Learn Morse Code</h1>
    <p class="muted sub">
      Use the clean reference pages for <strong>alphabet</strong>, <strong>numbers</strong>, <strong>punctuation</strong>,
      and <strong>words</strong>, then practice instantly in the translator.
    </p>

    <div class="actions">
      <a class="btn primary" href="/translate/">Practice in Translator</a>
      <a class="btn" href="/phrases/">Practice common phrases</a>
      <a class="btn" href="/">Back to home</a>
    </div>

    <div class="chips" aria-label="Formatting rules">
      <span class="chip">Letters: spaces</span>
      <span class="chip">Words: “/”</span>
      <span class="chip muted">Example: <span class="k">HELLO</span> → <span class="k">.... . .-.. .-.. ---</span></span>
    </div>
  </header>

  <section class="card">
    <div class="section-head">
      <h2>Reference pages</h2>
      <p class="muted">Bookmark these — they’re built to be clean and fast.</p>
    </div>

    <div class="pill-grid">
      <a href="/morse-code/a/">Alphabet (A–Z)</a>
      <a href="/morse-code/numbers/">Numbers (0–9)</a>
      <a href="/morse-code/punctuation/">Punctuation</a>
      <a href="/morse-code/words/">Words</a>
      <a href="/translate/">Translator</a>
    </div>

    <p class="muted">
      Want real-world practice? Try the <a href="/phrases/">phrases section</a> (SOS, HELP, MAYDAY, and more).
    </p>
  </section>

  <section class="card">
    <h2>Fast start (the 8 symbols to learn first)</h2>
    <p class="muted">
      Don’t memorize the whole alphabet at once. Start with the simplest patterns, then expand outward.
    </p>

    <div class="starter">
      {starter.map(([ch, code]) => (
        <div class="starter-item">
          <div class="starter-ch">{ch}</div>
          <div class="starter-code k">{code}</div>
          <a
            class="starter-link"
            href={`/morse-code/${String(ch).toLowerCase()}/`}
            aria-label={`Learn ${ch} in Morse`}
          >
            View →
          </a>
        </div>
      ))}
    </div>

    <p class="muted">
      Tip: practice these inside the translator:
      <a href="/translate/?q=E%20T%20A%20N">E T A N</a> •
      <a href="/translate/?q=SOS">SOS</a> •
      <a href="/translate/?q=IM%20SAFE">IM SAFE</a>
    </p>
  </section>

  <section class="card">
    <div class="section-head">
      <h2>Popular pages</h2>
      <p class="muted">Quick jumps people actually use.</p>
    </div>

    <div class="pill-grid">
      {popular.map((x) => (
        <a href={x.href}>{x.label}</a>
      ))}
    </div>
  </section>

  <section class="card">
    <h2>Next steps (what to learn after the starter set)</h2>
    <p class="muted">
      Once you know the starter set, expand into numbers, punctuation, and real words.
    </p>

    <div class="pill-grid">
      <a href="/morse-code/a/">Continue the alphabet</a>
      <a href="/morse-code/numbers/">Learn numbers</a>
      <a href="/morse-code/punctuation/">Learn punctuation</a>
      <a href="/morse-code/words/">Practice words A–Z</a>
      <a href="/phrases/">Practice phrases</a>
      <a href="/translate/">Test yourself in translator</a>
    </div>
  </section>

  <section class="card">
    <h2>A simple practice plan (5 minutes)</h2>
    <ol>
      <li>Pick <strong>3–5 letters</strong> from the alphabet page.</li>
      <li>Type them as a word in the translator (example: <span class="k">E T A N</span>).</li>
      <li>Copy the Morse output and try to read it back without looking.</li>
      <li>Repeat daily — short sessions beat long sessions.</li>
    </ol>
  </section>

  <section class="card faq-block">
    <h2>FAQ</h2>

    <h3>How are letters and words separated?</h3>
    <p class="muted">
      Letters are separated by spaces. Words are separated with “/”.
    </p>

    <h3>Should I learn by sound or by sight?</h3>
    <p class="muted">
      Both help, but rhythm (sound patterns) tends to stick faster than counting dots and dashes.
    </p>

    <h3>What should I learn first?</h3>
    <p class="muted">
      Start with simple ones: <span class="k">E</span>, <span class="k">T</span>, then <span class="k">A</span>, <span class="k">N</span>, <span class="k">I</span>, <span class="k">M</span>.
      Then expand into <span class="k">S</span> and <span class="k">O</span>.
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .hero{ margin: var(--s-3) 0 var(--s-5); }
    .kicker{
      margin: 0 0 var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .title{ margin: 0 0 var(--s-3); font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.025em; }
    .sub{ margin: 0; max-width: 60ch; color: var(--text-muted); }

    .actions{ margin-top: var(--s-5); display: flex; gap: var(--s-2); flex-wrap: wrap; }
    .chips{ margin-top: var(--s-4); display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }

    .section-head{
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-4);
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: var(--s-4);
    }

    /* Starter set: 8 quick-look cards */
    .starter{
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-2);
    }
    @media (min-width: 720px){ .starter{ grid-template-columns: repeat(4, 1fr); } }

    .starter-item{
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      transition: background .12s ease, border-color .12s ease;
    }
    .starter-item:hover{ background: var(--surface-2); border-color: var(--line-strong); }
    .starter-ch{
      font-family: var(--font-display);
      font-weight: 700;
      font-size: var(--fs-xl);
      color: var(--text);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .starter-code{
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }
    .starter-link{
      margin-top: auto;
      align-self: flex-start;
      font-size: var(--fs-xs);
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }
    .starter-link:hover{ text-decoration: underline; }

    @media (max-width: 600px){
      .actions .btn{ flex: 1; min-width: 140px; }
    }
  </style>
</Layout>
