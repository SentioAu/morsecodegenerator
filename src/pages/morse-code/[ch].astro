---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// -------------------------------------------------------------------
// getStaticPaths (MUST be self-contained and not rely on outer helpers)
// -------------------------------------------------------------------
export function getStaticPaths() {
  const rawMap = data && data.morseMap ? data.morseMap : {};
  const map = Object.fromEntries(
    Object.entries(rawMap)
      .filter(([k, v]) => k && v && k !== " ")
      .map(([k, v]) => [String(k).toUpperCase(), String(v)])
  );

  const weight = (x) => (/^[A-Z]$/.test(x) ? 0 : 1);

  const chars = Object.keys(map)
    .filter((k) => k && String(k).length === 1)
    .map((k) => String(k).toUpperCase())
    .filter((k) => /^[A-Z0-9]$/.test(k))
    .sort((a, b) => {
      const wa = weight(a);
      const wb = weight(b);
      if (wa !== wb) return wa - wb;
      return a.localeCompare(b, "en");
    });

  return chars.map((CH, i) => ({
    params: { ch: CH.toLowerCase() },
    props: {
      ch: CH,
      prev: i > 0 ? chars[i - 1] : null,
      next: i < chars.length - 1 ? chars[i + 1] : null,
    },
  }));
}

// -------------------------------------------------------------------
// Page runtime
// -------------------------------------------------------------------
const { ch, prev, next } = Astro.props;

// Prefer Astro.site, otherwise import.meta.env.SITE, otherwise hard fallback
const site = String(
  Astro.site ?? import.meta.env.SITE ?? "https://morsecodegenerator.com"
).replace(/\/$/, "");

const CH = String(ch ?? "").toUpperCase();

// Normalize map for rendering
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

const code = map[CH] ?? "";

const isLetter = /^[A-Z]$/.test(CH);
const isNumber = /^[0-9]$/.test(CH);

// Title/description (SEO)
const title = code ? `${CH} in Morse Code (${code})` : `${CH} in Morse Code`;
const description = code
  ? `Learn how to write ${CH} in Morse code (${code}). Copy it, listen to it, and practice with examples.`
  : `Learn how to write ${CH} in Morse code. Copy it, listen to it, and practice with examples.`;

// Canonical (Layout uses trailingSlash:"always")
const canonical = `${site}/morse-code/${CH.toLowerCase()}/`;

// Robots (prevents indexing broken/empty pages)
const robots = code ? "index,follow" : "noindex,follow";

const translatorHref = `/translate/?q=${encodeURIComponent(CH)}`;

const tips = (() => {
  if (!code) return [];
  const dots = (code.match(/\./g) || []).length;
  const dashes = (code.match(/-/g) || []).length;
  const len = dots + dashes;
  return [
    `${len} signals (${dots} dot${dots === 1 ? "" : "s"}, ${dashes} dash${
      dashes === 1 ? "" : "es"
    })`,
    "Dots are short • dashes are long",
    "Letters use spaces • words use “/”",
  ];
})();

const examples = isLetter
  ? [`${CH}`, `${CH}A`, `A${CH}`, `${CH}E`, `E${CH}`, `SOS`]
  : isNumber
  ? [`${CH}`, `${CH}0`, `1${CH}`, `${CH}${CH}`, `2026`, `SOS`]
  : [`${CH}`, `SOS`, `HELLO`];

const examplesMorse = examples.map((t) => ({
  text: t,
  morse: textToMorse(t, map, " "),
  href: `/translate/?q=${encodeURIComponent(t)}`,
}));

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Learn", url: `${site}/morse-code/` },
  { name: CH, url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};

// A small internal-link set (high-intent pages)
const practiceLinks = [
  { label: "Translator", href: "/translate/" },
  { label: "Words", href: "/morse-code/words/" },
  { label: "Punctuation", href: "/morse-code/punctuation/" },
  { label: "Phrases", href: "/phrases/" },
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/morse-code/">Learn</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">{CH}</span>
  </nav>

  <header class="hero">
    <p class="muted kicker">{isLetter ? "Alphabet" : isNumber ? "Numbers" : "Reference"}</p>
    <h1 class="title">{CH} in Morse code</h1>

    <p class="muted" style="margin-top:0; max-width:72ch;">
      {code ? (
        <>Below is the standard Morse code for <strong>{CH}</strong>. Copy it, listen to it, and practice with real examples.</>
      ) : (
        <>This character isn’t available in the current Morse map.</>
      )}
    </p>

    <div class="code-row">
      <span class="badge">{CH}</span>
      <span class="muted">→</span>
      <span class="badge badge-code k">{code || "—"}</span>
    </div>

    {code ? (
      <div class="chips" aria-label="Quick tips">
        {tips.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    ) : null}

    <div class="actions">
      <button id="copy" type="button" disabled={!code}>Copy</button>
      <button id="listen" type="button" class="ghost" disabled={!code}>Listen</button>
      <a class="btn" href={translatorHref}>Practice in translator</a>
      <a class="btn ghost" href="/morse-code/">Back to Learn hub</a>
    </div>

    <div class="pill-grid" style="margin-top:12px;" role="list" aria-label="Quick navigation">
      {practiceLinks.map((x) => (
        <a role="listitem" href={x.href}>{x.label}</a>
      ))}
    </div>

    <!-- Accessible toast (used by Copy/Listen) -->
    <div id="toast" class="toast" aria-live="polite" aria-atomic="true"></div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Practice examples</h2>
      <p class="muted" style="margin:0;">Click any example to practice instantly.</p>
    </div>

    <div class="ex-grid" style="margin-top:12px;">
      {examplesMorse.map((ex) => (
        <a class="ex" href={ex.href}>
          <div class="ex-text">{ex.text}</div>
          <div class="ex-morse k">{ex.morse}</div>
        </a>
      ))}
    </div>

    <p class="muted" style="margin-top:12px;">
      Tip: stop “counting” dots/dashes. With repetition, you recognize patterns as shapes/rhythm.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">Navigate</h2>

    <p class="muted" style="margin-top:0;">
      {prev ? <>Previous: <a href={`/morse-code/${String(prev).toLowerCase()}/`}>{prev}</a></> : <>Previous: —</>}
      {" • "}
      {next ? <>Next: <a href={`/morse-code/${String(next).toLowerCase()}/`}>{next}</a></> : <>Next: —</>}
    </p>

    <p class="muted" style="margin-top:10px;">
      Browse:
      <a href="/morse-code/a/"> alphabet</a> •
      <a href="/morse-code/numbers/"> numbers</a> •
      <a href="/morse-code/punctuation/"> punctuation</a> •
      <a href="/morse-code/words/"> words</a> •
      <a href="/phrases/"> phrases</a>
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>

    <h3 style="margin-bottom:6px;">How do I separate letters and words?</h3>
    <p class="muted" style="margin-top:0;">
      Letters are separated by spaces. Words are separated by <span class="k">/</span>.
      Example: <span class="k">HELLO</span> → <span class="k">.... . .-.. .-.. ---</span>.
    </p>

    <h3 style="margin-bottom:6px;">Can I practice {CH} in the translator?</h3>
    <p class="muted" style="margin-top:0;">
      Yes — open <a href={translatorHref}>the translator</a> with {CH} prefilled.
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline define:vars={{ code }}>
    (function () {
      const copyBtn = document.getElementById("copy");
      const listenBtn = document.getElementById("listen");
      const toastEl = document.getElementById("toast");

      const reducedMotion =
        typeof window !== "undefined" &&
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let toastTimer = null;
      function toast(msg) {
        if (!toastEl) return;
        toastEl.textContent = String(msg || "");
        toastEl.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.remove("show"), reducedMotion ? 600 : 1200);
      }

      async function copyText(text) {
        const t = String(text || "");
        try {
          await navigator.clipboard.writeText(t);
          return true;
        } catch {
          try {
            const ta = document.createElement("textarea");
            ta.value = t;
            ta.setAttribute("readonly", "true");
            ta.style.position = "fixed";
            ta.style.top = "-9999px";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return !!ok;
          } catch {
            return false;
          }
        }
      }

      copyBtn?.addEventListener("click", async () => {
        const value = String(code || "");
        if (!value) return;
        const ok = await copyText(value);
        toast(ok ? "Copied ✓" : "Copy failed");
      });

      function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }

      // --- Audio playback (dot/dash) ---
      let playing = false;
      let stopFlag = false;

      listenBtn?.addEventListener("click", async () => {
        const value = String(code || "");
        if (!value) return;

        // Toggle stop if already playing
        if (playing) {
          stopFlag = true;
          toast("Stopping…");
          return;
        }

        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) {
          toast("Audio not supported");
          return;
        }

        playing = true;
        stopFlag = false;

        const oldText = listenBtn.textContent;
        listenBtn.textContent = "Stop";
        listenBtn.classList.add("danger");

        const unit = 90; // ms
        const freq = 700;

        const ctx = new Ctx();

        try {
          // iOS/Safari often starts suspended; must resume on gesture
          if (ctx.state === "suspended") await ctx.resume();
        } catch {}

        const master = ctx.createGain();
        master.connect(ctx.destination);

        // default volume
        const volume = 0.06;
        master.gain.setValueAtTime(0.0001, ctx.currentTime);

        function startBeep(durationMs) {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.value = freq;

          // small attack/release to reduce clicks
          const now = ctx.currentTime;
          const dur = durationMs / 1000;

          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(1.0, now + 0.008);
          gain.gain.setValueAtTime(1.0, now + Math.max(0.008, dur - 0.02));
          gain.gain.linearRampToValueAtTime(0.0001, now + dur);

          osc.connect(gain);
          gain.connect(master);

          osc.start(now);
          osc.stop(now + dur + 0.01);
          return osc;
        }

        async function play() {
          toast("Playing…");
          for (const s of value) {
            if (stopFlag) break;

            if (s === ".") {
              startBeep(unit);
              await sleep(unit);
              await sleep(unit); // intra-symbol gap
            } else if (s === "-") {
              startBeep(unit * 3);
              await sleep(unit * 3);
              await sleep(unit);
            } else {
              // spacing / unknown
              await sleep(unit * 2);
            }
          }
        }

        try {
          // set master volume after resume (some browsers ignore before resume)
          master.gain.setValueAtTime(volume, ctx.currentTime);
          await play();
        } catch {
          // ignore
        }

        try { await ctx.close(); } catch {}

        // reset UI
        playing = false;
        stopFlag = false;

        listenBtn.textContent = oldText;
        listenBtn.classList.remove("danger");
        toast("Done ✓");
      });
    })();
  </script>

  <style>
    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size:13px;
      opacity:.92;
      margin-top:2px;
    }
    .crumb{
      text-decoration:none;
      border:1px solid rgba(255,255,255,0.12);
      background:rgba(255,255,255,0.02);
      padding:6px 10px;
      border-radius:999px;
      color:rgba(255,255,255,0.92);
    }
    .sep{ opacity:.65; }
    .crumb-current{
      display:inline-flex;
      align-items:center;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,0.10);
      background:rgba(255,255,255,0.015);
      color:rgba(255,255,255,0.78);
    }

    .hero{ margin-top:10px; }
    .kicker{
      margin:0 0 10px;
      letter-spacing:.08em;
      text-transform:uppercase;
      font-size:12px;
    }
    .title{ margin:0 0 10px; }

    .code-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
      margin-top:10px;
    }
    .badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,0.14);
      background:rgba(255,255,255,0.02);
      color:rgba(255,255,255,0.92);
      font-weight:800;
    }
    .badge-code{ font-weight:700; letter-spacing:.4px; }

    .chips{
      margin-top:12px;
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      align-items:center;
    }

    .actions{
      margin-top:14px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap:6px 14px;
      align-items:baseline;
      justify-content:space-between;
    }

    .ex-grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:10px;
    }
    @media (min-width: 900px){
      .ex-grid{ grid-template-columns:repeat(3, minmax(0,1fr)); }
    }

    .ex{
      text-decoration:none;
      border:1px solid rgba(255,255,255,0.11);
      background:rgba(255,255,255,0.02);
      border-radius:16px;
      padding:12px;
      display:flex;
      flex-direction:column;
      gap:8px;
      color:rgba(255,255,255,0.92);
    }
    .ex:hover{
      border-color:rgba(255,255,255,0.18);
      background:rgba(255,255,255,0.04);
    }
    .ex-text{ font-weight:850; }
    .ex-morse{ opacity:.92; font-size:14px; }

    /* toast */
    .toast{
      position: fixed;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%) translateY(10px);
      opacity: 0;
      pointer-events: none;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(0,0,0,0.72);
      color: rgba(255,255,255,0.92);
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      transition: opacity .16s ease, transform .16s ease;
      z-index: 999;
      max-width: calc(100vw - 28px);
      text-align: center;
    }
    .toast.show{
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* stop state */
    button.danger{
      border-color: rgba(255,255,255,0.24) !important;
      background: rgba(255,255,255,0.06) !important;
    }

    @media (max-width: 600px){
      .actions > *{ width:100%; justify-content:center; }
    }
  </style>
</Layout>
