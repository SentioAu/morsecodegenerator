---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// -------------------------------------------------------------------
// getStaticPaths (MUST be self-contained and not rely on outer helpers)
// -------------------------------------------------------------------
export function getStaticPaths() {
  const rawMap = data && data.morseMap ? data.morseMap : {};
  const map = Object.fromEntries(
    Object.entries(rawMap)
      .filter(([k, v]) => k && v && k !== " ")
      .map(([k, v]) => [String(k).toUpperCase(), String(v)])
  );

  const weight = (x) => (/^[A-Z]$/.test(x) ? 0 : 1);

  const chars = Object.keys(map)
    .filter((k) => k && String(k).length === 1)
    .map((k) => String(k).toUpperCase())
    .filter((k) => /^[A-Z0-9]$/.test(k))
    .sort((a, b) => {
      const wa = weight(a);
      const wb = weight(b);
      if (wa !== wb) return wa - wb;
      return a.localeCompare(b, "en");
    });

  return chars.map((CH, i) => ({
    params: { ch: CH.toLowerCase() },
    props: {
      ch: CH,
      prev: i > 0 ? chars[i - 1] : null,
      next: i < chars.length - 1 ? chars[i + 1] : null,
    },
  }));
}

// -------------------------------------------------------------------
// Page runtime
// -------------------------------------------------------------------
const { ch, prev, next } = Astro.props;

// Prefer Astro.site, otherwise import.meta.env.SITE, otherwise hard fallback
const site = String(
  Astro.site ?? import.meta.env.SITE ?? "https://morsecodegenerator.com"
).replace(/\/$/, "");

const CH = String(ch ?? "").toUpperCase();

// Normalize map for rendering
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

const code = map[CH] ?? "";

const isLetter = /^[A-Z]$/.test(CH);
const isNumber = /^[0-9]$/.test(CH);

// Title/description (SEO)
const title = code ? `${CH} in Morse Code (${code})` : `${CH} in Morse Code`;
const description = code
  ? `Learn how to write ${CH} in Morse code (${code}). Copy it, listen to it, and practice with examples.`
  : `Learn how to write ${CH} in Morse code. Copy it, listen to it, and practice with examples.`;

// Canonical (Layout uses trailingSlash:"always")
const canonical = `${site}/morse-code/${CH.toLowerCase()}/`;

// Robots (prevents indexing broken/empty pages)
const robots = code ? "index,follow" : "noindex,follow";

const translatorHref = `/translate/?q=${encodeURIComponent(CH)}`;

const tips = (() => {
  if (!code) return [];
  const dots = (code.match(/\./g) || []).length;
  const dashes = (code.match(/-/g) || []).length;
  const len = dots + dashes;
  return [
    `${len} signals (${dots} dot${dots === 1 ? "" : "s"}, ${dashes} dash${
      dashes === 1 ? "" : "es"
    })`,
    "Dots are short • dashes are long",
    "Letters use spaces • words use “/”",
  ];
})();

const examples = isLetter
  ? [`${CH}`, `${CH}A`, `A${CH}`, `${CH}E`, `E${CH}`, `SOS`]
  : isNumber
  ? [`${CH}`, `${CH}0`, `1${CH}`, `${CH}${CH}`, `2026`, `SOS`]
  : [`${CH}`, `SOS`, `HELLO`];

const examplesMorse = examples.map((t) => ({
  text: t,
  morse: textToMorse(t, map, " "),
  href: `/translate/?q=${encodeURIComponent(t)}`,
}));

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Learn", url: `${site}/morse-code/` },
  { name: CH, url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};

// A small internal-link set (high-intent pages)
const practiceLinks = [
  { label: "Translator", href: "/translate/" },
  { label: "Words", href: "/morse-code/words/" },
  { label: "Punctuation", href: "/morse-code/punctuation/" },
  { label: "Phrases", href: "/phrases/" },
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/morse-code/">Learn</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">{CH}</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">{isLetter ? "Alphabet · A–Z" : isNumber ? "Numbers · 0–9" : "Reference"}</p>
    <h1 class="page-hero-title">{CH} in Morse code</h1>
    <p class="muted page-hero-sub">
      {code ? (
        <>Standard Morse code for <strong>{CH}</strong>. Copy it, hear it, or practice with real examples.</>
      ) : (
        <>This character isn't available in the current Morse map.</>
      )}
    </p>
  </header>

  {code && (
    <section class="char-show">
      <div class="char-show-row">
        <span class="char-show-letter">{CH}</span>
        <svg class="char-show-arrow" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </div>
      <div class="char-show-morse mono">{code}</div>
      <div id="rhythm" class="rhythm" aria-hidden="true"></div>

      <div class="char-show-meta">
        {tips.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>

      <div class="char-show-actions">
        <button id="copy" type="button" class="primary-action" disabled={!code}>
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
        <button id="listen" type="button" class="ghost" disabled={!code}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 3v18l14-9L5 3z"/></svg>
          Listen
        </button>
        <a class="btn ghost" href={translatorHref}>Practice in translator →</a>
      </div>
    </section>
  )}

  {!code && (
    <section class="card">
      <p class="muted">No Morse code available for this character.</p>
      <div class="page-hero-actions" style="margin-top: var(--s-3);">
        <a class="btn primary" href="/morse-code/">Back to Learn hub</a>
      </div>
    </section>
  )}

  {/* Accessible toast (used by Copy/Listen) */}
  <div id="toast" class="toast" aria-live="polite" aria-atomic="true"></div>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Practice examples</h2>
      <p class="muted" style="margin:0;">Click any example to practice instantly.</p>
    </div>

    <div class="ex-grid" style="margin-top:12px;">
      {examplesMorse.map((ex) => (
        <a class="ex" href={ex.href}>
          <div class="ex-text">{ex.text}</div>
          <div class="ex-morse k">{ex.morse}</div>
        </a>
      ))}
    </div>

    <p class="muted" style="margin-top:12px;">
      Tip: stop “counting” dots/dashes. With repetition, you recognize patterns as shapes/rhythm.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">Navigate</h2>

    <p class="muted" style="margin-top:0;">
      {prev ? <>Previous: <a href={`/morse-code/${String(prev).toLowerCase()}/`}>{prev}</a></> : <>Previous: —</>}
      {" • "}
      {next ? <>Next: <a href={`/morse-code/${String(next).toLowerCase()}/`}>{next}</a></> : <>Next: —</>}
    </p>

    <p class="muted" style="margin-top:10px;">
      Browse:
      <a href="/morse-code/a/"> alphabet</a> •
      <a href="/morse-code/numbers/"> numbers</a> •
      <a href="/morse-code/punctuation/"> punctuation</a> •
      <a href="/morse-code/words/"> words</a> •
      <a href="/phrases/"> phrases</a>
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>

    <h3 style="margin-bottom:6px;">How do I separate letters and words?</h3>
    <p class="muted" style="margin-top:0;">
      Letters are separated by spaces. Words are separated by <span class="k">/</span>.
      Example: <span class="k">HELLO</span> → <span class="k">.... . .-.. .-.. ---</span>.
    </p>

    <h3 style="margin-bottom:6px;">Can I practice {CH} in the translator?</h3>
    <p class="muted" style="margin-top:0;">
      Yes — open <a href={translatorHref}>the translator</a> with {CH} prefilled.
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline define:vars={{ code }}>
    (function () {
      const copyBtn = document.getElementById("copy");
      const listenBtn = document.getElementById("listen");
      const toastEl = document.getElementById("toast");

      const reducedMotion =
        typeof window !== "undefined" &&
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let toastTimer = null;
      function toast(msg) {
        if (!toastEl) return;
        toastEl.textContent = String(msg || "");
        toastEl.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.remove("show"), reducedMotion ? 600 : 1200);
      }

      async function copyText(text) {
        const t = String(text || "");
        try {
          await navigator.clipboard.writeText(t);
          return true;
        } catch {
          try {
            const ta = document.createElement("textarea");
            ta.value = t;
            ta.setAttribute("readonly", "true");
            ta.style.position = "fixed";
            ta.style.top = "-9999px";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return !!ok;
          } catch {
            return false;
          }
        }
      }

      copyBtn?.addEventListener("click", async () => {
        const value = String(code || "");
        if (!value) return;
        const ok = await copyText(value);
        toast(ok ? "Copied ✓" : "Copy failed");
      });

      function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }

      // --- Rhythm bar ---
      const rhythmEl = document.getElementById("rhythm");
      let rhythmTimers = [];
      function clearRhythm() {
        rhythmTimers.forEach((id) => clearTimeout(id));
        rhythmTimers = [];
        if (rhythmEl) {
          rhythmEl.innerHTML = "";
          rhythmEl.classList.remove("playing");
        }
      }
      function renderRhythm(seq, unitMs) {
        clearRhythm();
        if (!rhythmEl || !seq) return;
        const segs = [];
        let offset = 0;
        for (const sym of seq) {
          if (sym !== "." && sym !== "-") continue;
          const dur = sym === "-" ? unitMs * 3 : unitMs;
          segs.push({ start: offset, dur, sym });
          offset += dur + unitMs; // intra-element gap
        }
        const total = Math.max(offset, 1);
        for (const s of segs) {
          const el = document.createElement("span");
          el.className = "rhythm-seg" + (s.sym === "-" ? " dash" : " dot");
          el.style.left = `${(s.start / total) * 100}%`;
          el.style.width = `${(s.dur / total) * 100}%`;
          rhythmEl.appendChild(el);
          rhythmTimers.push(setTimeout(() => el.classList.add("on"), s.start));
          rhythmTimers.push(setTimeout(() => el.classList.remove("on"), s.start + s.dur));
        }
        rhythmEl.classList.add("playing");
        rhythmTimers.push(setTimeout(() => rhythmEl.classList.remove("playing"), total + 80));
      }

      // --- Audio playback (dot/dash) ---
      let playing = false;
      let stopFlag = false;

      listenBtn?.addEventListener("click", async () => {
        const value = String(code || "");
        if (!value) return;

        // Toggle stop if already playing
        if (playing) {
          stopFlag = true;
          clearRhythm();
          toast("Stopping…");
          return;
        }

        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) {
          toast("Audio not supported");
          return;
        }

        playing = true;
        stopFlag = false;

        const oldText = listenBtn.textContent;
        listenBtn.textContent = "Stop";
        listenBtn.classList.add("danger");

        const unit = 90; // ms
        const freq = 700;

        const ctx = new Ctx();

        try {
          // iOS/Safari often starts suspended; must resume on gesture
          if (ctx.state === "suspended") await ctx.resume();
        } catch {}

        const master = ctx.createGain();
        master.connect(ctx.destination);

        // default volume
        const volume = 0.06;
        master.gain.setValueAtTime(0.0001, ctx.currentTime);

        function startBeep(durationMs) {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.value = freq;

          // small attack/release to reduce clicks
          const now = ctx.currentTime;
          const dur = durationMs / 1000;

          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(1.0, now + 0.008);
          gain.gain.setValueAtTime(1.0, now + Math.max(0.008, dur - 0.02));
          gain.gain.linearRampToValueAtTime(0.0001, now + dur);

          osc.connect(gain);
          gain.connect(master);

          osc.start(now);
          osc.stop(now + dur + 0.01);
          return osc;
        }

        async function play() {
          toast("Playing…");
          renderRhythm(value, unit);
          for (const s of value) {
            if (stopFlag) break;

            if (s === ".") {
              startBeep(unit);
              await sleep(unit);
              await sleep(unit); // intra-symbol gap
            } else if (s === "-") {
              startBeep(unit * 3);
              await sleep(unit * 3);
              await sleep(unit);
            } else {
              // spacing / unknown
              await sleep(unit * 2);
            }
          }
        }

        try {
          // set master volume after resume (some browsers ignore before resume)
          master.gain.setValueAtTime(volume, ctx.currentTime);
          await play();
        } catch {
          // ignore
        }

        try { await ctx.close(); } catch {}

        // reset UI
        playing = false;
        stopFlag = false;

        listenBtn.textContent = oldText;
        listenBtn.classList.remove("danger");
        toast("Done ✓");
      });
    })();
  </script>

  <style>
    /* Big "letter → morse" showcase, matches phrase-show / word-show */
    .char-show{
      margin-top: var(--s-3);
      padding: var(--s-6);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
    }
    .char-show-row{
      display: flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .char-show-letter{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 88px;
      height: 88px;
      padding: 0 var(--s-3);
      border-radius: var(--r-lg);
      background: var(--accent-soft);
      color: var(--accent);
      font-family: var(--font-display);
      font-size: 56px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
    }
    .char-show-arrow{ color: var(--text-subtle); flex-shrink: 0; }
    .char-show-morse{
      margin-top: var(--s-4);
      padding: var(--s-4);
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--accent);
      font-size: clamp(22px, 3vw, 32px);
      letter-spacing: 0.12em;
      text-align: center;
      word-break: break-all;
    }
    /* Rhythm bar (active during Listen playback) */
    .rhythm{
      position: relative;
      margin-top: var(--s-3);
      height: 8px;
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      overflow: hidden;
      opacity: 0.35;
      transition: opacity .2s ease;
    }
    .rhythm.playing{ opacity: 1; }
    .rhythm-seg{
      position: absolute;
      top: 1px;
      bottom: 1px;
      border-radius: var(--r-pill);
      background: var(--text-subtle);
      transition: background .08s ease, box-shadow .08s ease, transform .08s ease;
    }
    .rhythm-seg.on{
      background: var(--accent);
      box-shadow: 0 0 0 1px var(--accent), 0 0 12px var(--accent-soft);
      transform: scaleY(1.15);
    }
    @media (prefers-reduced-motion: reduce){
      .rhythm-seg{ transition: none; }
      .rhythm-seg.on{ transform: none; }
    }

    .char-show-meta{
      margin-top: var(--s-4);
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    .char-show-actions{
      margin-top: var(--s-5);
      display: flex;
      gap: var(--s-2);
      flex-wrap: wrap;
      align-items: center;
    }
    .char-show-actions button[disabled]{ opacity: 0.5; cursor: not-allowed; }

    .section-head{
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-4);
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: var(--s-4);
    }

    /* Practice examples grid */
    .ex-grid{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
    @media (min-width: 600px){ .ex-grid{ grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 900px){ .ex-grid{ grid-template-columns: repeat(3, 1fr); } }

    .ex{
      text-decoration: none;
      border: 1px solid var(--line);
      background: var(--surface);
      border-radius: var(--r-md);
      padding: var(--s-3) var(--s-4);
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
      color: var(--text);
      transition: background .12s ease, border-color .12s ease;
    }
    .ex:hover{
      border-color: var(--accent-line);
      background: var(--surface-2);
      text-decoration: none;
    }
    .ex-text{ font-weight: 600; font-size: var(--fs-sm); color: var(--text); }
    .ex-morse{
      font-family: var(--font-mono);
      color: var(--accent);
      font-size: var(--fs-sm);
      letter-spacing: 0.06em;
    }

    /* Toast */
    .toast{
      position: fixed;
      left: 50%;
      bottom: var(--s-5);
      transform: translateX(-50%) translateY(8px);
      opacity: 0;
      pointer-events: none;
      padding: var(--s-2) var(--s-4);
      border-radius: var(--r-pill);
      background: var(--text);
      color: var(--bg);
      font-size: var(--fs-sm);
      font-weight: 600;
      box-shadow: var(--shadow-md);
      transition: opacity .15s ease, transform .15s ease;
      z-index: 60;
    }
    .toast.show{ opacity: 1; transform: translateX(-50%) translateY(0); }

    button.danger{
      border-color: var(--bad) !important;
      color: var(--bad) !important;
    }

    @media (max-width: 600px){
      .char-show-actions > *{ flex: 1; }
    }
  </style>
</Layout>
