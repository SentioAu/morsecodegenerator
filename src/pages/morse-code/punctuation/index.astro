---
import Layout from "../../../components/Layout.astro";
import data from "../../../data/morse.json";

const title = "Punctuation in Morse Code – Chart, Copy, Practice";
const description =
  "Morse code punctuation chart (., ?, !, /, (), @, etc.) with copy buttons and practice links. Learn symbols fast and practice in the translator.";

// Normalize map: keep exact punctuation keys, ignore " " if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k), String(v)])
);

const items = [
  [".", "Period"],
  [",", "Comma"],
  ["?", "Question mark"],
  ["!", "Exclamation"],
  ["/", "Slash"],
  ["(", "Open parenthesis"],
  [")", "Close parenthesis"],
  ["&", "Ampersand"],
  [":", "Colon"],
  [";", "Semicolon"],
  ["=", "Equals"],
  ["+", "Plus"],
  ["-", "Hyphen"],
  ["_", "Underscore"],
  ['"', "Quotation mark"],
  ["$", "Dollar"],
  ["@", "At sign"],
  ["'", "Apostrophe"],
].map(([ch, label]) => ({
  ch,
  label,
  morse: map[ch] ?? "",
  practice: `/translate/?q=${encodeURIComponent(ch)}`,
}));

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Learn", url: `${site}/morse-code/` },
  { name: "Punctuation", url: `${site}/morse-code/punctuation/` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: `${site}/morse-code/punctuation/`,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/morse-code/">Learn</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Punctuation</span>
  </nav>

  <header class="hero">
    <p class="muted kicker">Learn</p>
    <h1 class="title">Punctuation in Morse code</h1>
    <p class="muted sub">
      Quick reference for symbols. Copy in one click and practice by opening the translator.
    </p>

    <div class="actions">
      <a class="btn" href="/translate/">Practice in Translator</a>
      <a class="btn ghost" href="/morse-code/">Learn hub</a>
      <a class="btn ghost" href="/morse-code/numbers/">Numbers</a>
    </div>

    <div class="chips" aria-label="Formatting tips">
      <span class="chip">Letters: spaces</span>
      <span class="chip">Words: “/”</span>
      <span class="chip muted">Normalize: · → . and – → -</span>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Chart</h2>
      <p class="muted" style="margin:0;">Copy a pattern or practice the symbol directly.</p>
    </div>

    <div class="grid" style="margin-top:12px;">
      {items.map((row) => (
        <div class="row">
          <div class="symbol" aria-label={`Symbol ${row.ch}`}>{row.ch}</div>

          <div class="info">
            <div class="label">{row.label}</div>
            <div class="k morse">{row.morse || "—"}</div>
          </div>

          <div class="row-actions">
            <button
              class="copy"
              type="button"
              data-copy={row.morse || ""}
              disabled={!row.morse}
              aria-label={`Copy Morse for ${row.label}`}
            >
              Copy
            </button>
            <a class="btn ghost small" href={row.practice}>Practice</a>
          </div>
        </div>
      ))}
    </div>

    <p class="muted note">
      Tip: punctuation codes are often longer than letters. Learn the ones you actually use (., ?, !, /, @) first.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Try these</h2>
      <p class="muted" style="margin:0;">Practice full strings (symbols + letters):</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;">
      <a href="/translate/?q=HELLO!">HELLO!</a>
      <a href="/translate/?q=SOS!">SOS!</a>
      <a href="/translate/?q=WAIT%20/%20STOP">WAIT / STOP</a>
      <a href="/translate/?q=CALL%20ME%20@%209">CALL ME @ 9</a>
    </div>

    <p class="muted" style="margin-top:10px;">
      Next: <a href="/morse-code/a/">alphabet</a> • <a href="/morse-code/numbers/">numbers</a> • <a href="/phrases/">phrases</a>
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (function(){
      async function copyText(text){
        try { await navigator.clipboard.writeText(text); return true; }
        catch {
          try{
            const ta = document.createElement("textarea");
            ta.value = text; ta.style.position="fixed"; ta.style.left="-9999px";
            document.body.appendChild(ta); ta.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return ok;
          } catch { return false; }
        }
      }

      document.addEventListener("click", async (e) => {
        const btn = e.target?.closest?.("button[data-copy]");
        if (!btn) return;
        const val = btn.getAttribute("data-copy") || "";
        if (!val) return;

        const ok = await copyText(val);
        if (!ok) return;

        const old = btn.textContent;
        btn.textContent = "Copied ✓";
        setTimeout(() => (btn.textContent = old), 900);
      });
    })();
  </script>

  <style>
    .crumbs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:13px; opacity:.92; margin-top:2px; }
    .crumb{ text-decoration:none; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.02); padding:6px 10px; border-radius:999px; color:rgba(255,255,255,0.92); }
    .sep{ opacity:.65; }
    .crumb-current{ display:inline-flex; align-items:center; padding:6px 10px; border-radius:999px; border:1px solid rgba(255,255,255,0.10); background:rgba(255,255,255,0.015); color:rgba(255,255,255,0.78); }

    .hero{ margin-top:10px; }
    .kicker{ margin:0 0 10px; letter-spacing:.08em; text-transform:uppercase; font-size:12px; }
    .title{ margin:0 0 10px; }
    .sub{ margin:0; max-width:72ch; }

    .actions{ margin-top:14px; display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .btn{ display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:999px; text-decoration:none; border:1px solid rgba(255,255,255,0.16); background:rgba(255,255,255,0.03); color:rgba(255,255,255,0.92); font-weight:800; line-height:1; }
    .btn.ghost{ border-color:rgba(255,255,255,0.16); background:rgba(255,255,255,0.03); font-weight:750; }
    .btn.small{ padding:8px 12px; font-weight:750; }

    .chips{ margin-top:12px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .chip{ display:inline-flex; align-items:center; padding:7px 10px; border-radius:999px; border:1px solid rgba(255,255,255,0.10); background:rgba(255,255,255,0.02); color:rgba(255,255,255,0.82); font-size:13px; line-height:1.2; }

    .section-head{ display:flex; flex-wrap:wrap; gap:6px 14px; align-items:baseline; justify-content:space-between; }

    .grid{ display:grid; grid-template-columns: 1fr; gap:10px; }
    @media (min-width: 900px){ .grid{ grid-template-columns: 1fr 1fr; } }

    .row{
      display:grid;
      grid-template-columns: 72px 1fr auto;
      gap: 10px;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 16px;
      padding: 12px 14px;
      background: rgba(255,255,255,0.02);
      align-items:center;
      min-height: 72px;
    }

    .symbol{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width: 58px;
      height: 46px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 900;
      font-size: 22px;
      text-decoration:none;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .info .label{ font-weight: 800; }
    .morse{ margin-top: 2px; opacity: .88; overflow-wrap:anywhere; }

    .row-actions{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:flex-end; }

    .copy{
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(138,180,255,0.35);
      background: rgba(138,180,255,0.14);
      color: rgba(255,255,255,0.92);
      cursor:pointer;
      font-weight: 850;
    }
    .copy:disabled{ opacity:.45; cursor:not-allowed; }

    .note{ margin-top:12px; }

    @media (max-width: 600px){
      .actions > *{ width:100%; justify-content:center; }
      .row{ grid-template-columns: 64px 1fr; }
      .row-actions{ grid-column: 1 / -1; justify-content:flex-start; }
    }
  </style>
</Layout>
