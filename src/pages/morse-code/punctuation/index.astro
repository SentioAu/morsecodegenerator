---
import Layout from "../../../components/Layout.astro";
import data from "../../../data/morse.json";

const title = "Punctuation in Morse Code";
const description =
  "Morse code chart for common punctuation symbols. Copy patterns quickly and practice in the translator.";

// Normalize map: keep exact punctuation keys, ignore " " if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
);

const items = [
  [".", "Period"],
  [",", "Comma"],
  ["?", "Question mark"],
  ["!", "Exclamation"],
  ["/", "Slash"],
  ["(", "Open parenthesis"],
  [")", "Close parenthesis"],
  ["&", "Ampersand"],
  [":", "Colon"],
  [";", "Semicolon"],
  ["=", "Equals"],
  ["+", "Plus"],
  ["-", "Hyphen"],
  ["_", "Underscore"],
  ['"', "Quotation mark"],
  ["$", "Dollar"],
  ["@", "At sign"],
  ["'", "Apostrophe"],
].map(([ch, label]) => ({ ch, label, morse: map[ch] ?? "" }));
---

<Layout title={title} description={description}>
  <header>
    <h1>Punctuation in Morse Code</h1>
    <p class="muted" style="margin-top:6px; max-width:72ch;">
      Quick reference for punctuation symbols. Practice by pasting a symbol into the translator.
    </p>

    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:12px;">
      <a class="nav-link" href="/translate/">Practice in Translator</a>
      <a class="nav-link" href="/morse-code/">Learn hub</a>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="table">
      {items.map((row) => (
        <div class="row">
          <div class="cell big">{row.ch}</div>
          <div class="cell">
            <div style="font-weight:700;">{row.label}</div>
            <div class="k muted" style="margin-top:2px;">{row.morse || "—"}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Structured data -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do you write punctuation in Morse code?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many punctuation marks have standardized Morse code patterns, typically longer than letters. Use this chart to copy and practice them.",
          },
        },
        {
          "@type": "Question",
          name: "How do you separate letters and words in Morse code?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use spaces between letters and use “/” between words.",
          },
        },
      ],
    })}
  ></script>

  <style>
    .table{ display:grid; gap: 10px; }
    .row{
      display:grid;
      grid-template-columns: 120px 1fr;
      gap: 10px;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 16px;
      padding: 12px 14px;
      background: rgba(255,255,255,0.02);
      align-items:center;
    }
    .big{
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
    }
  </style>
</Layout>
