---
import Layout from "../../../components/Layout.astro";
import slugs from "../../../data/seo-slugs.json";

const title = "Morse Code Words – A–Z Word List (Translate & Copy)";
const description =
  "Browse Morse code words A–Z. Click any word to see its Morse code instantly, copy it, and practice in the translator.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

// ✅ Force canonical for this page (avoid ?q= variants becoming canonical)
const canonical = `${site}/morse-code/words/`;

// ✅ Optional: allow indexing this hub page
const robots = "index,follow";

// -------- slug helpers (self-contained) --------
const toStr = (x) => String(x ?? "").trim().toLowerCase();

const namedPunct = new Set([
  "comma","period","dot","question","exclamation","colon","semicolon",
  "plus","equals","hyphen","dash","slash","at","dollar","quote","apostrophe","underscore"
]);

function isWordSlug(s) {
  if (!s) return false;
  if (s.length > 28) return false;
  if (namedPunct.has(s)) return false;
  if (/^\d+$/.test(s)) return false;         // numbers handled elsewhere
  if (/^[a-z]$/.test(s)) return false;       // letters handled elsewhere
  if (!/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
  if (s.includes("--")) return false;

  const parts = s.split("-").filter(Boolean);
  if (parts.length === 0 || parts.length > 4) return false;
  if (!parts.every((p) => /^[a-z0-9]{2,15}$/.test(p))) return false;

  return true;
}

function titleCaseWordsFromSlug(s) {
  return s
    .split("-")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

const all = (Array.isArray(slugs) ? slugs : [])
  .map(toStr)
  .filter(isWordSlug);

// Group A–Z (numbers excluded already)
const groups = Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))
  .map((L) => {
    const items = all
      .filter((s) => (s[0] || "").toUpperCase() === L)
      .sort((a, b) => a.localeCompare(b, "en"));
    return { L, items };
  })
  .filter((g) => g.items.length > 0);

const count = all.length;

const alpha = groups.map((g) => g.L);

// ✅ Breadcrumbs (structured data)
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Learn", url: `${site}/morse-code/` },
  { name: "Words", url: canonical },
];

// ✅ JSON-LD: breadcrumbs + collection page + optional search action
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "CollectionPage",
      name: "Morse Code Words",
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
      potentialAction: {
        "@type": "SearchAction",
        target: `${canonical}?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <!-- ✅ Ensure canonical is correct even if Layout isn’t updated -->
  <head>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!-- Keep social URL stable (avoid ?q= in OG) -->
    <meta property="og:url" content={canonical} />
  </head>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/morse-code/">Learn</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Words</span>
  </nav>

  <header class="hero">
    <p class="muted kicker">Browse • Click • Practice</p>
    <h1 class="title">Morse Code Words (A–Z)</h1>

    <p class="muted sub">
      A curated list of <strong>{count}</strong> word pages. Click any word to open its Morse page,
      or practice it instantly in the translator.
    </p>

    <div class="actions">
      <a class="btn primary" href="/translate/">Open Translator</a>
      <a class="btn" href="/morse-code/">Learn hub</a>
      <a class="btn" href="/phrases/">Phrases</a>
      <a class="btn" href="/morse-code/a/">Alphabet</a>
      <a class="btn" href="/morse-code/numbers/">Numbers</a>
      <a class="btn" href="/morse-code/punctuation/">Punctuation</a>
    </div>

    <div class="search-row">
      <label class="muted" for="q"><strong>Search</strong> (filters instantly)</label>
      <input id="q" name="q" type="search" placeholder="Type a word… (example: help, water, good)" />
      <p class="muted tiny">
        Tip: hyphenated phrases also work (example: <span class="k">good-night</span>).
      </p>
    </div>

    <nav class="az" aria-label="A to Z index">
      {alpha.map((L) => (
        <a class="az-link" href={`#${L}`}>{L}</a>
      ))}
    </nav>
  </header>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">All words</h2>
    <p class="muted" style="margin-top:0;">
      Click a word to open <span class="k">/[slug]-in-morse-code/</span>.
    </p>

    <div id="list">
      {groups.map((g) => (
        <section class="group" id={g.L}>
          <h3 class="group-title">{g.L}</h3>

          <div class="grid">
            {g.items.map((s) => {
              const label = titleCaseWordsFromSlug(s);
              return (
                <a class="item" href={`/${s}-in-morse-code/`} data-slug={s} data-label={label.toLowerCase()}>
                  <span class="item-name">{label}</span>
                  <span class="muted item-slug">/{s}-in-morse-code/</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (function () {
      const q = document.getElementById("q");
      const items = Array.from(document.querySelectorAll(".item"));
      const groups = Array.from(document.querySelectorAll(".group"));

      // ✅ Support ?q= for shareable filtered views
      function setFromQuery() {
        try {
          const v = new URL(window.location.href).searchParams.get("q");
          if (v && q && !q.value) q.value = v;
        } catch {}
      }

      function applyFilter() {
        const v = String(q?.value || "").trim().toLowerCase();
        if (!v) {
          items.forEach((el) => (el.style.display = ""));
          groups.forEach((g) => (g.style.display = ""));
          return;
        }

        items.forEach((el) => {
          const slug = el.getAttribute("data-slug") || "";
          const label = el.getAttribute("data-label") || "";
          const ok = slug.includes(v) || label.includes(v);
          el.style.display = ok ? "" : "none";
        });

        groups.forEach((g) => {
          const anyVisible = !!g.querySelector(".item:not([style*='display: none'])");
          g.style.display = anyVisible ? "" : "none";
        });
      }

      setFromQuery();
      applyFilter();
      q?.addEventListener("input", applyFilter, { passive: true });
    })();
  </script>

  <style>
    .crumbs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:13px; opacity:.92; margin-top:2px; }
    .crumb{ text-decoration:none; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.02); padding:6px 10px; border-radius:999px; color:rgba(255,255,255,0.92); }
    .sep{ opacity:.65; }
    .crumb-current{ display:inline-flex; align-items:center; padding:6px 10px; border-radius:999px; border:1px solid rgba(255,255,255,0.10); background:rgba(255,255,255,0.015); color:rgba(255,255,255,0.78); }

    .hero { margin: 6px 0 14px; }
    .kicker{
      margin: 0 0 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 12px;
    }
    .title { margin: 0 0 8px; }
    .sub { margin: 0; max-width: 74ch; }

    .actions{
      margin-top: 14px;
      display:flex;
      gap: 10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .search-row{
      margin-top: 14px;
      max-width: 72ch;
    }
    .tiny{ font-size: 13px; }

    .az{
      margin-top: 14px;
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      align-items:center;
    }
    .az-link{
      text-decoration:none;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.90);
      font-weight: 800;
    }
    .az-link:hover{ opacity:.95; }

    .group{ margin-top: 18px; }
    .group-title{ margin: 0 0 10px; font-size: 18px; }

    .grid{
      display:grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    @media (min-width: 900px){
      .grid{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
    }

    .item{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.11);
      background: rgba(255,255,255,0.02);
      border-radius: 16px;
      padding: 12px;
      display:flex;
      flex-direction:column;
      gap: 6px;
      color: rgba(255,255,255,0.92);
    }
    .item:hover{
      border-color: rgba(255,255,255,0.18);
      background: rgba(255,255,255,0.04);
    }
    .item-name{ font-weight: 900; }
    .item-slug{ font-size: 13px; }
  </style>
</Layout>
