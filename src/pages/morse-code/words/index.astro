---
import Layout from "../../../components/Layout.astro";
import slugs from "../../../data/seo-slugs.json";

const title = "Morse Code Words – A–Z Word List (Translate & Copy)";
const description =
  "Browse Morse code words A–Z. Click any word to see its Morse code instantly, copy it, and practice in the translator.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

// ✅ Canonical fixed (avoid ?q= variants)
const canonical = `${site}/morse-code/words/`;

// ✅ Index the hub page itself
const robots = "index,follow";

// -------- slug helpers (self-contained) --------
const toStr = (x) => String(x ?? "").trim().toLowerCase();

const namedPunct = new Set([
  "comma","period","dot","question","exclamation","colon","semicolon",
  "plus","equals","hyphen","dash","slash","at","dollar","quote","apostrophe","underscore"
]);

function isWordSlug(s) {
  if (!s) return false;
  if (s.length > 28) return false;
  if (namedPunct.has(s)) return false;
  if (/^\d+$/.test(s)) return false;   // numbers handled elsewhere
  if (/^[a-z]$/.test(s)) return false; // letters handled elsewhere
  if (!/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
  if (s.includes("--")) return false;

  const parts = s.split("-").filter(Boolean);
  if (parts.length === 0 || parts.length > 4) return false;
  if (!parts.every((p) => /^[a-z0-9]{2,15}$/.test(p))) return false;

  return true;
}

function titleCaseWordsFromSlug(s) {
  return s
    .split("-")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

const all = (Array.isArray(slugs) ? slugs : [])
  .map(toStr)
  .filter(isWordSlug);

// Group A–Z
const groups = Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))
  .map((L) => {
    const items = all
      .filter((s) => (s[0] || "").toUpperCase() === L)
      .sort((a, b) => a.localeCompare(b, "en"));
    return { L, items };
  })
  .filter((g) => g.items.length > 0);

const count = all.length;
const alpha = groups.map((g) => g.L);

// ✅ Breadcrumbs (structured data)
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Learn", url: `${site}/morse-code/` },
  { name: "Words", url: canonical },
];

// ✅ JSON-LD: breadcrumbs + collection page
// (No SearchAction because filtering is client-side and we don't want ?q= treated as a real endpoint.)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "CollectionPage",
      name: "Morse Code Words",
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/morse-code/">Learn</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Words</span>
  </nav>

  <header class="hero">
    <p class="muted kicker">Browse • Click • Practice</p>
    <h1 class="title">Morse Code Words (A–Z)</h1>

    <p class="muted sub">
      A curated list of <strong>{count}</strong> word pages. Click any word to open its Morse page.
      Use search to filter instantly.
    </p>

    <div class="actions">
      <a class="btn primary" href="/translate/">Open Translator</a>
      <a class="btn" href="/morse-code/">Learn hub</a>
      <a class="btn" href="/phrases/">Phrases</a>
      <a class="btn" href="/morse-code/a/">Alphabet</a>
      <a class="btn" href="/morse-code/numbers/">Numbers</a>
      <a class="btn" href="/morse-code/punctuation/">Punctuation</a>
    </div>

    <div class="search-row">
      <label class="muted" for="q"><strong>Search</strong> (filters instantly)</label>

      <div class="search-controls">
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Type a word… (example: help, water, good)"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="clear" type="button" class="ghost">Clear</button>
      </div>

      <p class="muted tiny">
        Tip: hyphenated phrases also work (example: <span class="k">good-night</span>).
        Share a filtered view using <span class="k">?q=</span> — canonical stays <span class="k">/morse-code/words/</span>.
      </p>
    </div>

    <nav class="az" aria-label="A to Z index">
      {alpha.map((L) => (
        <a class="az-link" href={`#${L}`}>{L}</a>
      ))}
    </nav>
  </header>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">All words</h2>
    <p class="muted" style="margin-top:0;">
      Click a word to open <span class="k">/[slug]-in-morse-code/</span>.
    </p>

    <div id="list">
      {groups.map((g) => (
        <section class="group" id={g.L} data-group={g.L}>
          <h3 class="group-title">{g.L}</h3>

          <div class="grid">
            {g.items.map((s) => {
              const label = titleCaseWordsFromSlug(s);
              return (
                <a
                  class="item"
                  href={`/${s}-in-morse-code/`}
                  data-group={g.L}
                  data-slug={s}
                  data-label={label.toLowerCase()}
                >
                  <span class="item-name">{label}</span>
                  <span class="muted item-slug">/{s}-in-morse-code/</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (function () {
      const q = document.getElementById("q");
      const clearBtn = document.getElementById("clear");
      const items = Array.from(document.querySelectorAll(".item"));
      const groupEls = Array.from(document.querySelectorAll(".group"));

      function readQueryQ() {
        try { return new URL(window.location.href).searchParams.get("q") || ""; }
        catch { return ""; }
      }

      function setQueryQ(v) {
        // Keep shareability without making it "canonical"
        try {
          const url = new URL(window.location.href);
          if (v) url.searchParams.set("q", v);
          else url.searchParams.delete("q");
          window.history.replaceState({}, "", url.toString());
        } catch {}
      }

      function applyFilter(pushUrl) {
        const v = String(q?.value || "").trim().toLowerCase();
        if (pushUrl) setQueryQ(v);

        if (!v) {
          items.forEach((el) => (el.style.display = ""));
          groupEls.forEach((g) => (g.style.display = ""));
          return;
        }

        // Count visible items per group deterministically
        const visibleByGroup = Object.create(null);

        for (const el of items) {
          const slug = el.getAttribute("data-slug") || "";
          const label = el.getAttribute("data-label") || "";
          const ok = slug.includes(v) || label.includes(v);

          el.style.display = ok ? "" : "none";

          if (ok) {
            const g = el.getAttribute("data-group") || "";
            if (g) visibleByGroup[g] = (visibleByGroup[g] || 0) + 1;
          }
        }

        for (const g of groupEls) {
          const key = g.getAttribute("data-group") || "";
          g.style.display = visibleByGroup[key] ? "" : "none";
        }
      }

      // Init from ?q=
      const initial = readQueryQ();
      if (initial && q) q.value = initial;

      applyFilter(false);

      q?.addEventListener("input", () => applyFilter(true), { passive: true });

      clearBtn?.addEventListener("click", () => {
        if (!q) return;
        q.value = "";
        q.focus();
        applyFilter(true);
      });
    })();
  </script>

  <style>
    .hero{ margin: var(--s-3) 0 var(--s-5); }
    .kicker{
      margin: 0 0 var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .title{ margin: 0 0 var(--s-3); font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.025em; }
    .sub{ margin: 0; max-width: 60ch; color: var(--text-muted); }

    .actions{ margin-top: var(--s-5); display: flex; gap: var(--s-2); flex-wrap: wrap; }

    .search-row{ margin-top: var(--s-5); }
    .search-controls{
      display: flex;
      gap: var(--s-2);
      align-items: center;
      flex-wrap: wrap;
    }
    .search-controls input{ flex: 1; min-width: 240px; }
    .tiny{ font-size: var(--fs-xs); color: var(--text-muted); margin-top: var(--s-2); }

    /* A–Z chiclets */
    .az{
      margin-top: var(--s-5);
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-1);
      padding: var(--s-2);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
    }
    .az-link{
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border-radius: var(--r-sm);
      background: transparent;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: var(--fs-sm);
      transition: background .12s ease, color .12s ease;
    }
    .az-link:hover{
      background: var(--accent-soft);
      color: var(--accent);
      text-decoration: none;
    }

    .group{ margin-top: var(--s-6); }
    .group-title{
      margin: 0 0 var(--s-3);
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
      font-weight: 600;
    }

    .grid{
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--s-2);
    }

    .item{
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
      padding: var(--s-3) var(--s-4);
      text-decoration: none;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--text);
      transition: background .12s ease, border-color .12s ease;
    }
    .item:hover{
      background: var(--surface-2);
      border-color: var(--accent-line);
      text-decoration: none;
    }
    .item-name{ font-weight: 600; font-size: var(--fs-sm); }
    .item-slug{ font-size: var(--fs-xs); color: var(--text-subtle); font-family: var(--font-mono); }
  </style>
</Layout>
