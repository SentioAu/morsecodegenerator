---
import Layout from "../components/Layout.astro";
import morsePayload from "../data/morse.json";
import slugs from "../data/seo-slugs.json";

const morseMapRaw = (morsePayload?.morseMap ?? morsePayload) || {};

// Ignore the " " mapping during generation to avoid double word separators.
// Word separation is handled by " / " in our generator.
const morseMap = Object.fromEntries(
  Object.entries(morseMapRaw).filter(([k, v]) => k && v && k !== " ")
);

export function getStaticPaths() {
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

// If you later add more “named punctuation” slugs, just extend this object.
const slugToSymbol = {
  comma: ",",
  period: ".",
  dot: ".",
  question: "?",
  exclamation: "!",
  colon: ":",
  semicolon: ";",
  plus: "+",
  equals: "=",
  hyphen: "-",
  dash: "-",
  slash: "/",
  at: "@",
  dollar: "$",
  quote: "\"",
  apostrophe: "'",
  underscore: "_",
};

function titleCase(s) {
  return (s || "")
    .split(" ")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function termFromSlug(s) {
  if (slugToSymbol[s]) return { display: `${titleCase(s)} (${slugToSymbol[s]})`, value: slugToSymbol[s] };

  if (/^[a-z]$/i.test(s)) return { display: s.toUpperCase(), value: s.toUpperCase() };
  if (/^\d+$/.test(s)) return { display: s, value: s };

  const phrase = s.replace(/-/g, " ");
  return { display: titleCase(phrase), value: phrase };
}

function normText(x) {
  return (x || "").toUpperCase();
}

function textToMorse(input) {
  const s = normText(input).trim();
  if (!s) return "";

  const words = s.split(/\s+/).filter(Boolean);

  return words
    .map((w) =>
      w
        .split("")
        .map((ch) => morseMap[ch] || "?")
        .join(" ")
    )
    .join(" / ");
}

const term = termFromSlug(slug);
const morse = textToMorse(term.value);

const pageTitle = `${term.display} in Morse Code`;
const description = morse
  ? `Learn how to write ${term.display} in Morse code: ${morse}. Copy, practice, and translate instantly.`
  : `Learn how to write ${term.display} in Morse code. Copy, practice, and translate instantly.`;
---

<Layout title={pageTitle} description={description}>
  <h1>{term.display} in Morse Code</h1>

  <p class="muted">
    Copy the Morse code for <strong>{term.display}</strong>, or open the translator to convert any text.
  </p>

  <div class="card">
    <h2>Morse Code</h2>
    <p class="k" style="font-size:18px;word-break:break-word;">{morse}</p>

    <p>
      <a href="/translate/">Open Translator</a>
      {" "}•{" "}
      <a href="/phrases/">Common Phrases</a>
      {" "}•{" "}
      <a href="/morse-code/a/">Learn the Alphabet</a>
    </p>
  </div>

  <h2>How to read it</h2>
  <ul>
    <li>Dot: <span class="k">.</span></li>
    <li>Dash: <span class="k">-</span></li>
    <li>Letters are separated by spaces</li>
    <li>Words are separated by <span class="k">/</span></li>
  </ul>
</Layout>
