---
import Layout from "../components/Layout.astro";
import morsePayload from "../data/morse.json";
import slugs from "../data/seo-slugs.json";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const morseMapRaw = (morsePayload?.morseMap ?? morsePayload) || {};

// Normalize map keys:
// - Uppercase A–Z keys so lookups match
// - Drop the " " mapping (word breaks handled with " / ")
const morseMap = Object.fromEntries(
  Object.entries(morseMapRaw)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => {
      const key = /^[a-z]$/i.test(k) ? String(k).toUpperCase() : String(k);
      return [key, String(v)];
    })
);

// Named punctuation slugs (safe URLs)
const slugToSymbol = {
  comma: ",",
  period: ".",
  dot: ".",
  question: "?",
  exclamation: "!",
  colon: ":",
  semicolon: ";",
  plus: "+",
  equals: "=",
  hyphen: "-",
  dash: "-",
  slash: "/",
  at: "@",
  dollar: "$",
  quote: '"',
  apostrophe: "'",
  underscore: "_",
};

// ✅ IMPORTANT: This route should ONLY build:
// - short phrases / words (slug-style), and
// - named punctuation slugs (exclamation, apostrophe, etc.)
// It should NOT build single letters (a–z) or numbers (0–100),
// because those are canonical at /morse-code/{slug}/.
export function getStaticPaths() {
  const normalize = (x) => String(x ?? "").trim().toLowerCase();

  const BLOCKED = new Set(["", "-", "--", "---", "index", "null", "undefined"]);

  // Keep this list INSIDE getStaticPaths so it never depends on outer scope
  const EXTRA_NAMED = [
    "comma","period","dot","question","exclamation","colon","semicolon",
    "plus","equals","hyphen","dash","slash","at","dollar","quote","apostrophe","underscore"
  ];
  const named = new Set(EXTRA_NAMED);

  function isSafeSlug(s) {
    if (!s) return false;
    if (BLOCKED.has(s)) return false;
    if (s.length > 48) return false;
    if (!/^[a-z0-9]$/.test(s) && !/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
    if (s.includes("--")) return false;
    return true;
  }

  // Letters/numbers are excluded from this route (canonical elsewhere)
  function isSingleLetter(s) {
    return /^[a-z]$/.test(s);
  }

  function isNumber(s) {
    if (!/^\d+$/.test(s)) return false;
    const n = Number(s);
    return Number.isFinite(n) && n >= 0 && n <= 100;
  }

  function isNamedPunct(s) {
    return named.has(s);
  }

  function isShortPhrase(s) {
    const parts = s.split("-").filter(Boolean);
    if (parts.length === 0) return false;
    if (parts.length > 4) return false;
    if (s.length > 28) return false;
    if (!parts.every((p) => /^[a-z0-9]{2,15}$/.test(p))) return false;
    return true;
  }

  // Always include the named punctuation slugs in the build output,
  // even if seo-slugs.json does NOT contain them.
  const base = (Array.isArray(slugs) ? slugs : []).map(normalize);
  const combined = new Set([...base, ...EXTRA_NAMED]);

  return Array.from(combined)
    .filter(isSafeSlug)
    // ✅ Only build named punctuation + short phrases/words here
    .filter((s) => isNamedPunct(s) || isShortPhrase(s))
    // ✅ Explicitly prevent building single-letter and numeric pages here
    .filter((s) => !isSingleLetter(s) && !isNumber(s))
    .sort((a, b) => a.localeCompare(b, "en"))
    .map((s) => ({ params: { slug: s } }));
}

function titleCaseWords(s) {
  return (s || "")
    .split(" ")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function termFromSlug(s) {
  // named punctuation slugs -> symbol term
  if (slugToSymbol[s]) {
    return { display: `${titleCaseWords(s)} (${slugToSymbol[s]})`, value: slugToSymbol[s] };
  }

  // letters/numbers are not canonical here; still handled safely if visited
  if (/^[a-z]$/i.test(s)) {
    const up = s.toUpperCase();
    return { display: up, value: up };
  }
  if (/^\d+$/.test(s)) {
    return { display: s, value: s };
  }

  // phrase
  const phrase = s.replace(/-/g, " ");
  return { display: titleCaseWords(phrase), value: phrase };
}

// ✅ Match your main tool behavior: ignore unsupported chars (do NOT output "?")
function textToMorse(input) {
  const s = String(input ?? "").toUpperCase().trim();
  if (!s) return "";

  const words = s.split(/\s+/).filter(Boolean);

  return words
    .map((w) =>
      w
        .split("")
        .map((ch) => morseMap[ch] || "")
        .filter(Boolean)
        .join(" ")
    )
    .filter(Boolean)
    .join(" / ");
}

const slug = String(Astro.params?.slug ?? "").trim().toLowerCase();

// These should NEVER be built here, but bots may still hit them.
const isSingleLetter = /^[a-z]$/.test(slug);
const isNumber = /^\d+$/.test(slug) && Number(slug) >= 0 && Number(slug) <= 100;

// Canonical targets
const canonicalWord = `${site}/${slug}-in-morse-code/`;
const canonicalRef = (isSingleLetter || isNumber) ? `${site}/morse-code/${slug}/` : canonicalWord;

function pageSlugValidForThisRoute(s) {
  if (!s) return false;
  if (s.length > 48) return false;
  if (!/^[a-z0-9]$/.test(s) && !/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
  if (s.includes("--")) return false;

  const isNamed = Boolean(slugToSymbol[s]);

  const parts = s.split("-").filter(Boolean);
  const isShortPhrase =
    parts.length > 0 &&
    parts.length <= 4 &&
    s.length <= 28 &&
    parts.every((p) => /^[a-z0-9]{2,15}$/.test(p));

  // ✅ Only allow named punctuation + phrases here (not letters/numbers)
  return (isNamed || isShortPhrase) && !isSingleLetter && !isNumber;
}

const valid = pageSlugValidForThisRoute(slug);
const term = termFromSlug(slug);
const morse = valid ? textToMorse(term.value) : "";

// Robots rules:
// - If this is a letter/number, do NOT index here (canonical is /morse-code/{slug}/)
// - If invalid OR empty output, do NOT index
const robots =
  (isSingleLetter || isNumber) ? "noindex,follow" :
  (valid && morse) ? "index,follow" :
  "noindex,follow";

const pageTitle =
  (isSingleLetter || isNumber)
    ? `${term.display} in Morse Code`
    : (valid ? `${term.display} in Morse Code` : "Morse Code");

const description =
  (isSingleLetter || isNumber)
    ? `The canonical reference page for ${term.display} in Morse code is available. Copy, practice, and translate instantly.`
    : (valid && morse
        ? `Learn how to write ${term.display} in Morse code: ${morse}. Copy, practice, and translate instantly.`
        : `Learn how to write terms in Morse code. Copy, practice, and translate instantly.`);

// Breadcrumb + WebPage JSON-LD (use canonicalRef to avoid dupes)
const crumbs = [
  { name: "Home", url: `${site}/` },
  ...(isSingleLetter || isNumber
    ? [{ name: "Learn", url: `${site}/morse-code/` }]
    : [{ name: "Words", url: `${site}/morse-code/words/` }]),
  { name: term.display, url: canonicalRef },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: pageTitle,
      description,
      url: canonicalRef,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={pageTitle} description={description} robots={robots} canonical={canonicalRef}>
  <nav class="crumbs" aria-label="Breadcrumb" style="margin-top:2px;">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>

    {isSingleLetter || isNumber ? (
      <>
        <a class="crumb" href="/morse-code/">Learn</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{term.display}</span>
      </>
    ) : (
      <>
        <a class="crumb" href="/morse-code/words/">Words</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{term.display}</span>
      </>
    )}
  </nav>

  <h1 style="margin-top:10px;">{pageTitle}</h1>

  {(isSingleLetter || isNumber) ? (
    <>
      <p class="muted">
        This URL is not canonical for letters/numbers.
        Use the reference page instead:
        {" "}
        <a href={`/morse-code/${slug}/`}>{`/morse-code/${slug}/`}</a>.
      </p>

      <div class="card" style="margin-top:12px;">
        <p style="margin:0;">
          Go to:
          {" "}
          <a href={`/morse-code/${slug}/`}>canonical page</a>
          {" "}•{" "}
          <a href={`/translate/?q=${encodeURIComponent(term.value)}`}>open in translator</a>
        </p>
      </div>
    </>
  ) : valid ? (
    <>
      <p class="muted">
        Copy the Morse code for <strong>{term.display}</strong>, or open the translator to convert any text.
      </p>

      <div class="card">
        <h2 style="margin-top:0;">Morse Code</h2>

        {morse ? (
          <p class="k" style="font-size:18px;word-break:break-word;margin-top:10px;">{morse}</p>
        ) : (
          <p class="muted">No Morse output available for this term.</p>
        )}

        <p style="margin-top:12px;">
          <a href={`/translate/?q=${encodeURIComponent(term.value)}`}>Open Translator</a>
          {" "}•{" "}
          <a href="/morse-code/words/">Browse Words</a>
          {" "}•{" "}
          <a href="/morse-code/a/">Learn the Alphabet</a>
        </p>
      </div>

      <h2>How to read it</h2>
      <ul>
        <li>Dot: <span class="k">.</span></li>
        <li>Dash: <span class="k">-</span></li>
        <li>Letters are separated by spaces</li>
        <li>Words are separated by <span class="k">/</span></li>
      </ul>
    </>
  ) : (
    <>
      <p class="muted">
        This page is not available. Use the <a href="/translate/">translator</a> to convert any text to Morse code.
      </p>
      <p class="muted">
        You can also learn using <a href="/morse-code/a/">Alphabet</a>, <a href="/morse-code/words/">Words</a>, and <a href="/phrases/">Phrases</a>.
      </p>
    </>
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
  </style>
</Layout>
