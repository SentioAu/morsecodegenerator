---
import Layout from "../components/Layout.astro";
import morsePayload from "../data/morse.json";
import slugs from "../data/seo-slugs.json";
import { NAME_SLUGS, isNameSlug } from "../data/names.js";
import { GIFT_PHRASE_SLUGS, isGiftSlug } from "../data/gift-phrases.js";
import { affiliateForSlug, amazonGiftSearch } from "../data/affiliate-products.js";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const morseMapRaw = (morsePayload?.morseMap ?? morsePayload) || {};

// Normalize map keys:
// - Uppercase A–Z keys so lookups match
// - Drop the " " mapping (word breaks handled with " / ")
const morseMap = Object.fromEntries(
  Object.entries(morseMapRaw)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => {
      const key = /^[a-z]$/i.test(k) ? String(k).toUpperCase() : String(k);
      return [key, String(v)];
    })
);

// Named punctuation slugs (safe URLs)
const slugToSymbol = {
  comma: ",",
  period: ".",
  dot: ".",
  question: "?",
  exclamation: "!",
  colon: ":",
  semicolon: ";",
  plus: "+",
  equals: "=",
  hyphen: "-",
  dash: "-",
  slash: "/",
  at: "@",
  dollar: "$",
  quote: '"',
  apostrophe: "'",
  underscore: "_",
};

// ✅ IMPORTANT: This route should ONLY build:
// - short phrases / words (slug-style), and
// - named punctuation slugs (exclamation, apostrophe, etc.)
// It should NOT build single letters (a–z) or numbers (0–100),
// because those are canonical at /morse-code/{slug}/.
export function getStaticPaths() {
  const normalize = (x) => String(x ?? "").trim().toLowerCase();

  const BLOCKED = new Set(["", "-", "--", "---", "index", "null", "undefined"]);

  // Keep this list INSIDE getStaticPaths so it never depends on outer scope
  // Note: "dot"/"dash" are intentionally omitted — they're duplicate
  // aliases of "period"/"hyphen" (same symbol) and would be thin
  // duplicate-content pages. One canonical page per symbol.
  const EXTRA_NAMED = [
    "comma","period","question","exclamation","colon","semicolon",
    "plus","equals","hyphen","slash","at","dollar","quote","apostrophe","underscore"
  ];
  const named = new Set(EXTRA_NAMED);

  function isSafeSlug(s) {
    if (!s) return false;
    if (BLOCKED.has(s)) return false;
    if (s.length > 48) return false;
    if (!/^[a-z0-9]$/.test(s) && !/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
    if (s.includes("--")) return false;
    return true;
  }

  // Letters/numbers are excluded from this route (canonical elsewhere)
  function isSingleLetter(s) {
    return /^[a-z]$/.test(s);
  }

  function isNumber(s) {
    if (!/^\d+$/.test(s)) return false;
    const n = Number(s);
    return Number.isFinite(n) && n >= 0 && n <= 100;
  }

  function isNamedPunct(s) {
    return named.has(s);
  }

  function isShortPhrase(s) {
    const parts = s.split("-").filter(Boolean);
    if (parts.length === 0) return false;
    if (parts.length > 4) return false;
    if (s.length > 28) return false;
    // Allow 1-char parts so slugs like "i-love-you" and "i-need-help" build.
    if (!parts.every((p) => /^[a-z0-9]{1,15}$/.test(p))) return false;
    return true;
  }

  // Always include the named punctuation slugs in the build output,
  // even if seo-slugs.json does NOT contain them. Popular first names
  // are merged in too so "<name>-in-morse-code" pages build (they get
  // a name-aware gift/bracelet CTA in the body).
  const base = (Array.isArray(slugs) ? slugs : []).map(normalize);
  const names = (Array.isArray(NAME_SLUGS) ? NAME_SLUGS : []).map(normalize);
  const gifts = (Array.isArray(GIFT_PHRASE_SLUGS) ? GIFT_PHRASE_SLUGS : []).map(normalize);
  const combined = new Set([...base, ...EXTRA_NAMED, ...names, ...gifts]);

  return Array.from(combined)
    .filter(isSafeSlug)
    // ✅ Only build named punctuation + short phrases/words here
    .filter((s) => isNamedPunct(s) || isShortPhrase(s))
    // ✅ Explicitly prevent building single-letter and numeric pages here
    .filter((s) => !isSingleLetter(s) && !isNumber(s))
    .sort((a, b) => a.localeCompare(b, "en"))
    .map((s) => ({ params: { slug: s } }));
}

function titleCaseWords(s) {
  return (s || "")
    .split(" ")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

// Canonical-phrase index for display: when a slug matches a known phrase
// (e.g. "sos", "i-love-you"), prefer the curated UPPERCASE display from
// morse.json instead of mechanical title-casing ("Sos", "I Love You").
const phraseIndex = Object.fromEntries(
  (morsePayload?.phrases ?? []).map(([sl, ph]) => [String(sl), String(ph)])
);

function termFromSlug(s) {
  // named punctuation slugs -> symbol term
  if (slugToSymbol[s]) {
    return { display: `${titleCaseWords(s)} (${slugToSymbol[s]})`, value: slugToSymbol[s] };
  }

  // letters/numbers are not canonical here; still handled safely if visited
  if (/^[a-z]$/i.test(s)) {
    const up = s.toUpperCase();
    return { display: up, value: up };
  }
  if (/^\d+$/.test(s)) {
    return { display: s, value: s };
  }

  // Canonical phrase from morse.json wins ("SOS", "I LOVE YOU", "MAYDAY", ...)
  if (phraseIndex[s]) {
    return { display: phraseIndex[s], value: phraseIndex[s] };
  }

  // Generic phrase fallback: lowercase slug -> title case
  const phrase = s.replace(/-/g, " ");
  return { display: titleCaseWords(phrase), value: phrase };
}

// ✅ Match your main tool behavior: ignore unsupported chars (do NOT output "?")
function textToMorse(input) {
  const s = String(input ?? "").toUpperCase().trim();
  if (!s) return "";

  const words = s.split(/\s+/).filter(Boolean);

  return words
    .map((w) =>
      w
        .split("")
        .map((ch) => morseMap[ch] || "")
        .filter(Boolean)
        .join(" ")
    )
    .filter(Boolean)
    .join(" / ");
}

const slug = String(Astro.params?.slug ?? "").trim().toLowerCase();

// These should NEVER be built here, but bots may still hit them.
const isSingleLetter = /^[a-z]$/.test(slug);
const isNumber = /^\d+$/.test(slug) && Number(slug) >= 0 && Number(slug) <= 100;

// Canonical targets
const canonicalWord = `${site}/${slug}-in-morse-code/`;
const canonicalRef = (isSingleLetter || isNumber) ? `${site}/morse-code/${slug}/` : canonicalWord;

function pageSlugValidForThisRoute(s) {
  if (!s) return false;
  if (s.length > 48) return false;
  if (!/^[a-z0-9]$/.test(s) && !/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s)) return false;
  if (s.includes("--")) return false;

  const isNamed = Boolean(slugToSymbol[s]);

  const parts = s.split("-").filter(Boolean);
  const isShortPhrase =
    parts.length > 0 &&
    parts.length <= 4 &&
    s.length <= 28 &&
    parts.every((p) => /^[a-z0-9]{1,15}$/.test(p));

  // ✅ Only allow named punctuation + phrases here (not letters/numbers)
  return (isNamed || isShortPhrase) && !isSingleLetter && !isNumber;
}

// Reciprocal hreflang: a few high-value slugs have a hand-written
// Spanish counterpart under /es/. Declare the EN⇄ES alternates so Google
// links the pair (must match the `alternates` on the ES page exactly).
const ES_ALTERNATES = {
  "sos": "/es/sos-en-codigo-morse/",
  "i-love-you": "/es/te-amo-en-codigo-morse/",
};
const esAltPath = ES_ALTERNATES[slug];
const alternates = esAltPath
  ? [
      { lang: "en", href: `${site}/${slug}-in-morse-code/` },
      { lang: "es", href: `${site}${esAltPath}` },
    ]
  : undefined;

const valid = pageSlugValidForThisRoute(slug);
const term = termFromSlug(slug);
const morse = valid ? textToMorse(term.value) : "";

// Gift-aware: when the slug is a popular first name OR a gift/message
// phrase, the page leans into gift/jewelry/tattoo intent and funnels to
// the bracelet generator.
const isName = valid && !isSingleLetter && !isNumber && isNameSlug(slug);
const isGift = valid && !isSingleLetter && !isNumber && !isName && isGiftSlug(slug);
const showGift = isName || isGift;
const braceletHref = `/morse-bracelet/?text=${encodeURIComponent(term.display)}`;

// A curated ready-made product for this exact phrase, if one exists
// (e.g. "i love you"). Shown as a "buy one" option next to the free maker.
const aff = (valid && !isSingleLetter && !isNumber) ? affiliateForSlug(slug) : null;

// For gift/name pages without a hand-picked product, offer a tagged Amazon
// SEARCH link (never 404s) — names → personalized necklace, phrases →
// a bracelet for that phrase.
const amazonGiftHref = (showGift && !aff)
  ? amazonGiftSearch(term.display, { kind: isName ? "name" : "phrase" })
  : null;

// Per-character breakdown — genuinely useful (shows how to build the word
// letter by letter) AND unique per page, which lifts these template pages
// above the "thin content" threshold that keeps them out of Google's index.
const breakdown = (valid && !isSingleLetter && !isNumber)
  ? String(term.value).toUpperCase().split(/\s+/).filter(Boolean).map((word) => ({
      word,
      chars: word.split("").map((ch) => ({ ch, code: morseMap[ch] || "" })).filter((x) => x.code),
    })).filter((w) => w.chars.length)
  : [];
const allChars = breakdown.flatMap((w) => w.chars);
const ditCount = allChars.reduce((n, c) => n + (c.code.match(/\./g) || []).length, 0);
const dahCount = allChars.reduce((n, c) => n + (c.code.match(/-/g) || []).length, 0);

// Robots rules:
// - If this is a letter/number, do NOT index here (canonical is /morse-code/{slug}/)
// - If invalid OR empty output, do NOT index
const robots =
  (isSingleLetter || isNumber) ? "noindex,follow" :
  (valid && morse) ? "index,follow" :
  "noindex,follow";

const pageTitle =
  (isSingleLetter || isNumber)
    ? `${term.display} in Morse Code`
    : (valid ? `${term.display} in Morse Code` : "Morse Code");

const description =
  (isSingleLetter || isNumber)
    ? `The canonical reference page for ${term.display} in Morse code is available. Copy, practice, and translate instantly.`
    : isName && morse
        ? `${term.display} in Morse code is ${morse}. Copy it, hear it played, or turn it into a free bracelet or tattoo design.`
    : (valid && morse
        ? `Learn how to write ${term.display} in Morse code: ${morse}. Copy, practice, and translate instantly.`
        : `Learn how to write terms in Morse code. Copy, practice, and translate instantly.`);

// Breadcrumb + WebPage JSON-LD (use canonicalRef to avoid dupes)
const crumbs = [
  { name: "Home", url: `${site}/` },
  ...(isSingleLetter || isNumber
    ? [{ name: "Learn", url: `${site}/morse-code/` }]
    : [{ name: "Words", url: `${site}/morse-code/words/` }]),
  { name: term.display, url: canonicalRef },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: pageTitle,
      description,
      url: canonicalRef,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={pageTitle} description={description} robots={robots} canonical={canonicalRef} alternates={alternates}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>

    {isSingleLetter || isNumber ? (
      <>
        <a class="crumb" href="/morse-code/">Learn</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{term.display}</span>
      </>
    ) : (
      <>
        <a class="crumb" href="/morse-code/words/">Words</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{term.display}</span>
      </>
    )}
  </nav>

  {(isSingleLetter || isNumber) ? (
    <>
      <header class="page-hero">
        <p class="page-hero-kicker">Letter / Digit · Reference</p>
        <h1 class="page-hero-title">{pageTitle}</h1>
        <p class="muted page-hero-sub">
          This URL is not canonical for single letters or digits. The canonical reference page lives below.
        </p>
        <div class="page-hero-actions">
          <a class="btn primary" href={`/morse-code/${slug}/`}>Go to canonical page →</a>
          <a class="btn ghost" href={`/translate/?q=${encodeURIComponent(term.value)}`}>Open in translator</a>
        </div>
      </header>
    </>
  ) : valid ? (
    <>
      <header class="page-hero">
        <p class="page-hero-kicker">{isName ? "Name · Gift · Bracelet" : isGift ? "Message · Gift · Bracelet" : "Word · Copy · Practice"}</p>
        <h1 class="page-hero-title">{pageTitle}</h1>
        <p class="muted page-hero-sub">
          {showGift ? (
            <>Copy the Morse code for <strong>{term.display}</strong>, hear it played back, or turn it into a
            bracelet, necklace, or tattoo design with our free maker.</>
          ) : (
            <>Copy the Morse code for <strong>{term.display}</strong>, hear it played back, or open it in the
            translator to edit it.</>
          )}
        </p>
        {showGift && (
          <div class="page-hero-actions">
            <a class="btn primary" href={braceletHref}>Make {term.display} into a bracelet/tattoo →</a>
            <a class="btn ghost" href={`/translate/?q=${encodeURIComponent(term.value)}`}>Open in translator</a>
          </div>
        )}
      </header>

      {morse ? (
        <section class="word-show">
          <div class="word-show-row">
            <span class="word-show-text">{term.display}</span>
            <svg class="word-show-arrow" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </div>
          <div class="word-show-morse mono">{morse}</div>
          <div id="rhythm" class="rhythm" aria-hidden="true"></div>

          <div class="word-show-actions">
            <button id="copy" type="button" class="btn primary">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy Morse
            </button>
            <button id="play" type="button" class="btn ghost">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 3v18l14-9L5 3z"/></svg>
              Play
            </button>
            <a class="btn ghost" href={`/translate/?q=${encodeURIComponent(term.value)}`}>Open in translator →</a>
          </div>
        </section>
      ) : (
        <section class="card">
          <p class="muted">No Morse output available for this term.</p>
        </section>
      )}

      {breakdown.length > 0 && (
        <section class="section bd-section">
          <div class="section-head">
            <div>
              <p class="page-hero-kicker">Letter by letter</p>
              <h2 class="section-title">How "{term.display}" is built in Morse</h2>
            </div>
          </div>
          <p class="muted bd-intro">
            {term.display} is {allChars.length} character{allChars.length === 1 ? "" : "s"} —
            {" "}{ditCount} dot{ditCount === 1 ? "" : "s"} and {dahCount} dash{dahCount === 1 ? "" : "es"} in all.
            Here is each letter with its Morse code so you can send or write it one symbol at a time:
          </p>
          {breakdown.map((w) => (
            <div class="bd-word">
              {breakdown.length > 1 && <span class="bd-word-label">{w.word}</span>}
              <div class="bd-grid">
                {w.chars.map((c) => (
                  <div class="bd-cell">
                    <span class="bd-char">{c.ch}</span>
                    <span class="bd-code mono">{c.code}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>
      )}

      {showGift && morse && (
        <section class="card name-gift">
          <h2>Turn {term.display} into something you can keep</h2>
          <p>
            The dots and dashes for <strong>{term.display}</strong> make a quiet, personal design.
            Our free generator renders the name as a <strong>bead pattern</strong> for a bracelet or
            necklace, or a clean <strong>dot-and-dash</strong> design for a tattoo — then downloads it
            as a PNG or SVG.
          </p>
          <div class="page-hero-actions">
            <a class="btn primary" href={braceletHref}>Open the bracelet &amp; tattoo maker →</a>
            <a class="btn ghost" href="/morse-bracelet/">See all styles</a>
          </div>
        </section>
      )}

      {aff && (
        <section class="card aff-card">
          <h2>Prefer to buy one ready-made?</h2>
          <p>{aff.note}</p>
          <div class="page-hero-actions">
            <a class="btn primary" href={aff.url} target="_blank" rel="sponsored nofollow noopener" data-aff={aff.id}>{aff.cta} →</a>
            <a class="btn ghost" href={braceletHref}>Or make your own free</a>
          </div>
          <p class="aff-note">Affiliate link — we may earn a commission at no extra cost to you. It never affects what we feature. <a href="/disclosure/">Full disclosure</a>.</p>
        </section>
      )}

      {amazonGiftHref && (
        <section class="card aff-card">
          <h2>Prefer to buy one ready-made?</h2>
          <p>
            {isName
              ? <>Shop personalized Morse code necklaces and bracelets on Amazon, or make a free <strong>{term.display}</strong> design above.</>
              : <>Shop ready-made <strong>{term.display}</strong> Morse code bracelets on Amazon, or make your own free design above.</>}
          </p>
          <div class="page-hero-actions">
            <a class="btn primary" href={amazonGiftHref} target="_blank" rel="sponsored nofollow noopener" data-aff={`amazon-${slug}`}>Shop on Amazon →</a>
            <a class="btn ghost" href={braceletHref}>Make your own free</a>
          </div>
          <p class="aff-note">Affiliate link — we may earn a commission at no extra cost to you. <a href="/disclosure/">Disclosure</a>.</p>
        </section>
      )}

      <section class="section">
        <div class="section-head">
          <div>
            <p class="page-hero-kicker">How to read it</p>
            <h2 class="section-title">The format in one line</h2>
          </div>
        </div>
        <dl class="reading-key">
          <div>
            <dt>Dot</dt>
            <dd><span class="k">.</span> &nbsp; one short signal (1 unit)</dd>
          </div>
          <div>
            <dt>Dash</dt>
            <dd><span class="k">-</span> &nbsp; one long signal (3 units)</dd>
          </div>
          <div>
            <dt>Letter gap</dt>
            <dd>a single space between letters (3 units)</dd>
          </div>
          <div>
            <dt>Word gap</dt>
            <dd><span class="k">/</span> &nbsp; with surrounding spaces (7 units)</dd>
          </div>
        </dl>
      </section>

      <section class="section">
        <div class="section-head">
          <div>
            <p class="page-hero-kicker">Keep going</p>
            <h2 class="section-title">More Morse references</h2>
          </div>
        </div>
        <div class="pill-grid">
          {isName && <a href="/names-in-morse-code/">All names A–Z</a>}
          {showGift && <a href={braceletHref}>Make a bracelet</a>}
          {isGift && <a href="/phrases/">More phrases</a>}
          <a href="/morse-code/words/">Browse words A–Z</a>
          <a href="/morse-code/">Learn the alphabet</a>
          <a href="/phrases/">Common phrases</a>
          <a href="/translate/">Open translator</a>
        </div>
      </section>
    </>
  ) : (
    <>
      <header class="page-hero">
        <p class="page-hero-kicker">Page not available</p>
        <h1 class="page-hero-title">Morse code</h1>
        <p class="muted page-hero-sub">
          This page isn't available. Use the translator below to convert any text to Morse code, or jump
          straight into a reference.
        </p>
        <div class="page-hero-actions">
          <a class="btn primary" href="/translate/">Open translator</a>
          <a class="btn secondary" href="/morse-code/">Learn the alphabet</a>
          <a class="btn ghost" href="/phrases/">Common phrases</a>
        </div>
      </header>
    </>
  )}

  {valid && morse && (
    <script is:inline define:vars={{ morse }}>
      const copyBtn = document.getElementById("copy");
      const playBtn = document.getElementById("play");

      async function copyText(text) {
        try { await navigator.clipboard.writeText(text); return true; }
        catch {
          try {
            const ta = document.createElement("textarea");
            ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
            document.body.appendChild(ta); ta.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return ok;
          } catch { return false; }
        }
      }

      copyBtn?.addEventListener("click", async () => {
        const ok = await copyText(morse || "");
        if (!ok) return;
        const old = copyBtn.innerHTML;
        copyBtn.textContent = "Copied ✓";
        setTimeout(() => (copyBtn.innerHTML = old), 1200);
      });

      // --- Rhythm bar visualization ---
      const rhythmEl = document.getElementById("rhythm");
      let rhythmTimers = [];
      function clearRhythm() {
        rhythmTimers.forEach((id) => clearTimeout(id));
        rhythmTimers = [];
        if (rhythmEl) { rhythmEl.innerHTML = ""; rhythmEl.classList.remove("playing"); }
      }
      function renderRhythm(seq, wpm) {
        clearRhythm();
        if (!rhythmEl || !seq) return;
        const unit = 1200 / wpm;
        const cleaned = seq.replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return;
        const parts = cleaned.split(/\s+/);
        const segs = [];
        let offset = 0;
        for (const part of parts) {
          if (part === "/") { offset += unit * 7; continue; }
          for (const sym of part) {
            const dur = sym === "-" ? unit * 3 : unit;
            segs.push({ start: offset, dur, sym });
            offset += dur + unit;
          }
          offset += unit * 2;
        }
        const total = Math.max(offset, 1);
        for (const s of segs) {
          const el = document.createElement("span");
          el.className = "rhythm-seg" + (s.sym === "-" ? " dash" : " dot");
          el.style.left = `${(s.start / total) * 100}%`;
          el.style.width = `${(s.dur / total) * 100}%`;
          rhythmEl.appendChild(el);
          rhythmTimers.push(setTimeout(() => el.classList.add("on"), s.start));
          rhythmTimers.push(setTimeout(() => el.classList.remove("on"), s.start + s.dur));
        }
        rhythmEl.classList.add("playing");
        rhythmTimers.push(setTimeout(() => rhythmEl.classList.remove("playing"), total + 80));
      }

      let audioCtx;
      let stopFlag = false;
      function getAudioCtx() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        // Browser autoplay policy may leave the context suspended until
        // a user gesture; resume on each access so the next play() fires.
        if (audioCtx.state === "suspended") {
          audioCtx.resume().catch(() => {});
        }
        return audioCtx;
      }
      async function playMorse(sequence, wpm) {
        if (!sequence) return;
        const ctx = getAudioCtx();
        const unit = 1200 / wpm;
        let t = ctx.currentTime + 0.05;
        const cleaned = sequence.replace(/[^.\-\/\s]/g, "").trim();
        if (!cleaned) return;
        const parts = cleaned.split(/\s+/);
        for (const part of parts) {
          if (stopFlag) return;
          if (part === "/") { t += (unit * 7) / 1000; continue; }
          for (const sym of part) {
            if (stopFlag) return;
            const dur = sym === "-" ? unit * 3 : unit;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "sine";
            osc.frequency.value = 600;
            gain.gain.setValueAtTime(0.001, t);
            gain.gain.exponentialRampToValueAtTime(0.18, t + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.001, t + dur / 1000);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(t);
            osc.stop(t + dur / 1000);
            t += dur / 1000;
            t += unit / 1000;
          }
          t += (unit * 2) / 1000;
        }
      }

      playBtn?.addEventListener("click", async () => {
        stopFlag = false;
        const old = playBtn.innerHTML;
        playBtn.textContent = "Playing…";
        renderRhythm(morse || "", 18);
        await playMorse(morse || "", 18);
        setTimeout(() => (playBtn.innerHTML = old), 600);
      });

      // Stop playback and release the AudioContext when the tab is hidden
      // or the page is unloaded. Matches the cleanup pattern shipped in
      // PR #36 for /translate/, /decoder/, /practice/.
      function teardownAudio() {
        stopFlag = true;
        if (audioCtx) { try { audioCtx.close(); } catch {} audioCtx = undefined; }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") teardownAudio();
      });
      window.addEventListener("pagehide", teardownAudio);
    </script>
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

