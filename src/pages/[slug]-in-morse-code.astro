---
import Layout from "../components/Layout.astro";
import morsePayload from "../data/morse.json";
import slugs from "../data/seo-slugs.json";

const morseMapRaw = (morsePayload?.morseMap ?? morsePayload) || {};

// Normalize map keys:
// - Uppercase A–Z keys so textToMorse() matches reliably
// - Keep digits/punctuation as-is
// - Drop the " " mapping (we handle word breaks with " / ")
const morseMap = Object.fromEntries(
  Object.entries(morseMapRaw)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => {
      const key = /^[a-z]$/i.test(k) ? k.toUpperCase() : k;
      return [key, v];
    })
);

// Named punctuation slugs (safe URLs)
const slugToSymbol = {
  comma: ",",
  period: ".",
  dot: ".",
  question: "?",
  exclamation: "!",
  colon: ":",
  semicolon: ";",
  plus: "+",
  equals: "=",
  hyphen: "-",
  dash: "-",
  slash: "/",
  at: "@",
  dollar: "$",
  quote: "\"",
  apostrophe: "'",
  underscore: "_",
};

// --- Slug hardening / quality gates ---
const BLOCKED_SLUGS = new Set(["", "-", "--", "---", "index", "null", "undefined"]);

function isSafeSlug(s) {
  // Only allow: a-z, 0-9, hyphen
  // Must start/end with alnum
  // No consecutive hyphens
  // Reasonable length cap
  if (!s) return false;
  if (BLOCKED_SLUGS.has(s)) return false;
  if (s.length > 48) return false;
  if (!/^[a-z0-9][a-z0-9-]*[a-z0-9]$/.test(s) && !/^[a-z0-9]$/.test(s)) return false;
  if (s.includes("--")) return false;
  return true;
}

function isSingleLetterSlug(s) {
  return /^[a-z]$/.test(s);
}

function isNumberSlug(s) {
  if (!/^\d+$/.test(s)) return false;
  const n = Number(s);
  return Number.isFinite(n) && n >= 0 && n <= 100;
}

function isNamedPunctSlug(s) {
  return Boolean(slugToSymbol[s]);
}

function isShortPhraseSlug(s) {
  const parts = s.split("-").filter(Boolean);
  if (parts.length === 0) return false;
  if (parts.length > 4) return false; // max 4 words
  if (s.length > 28) return false; // keep it tight
  if (!parts.every((p) => /^[a-z0-9]{2,15}$/.test(p))) return false;
  return true;
}

function titleCase(s) {
  return (s || "")
    .split(" ")
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function termFromSlug(s) {
  if (slugToSymbol[s]) {
    return { display: `${titleCase(s)} (${slugToSymbol[s]})`, value: slugToSymbol[s], kind: "punct" };
  }
  if (/^[a-z]$/i.test(s)) {
    const up = s.toUpperCase();
    return { display: up, value: up, kind: "letter" };
  }
  if (/^\d+$/.test(s)) {
    return { display: s, value: s, kind: "number" };
  }
  const phrase = s.replace(/-/g, " ");
  return { display: titleCase(phrase), value: phrase, kind: "phrase" };
}

function normText(x) {
  return (x || "").toUpperCase();
}

function textToMorse(input) {
  const s = normText(input).trim();
  if (!s) return "";

  const words = s.split(/\s+/).filter(Boolean);

  return words
    .map((w) =>
      w
        .split("")
        .map((ch) => morseMap[ch] || "?")
        .join(" ")
    )
    .join(" / ");
}

// IMPORTANT: Only generate safe + useful pages.
export function getStaticPaths() {
  const normalize = (x) => String(x ?? "").trim().toLowerCase();

  return (Array.isArray(slugs) ? slugs : [])
    .map(normalize)
    .filter(isSafeSlug)
    .filter((s) => isSingleLetterSlug(s) || isNumberSlug(s) || isNamedPunctSlug(s) || isShortPhraseSlug(s))
    .map((s) => ({ params: { slug: s } }));
}

// --- Page logic ---
const slug = String(Astro.params?.slug ?? "").trim().toLowerCase();

const valid =
  isSafeSlug(slug) &&
  (isSingleLetterSlug(slug) || isNumberSlug(slug) || isNamedPunctSlug(slug) || isShortPhraseSlug(slug));

const term = termFromSlug(slug);
const morse = valid ? textToMorse(term.value) : "";
const hasUnknown = morse.includes("?");

// Robots policy: index only clean conversions; noindex anything thin/unknown
const robots =
  valid && morse && !hasUnknown ? "index,follow" : "noindex,follow";

const pageTitle = valid ? `${term.display} in Morse Code` : "Morse Code";
const description =
  valid && morse
    ? `Learn how to write ${term.display} in Morse code: ${morse}. Copy, practice, and translate instantly.`
    : `Learn how to write terms in Morse code. Copy, practice, and translate instantly.`;
---

<Layout title={pageTitle} description={description} robots={robots}>
  <h1>{valid ? `${term.display} in Morse Code` : "Morse Code"}</h1>

  {valid ? (
    <>
      <p class="muted">
        Copy the Morse code for <strong>{term.display}</strong>, or open the translator to convert any text.
      </p>

      <div class="card">
        <h2>Morse Code</h2>

        {morse ? (
          <p class="k" style="font-size:18px;word-break:break-word;">{morse}</p>
        ) : (
          <p class="muted">No Morse output available for this term.</p>
        )}

        {hasUnknown ? (
          <p class="muted" style="margin-top:10px;">
            Note: this result includes <span class="k">?</span> for unsupported characters.
          </p>
        ) : null}

        <p style="margin-top:12px;">
          <a href="/translate/">Open Translator</a>
          {" "}•{" "}
          <a href="/phrases/">Common Phrases</a>
          {" "}•{" "}
          <a href="/morse-code/a/">Learn the Alphabet</a>
        </p>
      </div>

      <h2>How to read it</h2>
      <ul>
        <li>Dot: <span class="k">.</span></li>
        <li>Dash: <span class="k">-</span></li>
        <li>Letters are separated by spaces</li>
        <li>Words are separated by <span class="k">/</span></li>
      </ul>
    </>
  ) : (
    <>
      <p class="muted">
        This page is not available. Use the <a href="/translate/">translator</a> to convert any text to Morse code.
      </p>
      <p class="muted">
        You can also learn using <a href="/morse-code/a/">Alphabet</a> and <a href="/phrases/">Phrases</a>.
      </p>
    </>
  )}
</Layout>
