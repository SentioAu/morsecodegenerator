---
import Layout from "../components/Layout.astro";
import data from "../data/morse.json";

// ⚠️ TERRITORY SPLIT with /cheat-sheet/ — keep these two apart.
// Both pages were ranking for the same pools and splitting the signal
// ("morse code chart": /chart/ pos 8.0, /cheat-sheet/ pos 9.9;
//  "morse code sheet": /cheat-sheet/ pos 6.8, /chart/ pos 8.8).
//   • /chart/       owns CHART / TABLE / ALPHABET CHART  ← this page
//   • /cheat-sheet/ owns SHEET / CHEAT SHEET / PRINTABLE SHEET
// Leads with the exact phrase this page should win, and picks up "morse
// code table" (44 impr) and "morse code alphabet chart" (78 impr), which
// nothing on the site was targeting. "Printable" moves to /cheat-sheet/,
// but PDF stays here — "morse code pdf" is this page's best converter
// (55 impr, 3 clicks).
const title = "Morse Code Chart – Alphabet & Numbers Table, Free PDF";
const description =
  "The full Morse code chart: every letter, number and punctuation mark in one table. Copy any code, or save the whole chart as a PDF to print. Free, no sign-up.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/chart/`;
const robots = "index,follow";

const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k), String(v)])
);

const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").map((ch) => ({ ch, code: map[ch] }));
const digits  = "0123456789".split("").map((ch) => ({ ch, code: map[ch] }));
const punct = [
  [".", "Period"],
  [",", "Comma"],
  ["?", "Question"],
  ["!", "Exclamation"],
  ["/", "Slash"],
  ["(", "Open paren"],
  [")", "Close paren"],
  ["&", "Ampersand"],
  [":", "Colon"],
  [";", "Semicolon"],
  ["=", "Equals"],
  ["+", "Plus"],
  ["-", "Hyphen"],
  ["_", "Underscore"],
  ['"', "Quote"],
  ["$", "Dollar"],
  ["@", "At"],
  ["'", "Apostrophe"],
].map(([ch, label]) => ({ ch, label, code: map[ch] || "" }));

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Chart", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <nav class="crumbs no-print" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Chart</span>
  </nav>

  <header class="page-hero no-print">
    <p class="page-hero-kicker">Printable • PDF-ready</p>
    <h1 class="page-hero-title">Morse code chart</h1>
    <p class="muted page-hero-sub">
      The complete International Morse Code (ITU-R M.1677-1) — alphabet, numbers, and punctuation.
      Designed to print cleanly on a single page in light or dark mode.
    </p>

    <div class="page-hero-actions">
      <button id="printBtn" class="btn primary" type="button">Print / Save as PDF</button>
      <a class="btn secondary" href="/cheat-sheet/">One-page cheat sheet</a>
      <a class="btn ghost" href="/translate/">Open translator</a>
      <a class="btn ghost" href="/practice/">Practice it</a>
    </div>
  </header>

  <section class="chart-doc">
    <header class="chart-head">
      <h2 class="chart-title">International Morse Code</h2>
      <p class="chart-sub">ITU-R M.1677-1 · MorseCodeGenerator.com</p>
    </header>

    <div class="chart-cols">
      <section>
        <h3>Alphabet</h3>
        <div class="grid-26">
          {letters.map((l) => (
            <div class="cell">
              <div class="ch">{l.ch}</div>
              <div class="code k">{l.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3>Numbers</h3>
        <div class="grid-10">
          {digits.map((d) => (
            <div class="cell">
              <div class="ch">{d.ch}</div>
              <div class="code k">{d.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3>Punctuation</h3>
        <div class="grid-punct">
          {punct.map((p) => (
            <div class="cell wide">
              <div class="ch">
                <span class="ch-sym">{p.ch}</span>
                <span class="ch-lab">{p.label}</span>
              </div>
              <div class="code k">{p.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="legend">
        <h3>Legend</h3>
        <ul>
          <li><span class="k">.</span> &nbsp;= dot (1 unit)</li>
          <li><span class="k">-</span> &nbsp;= dash (3 units)</li>
          <li>letter gap = 3 units (one space here)</li>
          <li>word gap = 7 units (written as <span class="k">/</span>)</li>
          <li>WPM: 1 unit ms = 1200 / WPM</li>
        </ul>
      </section>
    </div>

    <footer class="chart-foot">
      <small>© MorseCodeGenerator.com · the hub of Morse code · /chart/</small>
    </footer>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    document.getElementById("printBtn")?.addEventListener("click", () => window.print());
  </script>

  <style>
    .chart-doc{
      margin-top: var(--s-5);
      padding: var(--s-6);
      border-radius: var(--r-xl);
      border: 1px solid var(--line);
      background: var(--surface);
    }

    .chart-head{
      text-align: center;
      margin-bottom: var(--s-5);
      padding-bottom: var(--s-4);
      border-bottom: 1px solid var(--line);
    }
    .chart-title{
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      letter-spacing: -0.02em;
    }
    .chart-sub{
      margin: var(--s-1) 0 0;
      font-size: var(--fs-xs);
      color: var(--text-muted);
      font-family: var(--font-mono);
      letter-spacing: 0.04em;
    }

    .chart-cols{ display: grid; gap: var(--s-5); }
    .chart-cols h3{
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
      margin: 0 0 var(--s-3);
      font-weight: 600;
    }

    .grid-26, .grid-10, .grid-punct{ display: grid; gap: var(--s-1); }
    .grid-26, .grid-10{ grid-template-columns: repeat(2, 1fr); }
    .grid-punct{ grid-template-columns: 1fr; }
    @media (min-width: 720px){
      .grid-26{ grid-template-columns: repeat(4, 1fr); }
      .grid-10{ grid-template-columns: repeat(5, 1fr); }
      .grid-punct{ grid-template-columns: repeat(2, 1fr); }
    }

    .cell{
      background: var(--surface-2);
      padding: var(--s-2) var(--s-3);
      border-radius: var(--r-sm);
      border: 1px solid var(--line);
      font-size: var(--fs-sm);
    }
    .cell .ch{ font-weight: 700; min-width: 2ch; color: var(--text); }
    .cell .code{ font-family: var(--font-mono); color: var(--text-muted); font-size: var(--fs-sm); }
    .cell.wide .ch{ display: flex; gap: var(--s-2); align-items: baseline; }
    .ch-sym{ font-weight: 700; color: var(--text); }
    .ch-lab{ font-size: var(--fs-xs); color: var(--text-subtle); font-weight: 400; }

    .legend ul{
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: var(--s-2);
      font-size: var(--fs-sm);
      color: var(--text-muted);
    }
    .chart-foot{
      text-align: center;
      margin-top: var(--s-5);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line);
      color: var(--text-subtle);
      font-size: var(--fs-xs);
    }

    /* Print stylesheet */
    @media print {
      :root, body{
        background: #fff !important;
        color: #000 !important;
      }
      .no-print, .site-header, .site-footer, .skip, .crumbs{ display: none !important; }
      .chart-doc{
        background: #fff !important;
        border: 1px solid #ccc !important;
        color: #000 !important;
        padding: 16px !important;
      }
      .cell{
        background: #fff !important;
        border: 1px solid #999 !important;
        color: #000 !important;
      }
      .cell .ch, .cell .code, .ch-sym{ color: #000 !important; }
      .ch-lab, .chart-sub, .chart-foot, .legend, .chart-cols h3{ color: #444 !important; }
      a{ color: #000 !important; text-decoration: none !important; }
    }
  </style>
</Layout>
