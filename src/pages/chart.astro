---
import Layout from "../components/Layout.astro";
import data from "../data/morse.json";

const title = "Printable Morse Code Chart (A–Z, 0–9, Punctuation) – PDF-Ready";
const description =
  "Free printable Morse code chart — alphabet, numbers, and punctuation. Print or save as PDF, light/dark print friendly, with copyable codes.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/chart/`;
const robots = "index,follow";

const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k), String(v)])
);

const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").map((ch) => ({ ch, code: map[ch] }));
const digits  = "0123456789".split("").map((ch) => ({ ch, code: map[ch] }));
const punct = [
  [".", "Period"],
  [",", "Comma"],
  ["?", "Question"],
  ["!", "Exclamation"],
  ["/", "Slash"],
  ["(", "Open paren"],
  [")", "Close paren"],
  ["&", "Ampersand"],
  [":", "Colon"],
  [";", "Semicolon"],
  ["=", "Equals"],
  ["+", "Plus"],
  ["-", "Hyphen"],
  ["_", "Underscore"],
  ['"', "Quote"],
  ["$", "Dollar"],
  ["@", "At"],
  ["'", "Apostrophe"],
].map(([ch, label]) => ({ ch, label, code: map[ch] || "" }));

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Chart", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <nav class="crumbs no-print" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Chart</span>
  </nav>

  <header class="page-hero no-print">
    <p class="page-hero-kicker">Printable • PDF-ready</p>
    <h1 class="page-hero-title">Morse code chart</h1>
    <p class="muted page-hero-sub">
      The complete International Morse Code (ITU-R M.1677-1) — alphabet, numbers, and punctuation.
      Designed to print cleanly on a single page in light or dark mode.
    </p>

    <div class="page-hero-actions">
      <button id="printBtn" class="btn primary" type="button">Print / Save as PDF</button>
      <a class="btn secondary" href="/translate/">Open translator</a>
      <a class="btn ghost" href="/practice/">Practice it</a>
    </div>
  </header>

  <section class="chart-doc">
    <header class="chart-head">
      <h2 class="chart-title">International Morse Code</h2>
      <p class="chart-sub">ITU-R M.1677-1 · MorseCodeGenerator.com</p>
    </header>

    <div class="chart-cols">
      <section>
        <h3>Alphabet</h3>
        <div class="grid-26">
          {letters.map((l) => (
            <div class="cell">
              <div class="ch">{l.ch}</div>
              <div class="code k">{l.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3>Numbers</h3>
        <div class="grid-10">
          {digits.map((d) => (
            <div class="cell">
              <div class="ch">{d.ch}</div>
              <div class="code k">{d.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3>Punctuation</h3>
        <div class="grid-punct">
          {punct.map((p) => (
            <div class="cell wide">
              <div class="ch">
                <span class="ch-sym">{p.ch}</span>
                <span class="ch-lab">{p.label}</span>
              </div>
              <div class="code k">{p.code}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="legend">
        <h3>Legend</h3>
        <ul>
          <li><span class="k">.</span> &nbsp;= dot (1 unit)</li>
          <li><span class="k">-</span> &nbsp;= dash (3 units)</li>
          <li>letter gap = 3 units (one space here)</li>
          <li>word gap = 7 units (written as <span class="k">/</span>)</li>
          <li>WPM: 1 unit ms = 1200 / WPM</li>
        </ul>
      </section>
    </div>

    <footer class="chart-foot">
      <small>© MorseCodeGenerator.com · the hub of Morse code · /chart/</small>
    </footer>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    document.getElementById("printBtn")?.addEventListener("click", () => window.print());
  </script>

  <style>
    .crumbs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:13px; opacity:.92; margin-top:2px; }
    .crumb{ text-decoration:none; border:1px solid var(--border); background: var(--panel2); padding:6px 10px; border-radius:999px; color: var(--text); }
    .sep{ opacity:.65; }
    .crumb-current{ display:inline-flex; align-items:center; padding:6px 10px; border-radius:999px; border:1px solid var(--border); background: var(--panel2); color: var(--muted); }

    .chart-doc{
      margin-top: 18px;
      padding: 22px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: var(--surface-2);
    }

    .chart-head{ text-align:center; margin-bottom: 14px; }
    .chart-title{ margin: 0; font-family: var(--font-display); font-size: 26px; }
    .chart-sub{ margin: 4px 0 0; font-size: 13px; color: var(--muted); }

    .chart-cols{ display:grid; gap: 18px; }
    .chart-cols h3{
      font-family: var(--font-display);
      letter-spacing: .02em;
      margin: 6px 0 10px;
    }

    .grid-26{ display:grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .grid-10{ display:grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .grid-punct{ display:grid; grid-template-columns: 1fr; gap: 6px; }

    @media (min-width: 720px){
      .grid-26{ grid-template-columns: repeat(4, 1fr); }
      .grid-10{ grid-template-columns: repeat(5, 1fr); }
      .grid-punct{ grid-template-columns: repeat(2, 1fr); }
    }

    .cell{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 8px;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface-2);
    }
    .cell .ch{ font-weight: 850; min-width: 2ch; }
    .cell .code{ font-weight: 600; opacity: .92; }
    .cell.wide .ch{
      display:flex;
      gap: 8px;
      align-items: baseline;
    }
    .ch-sym{ font-weight: 900; }
    .ch-lab{ font-size: 12px; color: var(--muted); font-weight: 500; }

    .legend ul{ list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
    .chart-foot{ text-align:center; margin-top: 16px; color: var(--muted); }

    /* ------------------------------------------------------------ */
    /* Print stylesheet                                              */
    /* ------------------------------------------------------------ */
    @media print {
      :root, body{
        background: #fff !important;
        color: #000 !important;
      }
      .no-print, .site-header, .site-footer, .skip{ display: none !important; }
      .panel{
        box-shadow: none !important;
        border: none !important;
        background: #fff !important;
        padding: 0 !important;
      }
      .chart-doc{
        background: #fff !important;
        border: 1px solid #ccc !important;
        color: #000 !important;
        padding: 16px !important;
      }
      .cell{
        background: #fff !important;
        border: 1px solid #999 !important;
        color: #000 !important;
      }
      .ch-lab, .chart-sub, .chart-foot, .legend{ color: #444 !important; }
      a{ color: #000 !important; text-decoration: none !important; }
    }
  </style>
</Layout>
