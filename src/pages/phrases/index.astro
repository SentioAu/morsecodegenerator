---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";

const title = "Common Morse Code Phrases – Copy & Practice";
const description =
  "Browse common Morse code phrases (SOS, HELP, MAYDAY, and more). Copy Morse instantly and practice with the translator.";

const phrases = (data?.phrases ?? []).map(([slug, phrase]) => ({ slug, phrase }));
const map = data?.morseMap ?? {};

// Canonical pieces for JSON-LD
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Common Morse Code Phrases",
  url: `${site}/phrases/`,
  isPartOf: { "@type": "WebSite", url: site, name: "Morse Code Generator" },
};
---

<Layout title={title} description={description}>
  <header class="hero">
    <h1 class="hero-title">Common Morse Code Phrases</h1>

    <p class="muted hero-sub">
      Click any phrase to open its dedicated page (with a copy button), or copy Morse directly from the tool below.
    </p>

    <div class="hero-actions">
      <a class="nav-link" href="/translate/">Open Translator</a>
      <a class="nav-link" href="/morse-code/a/">Learn Alphabet</a>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Browse phrases</h2>
      <p class="muted" style="margin:0;">Open any phrase page.</p>
    </div>

    <div class="pill-grid phrase-pills" style="margin-top:12px;">
      {phrases.map((p) => (
        <a href={`/phrases/${p.slug}/`}>{p.phrase}</a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Copy Morse quickly</h2>
      <p class="muted" style="margin:0;">Pick a phrase and copy its Morse (no page change).</p>
    </div>

    <div class="grid" style="margin-top:12px;">
      <div>
        <label for="phraseSelect"><strong>Phrase</strong></label><br />
        <select id="phraseSelect" aria-label="Select a phrase">
          {phrases.map((p) => (
            <option value={p.phrase}>{p.phrase}</option>
          ))}
        </select>

        <p class="muted" style="margin-top:10px;">
          Tip: You can practice any phrase inside the <a href="/translate/">translator</a>.
        </p>
      </div>

      <div>
        <label for="phraseMorse"><strong>Morse</strong></label><br />
        <textarea
          id="phraseMorse"
          rows="4"
          readonly
          placeholder="Morse will appear here..."
        ></textarea>

        <div class="tool-row" style="margin-top:10px;">
          <button id="copyMorse" type="button">Copy Morse</button>
          <a class="nav-link" id="practiceLink" href="/translate/">Practice in Translator</a>
        </div>

        <p class="muted" style="margin-top:10px;">
          Output format: spaces separate letters and “/” separates words.
        </p>
      </div>
    </div>
  </section>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)}></script>

  <style>
    /* page-only layout polish */
    .hero { margin-bottom: 10px; }
    .hero-title { margin: 0 0 8px; }
    .hero-sub { margin: 0; max-width: 72ch; }
    .hero-actions { margin-top: 12px; display:flex; gap:10px; flex-wrap:wrap; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .tool-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    /* Make huge phrase lists feel less “endless” */
    .phrase-pills{
      max-height: 520px;
      overflow: auto;
      padding-right: 6px;
    }

    /* Select styling to match global inputs (Layout currently styles textarea/input, not select) */
    select{
      width:100%;
      padding: 12px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(0,0,0,0.18);
      color: rgba(255,255,255,0.92);
      outline:none;
    }
  </style>

  <script is:inline define:vars={{ map }}>
    const select = document.getElementById("phraseSelect");
    const morseBox = document.getElementById("phraseMorse");
    const copyBtn = document.getElementById("copyMorse");
    const practiceLink = document.getElementById("practiceLink");

    function toMorse(text){
      const s = (text || "").toUpperCase().trim();
      if (!s) return "";
      return s
        .split(/\s+/)
        .filter(Boolean)
        .map(w => w.split("").map(ch => (map?.[ch] || "")).filter(Boolean).join(" "))
        .join(" / ");
    }

    function refresh(){
      const phrase = (select?.value || "").toString();
      const morse = toMorse(phrase);
      if (morseBox) morseBox.value = morse;
      if (practiceLink) practiceLink.href = "/translate/?q=" + encodeURIComponent(phrase);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    select?.addEventListener("change", refresh);
    refresh();

    copyBtn?.addEventListener("click", async () => {
      const value = (morseBox?.value || "").toString();
      if (!value) return;

      const ok = await copyText(value);
      if (!ok) return;

      const old = copyBtn.textContent;
      copyBtn.textContent = "Copied ✓";
      setTimeout(() => (copyBtn.textContent = old), 1200);
    });
  </script>
</Layout>
