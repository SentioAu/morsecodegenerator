---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";

// Title / SEO
const title = "Common Morse Code Phrases – Copy & Practice";
const description =
  "Browse common Morse code phrases (SOS, HELP, MAYDAY, and more). Copy Morse instantly and practice with the translator.";

// -------------------------
// Helpers
// -------------------------
function slugify(s) {
  return (
    String(s || "")
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "phrase"
  );
}

function normalizePhraseList(raw) {
  const out = [];
  if (!Array.isArray(raw)) return out;

  // pairs: [["sos","SOS"], ...]
  if (raw.length && Array.isArray(raw[0])) {
    for (const row of raw) {
      const sl = row?.[0];
      const ph = row?.[1];
      if (!sl || !ph) continue;
      out.push({ slug: String(sl), phrase: String(ph) });
    }
    return out;
  }

  // objects: [{slug:"sos", phrase:"SOS"}, ...] or [{text:"SOS"}, ...]
  for (const p of raw) {
    if (!p) continue;
    const ph = p.phrase ?? p.text ?? p.value ?? p.name;
    if (!ph) continue;
    const sl = p.slug ?? slugify(ph);
    out.push({ slug: String(sl), phrase: String(ph) });
  }

  return out;
}

function dedupeBySlug(items) {
  const seen = new Set();
  const out = [];
  for (const it of items) {
    const sl = String(it?.slug || "").trim();
    const ph = String(it?.phrase || "").trim();
    if (!sl || !ph) continue;
    const key = sl.toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ slug: sl, phrase: ph });
  }
  return out;
}

// Normalize map: uppercase keys, ignore " " key if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// Phrases from JSON (robust)
const phrasesFromJson = dedupeBySlug(normalizePhraseList(data?.phrases ?? []));

// Fallback list (works even if JSON is missing phrases)
const fallback = [
  "SOS",
  "HELP",
  "MAYDAY",
  "EMERGENCY",
  "DANGER",
  "STOP",
  "WAIT",
  "COME HERE",
  "CALL ME",
  "CALL POLICE",
  "CALL AMBULANCE",
  "I NEED HELP",
  "I AM LOST",
  "WHERE ARE YOU",
  "I AM HERE",
  "MEET ME",
  "OK",
  "YES",
  "NO",
  "HELLO",
  "THANK YOU",
  "PLEASE",
  "SORRY",
  "I LOVE YOU",
].map((phrase) => ({ slug: slugify(phrase), phrase }));

const hasRealPhrases = phrasesFromJson.length > 0;

// Final list used for UI
const list = (hasRealPhrases ? phrasesFromJson : fallback).slice().sort((a, b) => {
  return String(a.phrase).localeCompare(String(b.phrase));
});

// Site URL for JSON-LD + canonical
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/phrases/`;

// If real phrase pages exist, link to them. Otherwise link to translator to avoid 404.
const hrefFor = (item) =>
  hasRealPhrases
    ? `/phrases/${item.slug}/`
    : `/translate/?q=${encodeURIComponent(item.phrase)}`;

// Structured data
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "CollectionPage",
      name: "Common Morse Code Phrases",
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", url: site, name: "Morse Code Generator" },
    },
  ],
};

// Hub should always be indexable
const robots = "index,follow";
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <header class="page-hero">
    <p class="page-hero-kicker">Browse • Copy • Practice</p>

    <h1 class="page-hero-title">Common Morse Code Phrases</h1>

    <p class="muted page-hero-sub">
      Search, copy Morse instantly, and practice inside the translator.
      {hasRealPhrases ? " Each phrase also has its own page." : ""}
    </p>

    <div class="page-hero-actions">
      <a class="btn primary" href="/translate/">Open Translator</a>
      <a class="btn secondary" href="/morse-code/">Learn hub</a>
      <a class="btn ghost" href="/morse-code/words/">Practice words</a>
      <a class="btn ghost" href="/">Home</a>
    </div>

    {!hasRealPhrases && (
      <p class="muted warn">
        Your <span class="k">data.phrases</span> list is missing/empty in{" "}
        <span class="k">src/data/morse.json</span>, so this page is showing a fallback list.
        Add a <span class="k">phrases</span> array there to enable full phrase pages + SEO expansion.
      </p>
    )}
  </header>

  <section class="section card soft">
    <div class="toprow">
      <div>
        <h2>Browse phrases</h2>
        <p class="muted">
          Tip: click a phrase to open it (or open in translator if fallback mode).
        </p>
      </div>

      <div class="searchbox">
        <label class="muted" for="phraseSearch" style="font-size:12px;">Search</label>
        <input id="phraseSearch" type="search" placeholder="Type: SOS, help, love..." />
      </div>
    </div>

    <div class="pill-grid phrase-pills" id="phraseList" style="margin-top:12px;">
      {list.map((p) => (
        <a href={hrefFor(p)} data-phrase={String(p.phrase).toLowerCase()}>
          {p.phrase}
        </a>
      ))}
    </div>
  </section>

  <section class="section card soft">
    <div class="section-head">
      <h2 class="section-title">Copy Morse quickly</h2>
      <p class="muted section-sub">Pick a phrase → copy its Morse.</p>
    </div>

    <div class="grid tool-grid" style="margin-top:12px;">
      <div>
        <label for="phraseSelect"><strong>Phrase</strong></label><br />
        <select id="phraseSelect" aria-label="Select a phrase">
          {list.map((p) => (
            <option value={p.phrase}>{p.phrase}</option>
          ))}
        </select>

        <p class="muted" style="margin-top:10px;">
          Practice link updates automatically.
        </p>
      </div>

      <div>
        <label for="phraseMorse"><strong>Morse</strong></label><br />
        <textarea id="phraseMorse" rows="4" readonly placeholder="Morse will appear here..."></textarea>

        <div class="tool-row" style="margin-top:10px;">
          <button id="copyMorse" type="button">Copy Morse</button>
          <a class="btn ghost" id="practiceLink" href="/translate/">Practice in Translator</a>
        </div>

        <p class="muted" style="margin-top:10px;">
          Format: spaces between letters • “/” between words.
        </p>
      </div>
    </div>
  </section>

  <p class="muted" style="margin-top:16px;">
    Explore:
    <a href="/morse-code/"> learn hub</a> •
    <a href="/morse-code/a/"> alphabet</a> •
    <a href="/morse-code/numbers/"> numbers</a> •
    <a href="/morse-code/punctuation/"> punctuation</a> •
    <a href="/morse-code/words/"> words</a>
  </p>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline define:vars={{ map }}>
    const select = document.getElementById("phraseSelect");
    const morseBox = document.getElementById("phraseMorse");
    const copyBtn = document.getElementById("copyMorse");
    const practiceLink = document.getElementById("practiceLink");
    const search = document.getElementById("phraseSearch");
    const listEl = document.getElementById("phraseList");

    function toMorse(text){
      const s = (text || "").toString().toUpperCase().trim();
      if (!s) return "";

      // Convert words -> letters -> morse. Unsupported chars become "?"
      return s
        .split(/\s+/)
        .filter(Boolean)
        .map(w =>
          w.split("")
            .map(ch => (map && map[ch] ? map[ch] : "?"))
            .join(" ")
        )
        .join(" / ");
    }

    function refresh(){
      const phrase = (select && select.value ? select.value : "").toString();
      const morse = toMorse(phrase);
      if (morseBox) morseBox.value = morse;
      if (practiceLink) practiceLink.href = "/translate/?q=" + encodeURIComponent(phrase);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    select && select.addEventListener("change", refresh);
    refresh();

    copyBtn && copyBtn.addEventListener("click", async () => {
      const value = (morseBox && morseBox.value ? morseBox.value : "").toString();
      if (!value) return;

      const ok = await copyText(value);
      if (!ok) return;

      const old = copyBtn.textContent;
      copyBtn.textContent = "Copied ✓";
      setTimeout(() => (copyBtn.textContent = old), 1200);
    });

    // Search filter
    search && search.addEventListener("input", () => {
      const q = (search.value || "").trim().toLowerCase();
      const pills = listEl ? listEl.querySelectorAll("a[data-phrase]") : null;
      if (!pills) return;

      pills.forEach((a) => {
        const text = a.getAttribute("data-phrase") || "";
        a.style.display = !q || text.includes(q) ? "" : "none";
      });
    });
  </script>

  <style>
    .warn { margin-top: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-2); }

    .toprow{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap: 12px;
      flex-wrap:wrap;
    }
    .searchbox{ min-width: min(360px, 100%); }

    .tool-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .phrase-pills{
      max-height: 520px;
      overflow: auto;
      padding-right: 6px;
    }

    @media (min-width: 760px) {
      .tool-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</Layout>
