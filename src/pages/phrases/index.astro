---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";

// Title / SEO
const title = "Common Morse Code Phrases – Copy & Practice";
const description =
  "Browse common Morse code phrases (SOS, HELP, MAYDAY, and more). Copy Morse instantly and practice with the translator.";

// -------------------------
// Helpers
// -------------------------
function slugify(s) {
  return (
    String(s || "")
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "phrase"
  );
}

function normalizePhraseList(raw) {
  const out = [];
  if (!Array.isArray(raw)) return out;

  // pairs: [["sos","SOS"], ...]
  if (raw.length && Array.isArray(raw[0])) {
    for (const row of raw) {
      const sl = row?.[0];
      const ph = row?.[1];
      if (!sl || !ph) continue;
      out.push({ slug: String(sl), phrase: String(ph) });
    }
    return out;
  }

  // objects: [{slug:"sos", phrase:"SOS"}, ...] or [{text:"SOS"}, ...]
  for (const p of raw) {
    if (!p) continue;
    const ph = p.phrase ?? p.text ?? p.value ?? p.name;
    if (!ph) continue;
    const sl = p.slug ?? slugify(ph);
    out.push({ slug: String(sl), phrase: String(ph) });
  }

  return out;
}

function dedupeBySlug(items) {
  const seen = new Set();
  const out = [];
  for (const it of items) {
    const sl = String(it?.slug || "").trim();
    const ph = String(it?.phrase || "").trim();
    if (!sl || !ph) continue;
    const key = sl.toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ slug: sl, phrase: ph });
  }
  return out;
}

// Normalize map: uppercase keys, ignore " " key if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// Phrases from JSON (robust)
const phrasesFromJson = dedupeBySlug(normalizePhraseList(data?.phrases ?? []));

// Fallback list (works even if JSON is missing phrases)
const fallback = [
  "SOS",
  "HELP",
  "MAYDAY",
  "EMERGENCY",
  "DANGER",
  "STOP",
  "WAIT",
  "COME HERE",
  "CALL ME",
  "CALL POLICE",
  "CALL AMBULANCE",
  "I NEED HELP",
  "I AM LOST",
  "WHERE ARE YOU",
  "I AM HERE",
  "MEET ME",
  "OK",
  "YES",
  "NO",
  "HELLO",
  "THANK YOU",
  "PLEASE",
  "SORRY",
  "I LOVE YOU",
].map((phrase) => ({ slug: slugify(phrase), phrase }));

const hasRealPhrases = phrasesFromJson.length > 0;

// Final list used for UI
const list = (hasRealPhrases ? phrasesFromJson : fallback).slice().sort((a, b) => {
  return String(a.phrase).localeCompare(String(b.phrase));
});

// Site URL for JSON-LD + canonical
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/phrases/`;

// If real phrase pages exist, link to them. Otherwise link to translator to avoid 404.
const hrefFor = (item) =>
  hasRealPhrases
    ? `/phrases/${item.slug}/`
    : `/translate/?q=${encodeURIComponent(item.phrase)}`;

// Structured data
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "CollectionPage",
      name: "Common Morse Code Phrases",
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", url: site, name: "Morse Code Generator" },
    },
  ],
};

// Hub should always be indexable
const robots = "index,follow";
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="crumb-current">Phrases</span>
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">{list.length} phrases · Browse · Copy</p>
    <h1 class="page-hero-title">Common Morse code phrases</h1>
    <p class="muted page-hero-sub">
      Search by name, click any phrase to see its Morse code, hear it, and copy it.
      Everything below works offline once the page loads.
    </p>
  </header>

  <div class="phrase-search" role="search">
    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="search-icon">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
    <input
      id="phraseSearch"
      type="search"
      placeholder="Search phrases (SOS, HELP, I love you...)"
      autocomplete="off"
      spellcheck="false"
      aria-label="Search phrases"
    />
    <span class="search-count muted" id="phraseCount">{list.length} phrases</span>
  </div>

  <section class="phrase-grid" id="phraseList">
    {list.map((p) => (
      <a class="phrase-card" href={hrefFor(p)} data-phrase={String(p.phrase).toLowerCase()}>
        <span class="phrase-name">{p.phrase}</span>
        <svg class="phrase-arrow" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    ))}
  </section>
  <p class="muted empty-msg" id="emptyMsg" hidden>No phrases match your search.</p>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Quick lookup</p>
        <h2 class="section-title">Pick a phrase, copy the Morse</h2>
      </div>
      <p class="section-sub muted">Same data the per-phrase pages use — without leaving this page.</p>
    </div>

    <div class="phrase-tool">
      <div class="phrase-tool-side">
        <label class="field">
          <span class="field-label">Phrase</span>
          <select id="phraseSelect" aria-label="Select a phrase">
            {list.map((p) => (
              <option value={p.phrase}>{p.phrase}</option>
            ))}
          </select>
        </label>
        <a class="phrase-tool-link" id="practiceLink" href="/translate/">
          Open in translator
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="phrase-tool-side">
        <label class="field">
          <span class="field-label">Morse</span>
          <textarea id="phraseMorse" rows="3" readonly placeholder="Morse code appears here…" class="mono"></textarea>
        </label>
        <button id="copyMorse" type="button" class="ghost">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy Morse
        </button>
      </div>
    </div>
  </section>

  <p class="muted explore-row">
    Explore: <a href="/morse-code/">learn hub</a> ·
    <a href="/morse-code/a/">alphabet</a> ·
    <a href="/morse-code/numbers/">numbers</a> ·
    <a href="/morse-code/punctuation/">punctuation</a> ·
    <a href="/morse-code/words/">words</a>
  </p>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline define:vars={{ map }}>
    const select = document.getElementById("phraseSelect");
    const morseBox = document.getElementById("phraseMorse");
    const copyBtn = document.getElementById("copyMorse");
    const practiceLink = document.getElementById("practiceLink");
    const search = document.getElementById("phraseSearch");
    const listEl = document.getElementById("phraseList");
    const countEl = document.getElementById("phraseCount");
    const emptyMsg = document.getElementById("emptyMsg");

    function toMorse(text){
      const s = (text || "").toString().toUpperCase().trim();
      if (!s) return "";
      return s
        .split(/\s+/)
        .filter(Boolean)
        .map(w =>
          w.split("")
            .map(ch => (map && map[ch] ? map[ch] : "?"))
            .join(" ")
        )
        .join(" / ");
    }

    function refresh(){
      const phrase = (select && select.value ? select.value : "").toString();
      const morse = toMorse(phrase);
      if (morseBox) morseBox.value = morse;
      if (practiceLink) practiceLink.href = "/translate/?q=" + encodeURIComponent(phrase);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    select && select.addEventListener("change", refresh);
    refresh();

    copyBtn && copyBtn.addEventListener("click", async () => {
      const value = (morseBox && morseBox.value ? morseBox.value : "").toString();
      if (!value) return;
      const ok = await copyText(value);
      if (!ok) return;
      const old = copyBtn.innerHTML;
      copyBtn.textContent = "Copied ✓";
      setTimeout(() => (copyBtn.innerHTML = old), 1200);
    });

    // Search filter
    search && search.addEventListener("input", () => {
      const q = (search.value || "").trim().toLowerCase();
      const cards = listEl ? listEl.querySelectorAll("a[data-phrase]") : null;
      if (!cards) return;
      let visible = 0;
      cards.forEach((a) => {
        const text = a.getAttribute("data-phrase") || "";
        const show = !q || text.includes(q);
        a.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (countEl) countEl.textContent = `${visible} phrase${visible === 1 ? "" : "s"}`;
      if (emptyMsg) emptyMsg.hidden = visible !== 0;
    });
  </script>

  <style>
    /* Sticky-ish search bar */
    .phrase-search{
      display: flex;
      align-items: center;
      gap: var(--s-3);
      padding: var(--s-2) var(--s-4);
      margin: 0 0 var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      transition: border-color .12s ease, box-shadow .12s ease;
    }
    .phrase-search:focus-within{
      border-color: var(--accent);
      box-shadow: var(--focus-ring);
    }
    .phrase-search .search-icon{ color: var(--text-subtle); flex-shrink: 0; }
    .phrase-search input{
      flex: 1;
      border: 0;
      background: transparent;
      padding: var(--s-2) 0;
      font-size: var(--fs-base);
      color: var(--text);
      outline: none;
    }
    .phrase-search input:focus{ box-shadow: none; }
    .search-count{
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      flex-shrink: 0;
    }

    /* Phrase grid */
    .phrase-grid{
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--s-2);
    }
    .phrase-card{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--text);
      text-decoration: none;
      font-size: var(--fs-sm);
      font-weight: 500;
      letter-spacing: 0.01em;
      transition: background .12s ease, border-color .12s ease, color .12s ease;
    }
    .phrase-card:hover{
      background: var(--surface-2);
      border-color: var(--accent-line);
      color: var(--accent);
      text-decoration: none;
    }
    .phrase-card:hover .phrase-arrow{ transform: translateX(2px); }
    .phrase-name{
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .phrase-arrow{
      flex-shrink: 0;
      color: var(--text-subtle);
      transition: color .12s ease, transform .12s ease;
    }
    .phrase-card:hover .phrase-arrow{ color: var(--accent); }

    .empty-msg{
      text-align: center;
      padding: var(--s-7) var(--s-4);
      font-style: italic;
    }

    /* Inline lookup tool */
    .phrase-tool{
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-4);
      padding: var(--s-5);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
    }
    @media (min-width: 760px){
      .phrase-tool{ grid-template-columns: 1fr 1.2fr; }
    }
    .phrase-tool-side{ display: flex; flex-direction: column; gap: var(--s-3); }
    .phrase-tool .field{ display: grid; gap: var(--s-2); margin: 0; }
    .phrase-tool .field-label{
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
    }
    .phrase-tool textarea.mono{
      min-height: 80px;
      font-size: var(--fs-sm);
      letter-spacing: 0.04em;
    }
    .phrase-tool-link{
      display: inline-flex;
      align-items: center;
      gap: 4px;
      align-self: flex-start;
      font-size: var(--fs-sm);
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }
    .phrase-tool-link:hover{ text-decoration: underline; }
    .phrase-tool button{ align-self: flex-start; }

    .explore-row{
      margin-top: var(--s-6);
      font-size: var(--fs-sm);
      color: var(--text-muted);
    }
    .explore-row a{ color: var(--text-muted); }
    .explore-row a:hover{ color: var(--accent); }
  </style>
</Layout>
