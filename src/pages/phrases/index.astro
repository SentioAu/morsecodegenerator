---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";

// Title / SEO
const title = "Common Morse Code Phrases – Copy & Practice";
const description =
  "Browse common Morse code phrases (SOS, HELP, MAYDAY, and more). Copy Morse instantly and practice with the translator.";

// Normalize map: uppercase keys, ignore " " key if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// Robust phrase parsing (supports:
// 1) [["sos","SOS"], ...]
// 2) [{slug:"sos", phrase:"SOS"}, ...]
// 3) [{slug:"sos", text:"SOS"}, ...]
function slugify(s) {
  return String(s || "")
    .toLowerCase()
    .trim()
    .replace(/['"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80) || "phrase";
}

const rawPhrases = data?.phrases;
let phrases = [];

if (Array.isArray(rawPhrases)) {
  // Array of pairs
  if (rawPhrases.length && Array.isArray(rawPhrases[0])) {
    phrases = rawPhrases
      .map((row) => {
        const slug = row?.[0];
        const phrase = row?.[1];
        if (!slug || !phrase) return null;
        return { slug: String(slug), phrase: String(phrase) };
      })
      .filter(Boolean);
  } else {
    // Array of objects
    phrases = rawPhrases
      .map((p) => {
        if (!p) return null;
        const phrase = p.phrase ?? p.text ?? p.value ?? p.name;
        if (!phrase) return null;
        const slug = p.slug ?? slugify(phrase);
        return { slug: String(slug), phrase: String(phrase) };
      })
      .filter(Boolean);
  }
}

// Fallback list (works even if JSON is missing phrases)
const fallback = [
  "SOS",
  "HELP",
  "MAYDAY",
  "EMERGENCY",
  "DANGER",
  "STOP",
  "WAIT",
  "COME HERE",
  "CALL ME",
  "CALL POLICE",
  "CALL AMBULANCE",
  "I NEED HELP",
  "I AM LOST",
  "WHERE ARE YOU",
  "I AM HERE",
  "MEET ME",
  "OK",
  "YES",
  "NO",
  "HELLO",
  "THANK YOU",
  "PLEASE",
  "SORRY",
  "I LOVE YOU",
].map((phrase) => ({ slug: slugify(phrase), phrase }));

const hasPhrases = phrases.length > 0;
const list = hasPhrases ? phrases : fallback;

// Site URL for JSON-LD
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Common Morse Code Phrases",
  url: `${site}/phrases/`,
  isPartOf: { "@type": "WebSite", url: site, name: "Morse Code Generator" },
};

// Client-side morse builder (same output format as your site: letters = spaces, words = " / ")
function toMorse(text) {
  const s = String(text || "").toUpperCase().trim();
  if (!s) return "";
  return s
    .split(/\s+/)
    .filter(Boolean)
    .map((w) =>
      w
        .split("")
        .map((ch) => map?.[ch] || "")
        .filter(Boolean)
        .join(" ")
    )
    .join(" / ");
}

// If the real phrases list exists, dedicated pages should exist.
// If not, we only link to translator to avoid 404s.
const hrefFor = (item) =>
  hasPhrases ? `/phrases/${item.slug}/` : `/translate/?q=${encodeURIComponent(item.phrase)}`;
---

<Layout title={title} description={description}>
  <header class="hero">
    <h1 class="hero-title">Common Morse Code Phrases</h1>
    <p class="muted hero-sub">
      Search, copy Morse instantly, and practice inside the translator.
      {hasPhrases ? " Each phrase also has its own page." : ""}
    </p>

    <div class="hero-actions">
      <a class="btn primary" href="/translate/">Open Translator</a>
      <a class="btn" href="/morse-code/a/">Learn Alphabet</a>
    </div>

    {!hasPhrases && (
      <p class="muted warn">
        Your <span class="k">data.phrases</span> list looks empty or not detected, so this page is showing a fallback list.
        Fix <span class="k">src/data/morse.json</span> to enable dedicated phrase pages.
      </p>
    )}
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="toprow">
      <div>
        <h2 style="margin:0;">Browse phrases</h2>
        <p class="muted" style="margin:6px 0 0;">
          Tip: click a phrase to open it (or open in translator if fallback mode).
        </p>
      </div>

      <div class="searchbox">
        <label class="muted" for="phraseSearch" style="font-size:12px;">Search</label>
        <input id="phraseSearch" type="search" placeholder="Type: SOS, help, love..." />
      </div>
    </div>

    <div class="pill-grid phrase-pills" id="phraseList" style="margin-top:12px;">
      {list.map((p) => (
        <a class="pill" href={hrefFor(p)} data-phrase={p.phrase.toLowerCase()}>
          {p.phrase}
        </a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Copy Morse quickly</h2>
      <p class="muted" style="margin:0;">Pick a phrase → copy its Morse.</p>
    </div>

    <div class="grid tool-grid" style="margin-top:12px;">
      <div>
        <label for="phraseSelect"><strong>Phrase</strong></label><br />
        <select id="phraseSelect" aria-label="Select a phrase">
          {list.map((p) => (
            <option value={p.phrase}>{p.phrase}</option>
          ))}
        </select>

        <p class="muted" style="margin-top:10px;">
          Practice link updates automatically.
        </p>
      </div>

      <div>
        <label for="phraseMorse"><strong>Morse</strong></label><br />
        <textarea id="phraseMorse" rows="4" readonly placeholder="Morse will appear here..."></textarea>

        <div class="tool-row" style="margin-top:10px;">
          <button id="copyMorse" type="button">Copy Morse</button>
          <a class="btn" id="practiceLink" href="/translate/">Practice in Translator</a>
        </div>

        <p class="muted" style="margin-top:10px;">
          Format: spaces between letters • “/” between words.
        </p>
      </div>
    </div>
  </section>

  <p class="muted" style="margin-top:16px;">
    Explore: <a href="/morse-code/a/">alphabet</a> • <a href="/morse-code/numbers/">numbers</a> • <a href="/morse-code/punctuation/">punctuation</a>
  </p>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)}></script>

  <script is:inline define:vars={{ map, hasPhrases }}>
    const select = document.getElementById("phraseSelect");
    const morseBox = document.getElementById("phraseMorse");
    const copyBtn = document.getElementById("copyMorse");
    const practiceLink = document.getElementById("practiceLink");
    const search = document.getElementById("phraseSearch");
    const listEl = document.getElementById("phraseList");

    function toMorse(text){
      const s = (text || "").toString().toUpperCase().trim();
      if (!s) return "";
      return s
        .split(/\s+/)
        .filter(Boolean)
        .map(w => w.split("").map(ch => (map?.[ch] || "")).filter(Boolean).join(" "))
        .join(" / ");
    }

    function refresh(){
      const phrase = (select?.value || "").toString();
      const morse = toMorse(phrase);
      if (morseBox) morseBox.value = morse;
      if (practiceLink) practiceLink.href = "/translate/?q=" + encodeURIComponent(phrase);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    select?.addEventListener("change", refresh);
    refresh();

    copyBtn?.addEventListener("click", async () => {
      const value = (morseBox?.value || "").toString();
      if (!value) return;

      const ok = await copyText(value);
      if (!ok) return;

      const old = copyBtn.textContent;
      copyBtn.textContent = "Copied ✓";
      setTimeout(() => (copyBtn.textContent = old), 1200);
    });

    // Search filter
    search?.addEventListener("input", () => {
      const q = (search.value || "").trim().toLowerCase();
      const pills = listEl?.querySelectorAll("a[data-phrase]");
      pills?.forEach((a) => {
        const text = a.getAttribute("data-phrase") || "";
        a.style.display = !q || text.includes(q) ? "" : "none";
      });
    });
  </script>

  <style>
    .hero { margin-top: 6px; }
    .hero-title { margin: 0 0 8px; }
    .hero-sub { margin: 0; max-width: 72ch; }
    .hero-actions { margin-top: 12px; display:flex; gap:10px; flex-wrap:wrap; }
    .warn { margin-top: 12px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; background: rgba(255,255,255,0.03); }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 10px 14px;
      border-radius: 999px;
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
      color: rgba(255,255,255,0.92);
      font-weight: 750;
    }
    .btn.primary{
      border-color: rgba(138,180,255,0.30);
      background: rgba(138,180,255,0.12);
    }
    .btn:hover{ opacity: .95; }

    .toprow{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap: 12px;
      flex-wrap:wrap;
    }
    .searchbox{
      min-width: min(360px, 100%);
    }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .tool-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .phrase-pills{
      max-height: 520px;
      overflow: auto;
      padding-right: 6px;
    }

    .pill{
      display:block;
      text-decoration:none;
      color: rgba(255,255,255,0.92);
      text-align:center;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      font-weight: 650;
    }
    .pill:hover{
      border-color: rgba(255,255,255,0.22);
      background: rgba(255,255,255,0.06);
    }

    /* Make the tool grid go 2-col earlier (feels better on laptop widths) */
    @media (min-width: 760px) {
      .tool-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</Layout>
