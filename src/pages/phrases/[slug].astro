---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// Small slugify (hoisted)
function slugify(input) {
  return String(input ?? "")
    .toLowerCase()
    .trim()
    .replace(/['"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80) || "phrase";
}

// Build map once
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// Parse phrases once (your JSON is pairs, but supports objects too)
const rawPhrases = data?.phrases ?? [];
const phraseList = Array.isArray(rawPhrases)
  ? (rawPhrases.length && Array.isArray(rawPhrases[0]))
    ? rawPhrases
        .map((row) => {
          const slug = row?.[0];
          const phrase = row?.[1];
          if (!slug || !phrase) return null;
          return { slug: String(slug), phrase: String(phrase) };
        })
        .filter(Boolean)
    : rawPhrases
        .map((p) => {
          if (!p) return null;
          const phrase = p.phrase ?? p.text ?? p.value ?? p.name;
          if (!phrase) return null;
          const slug = p.slug ?? slugify(phrase);
          return { slug: String(slug), phrase: String(phrase) };
        })
        .filter(Boolean)
  : [];

// ✅ MOST IMPORTANT PART: getStaticPaths does NOT call any external helper name
export function getStaticPaths() {
  return phraseList.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug, phrase: item.phrase },
  }));
}

const { slug: propSlug, phrase: propPhrase } = Astro.props;
const currentSlug = String(propSlug ?? Astro.params.slug ?? "");
const currentPhrase =
  String(propPhrase ?? phraseList.find((p) => p.slug === currentSlug)?.phrase ?? "").trim();

const safePhrase = currentPhrase || "(Unknown phrase)";
const morse = currentPhrase ? textToMorse(currentPhrase, map, " ") : "";

// SEO
const title = currentPhrase ? `${currentPhrase} in Morse code` : "Phrase in Morse code";
const description = currentPhrase
  ? `See how to write ${currentPhrase} in Morse code. Copy it instantly and practice with the translator.`
  : `See how to write common phrases in Morse code. Copy them instantly and practice.`;

const translatorHref = currentPhrase
  ? `/translate/?q=${encodeURIComponent(currentPhrase)}`
  : "/translate/";

const more = phraseList.filter((p) => p.slug !== currentSlug).slice(0, 24);

// JSON-LD (safe site fallback)
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  ...(currentPhrase ? [{ name: currentPhrase, url: `${site}/phrases/${currentSlug}/` }] : []),
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};
---

<Layout title={title} description={description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span aria-hidden="true" class="sep">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    {currentPhrase && (
      <>
        <span aria-hidden="true" class="sep">›</span>
        <span class="crumb-current">{currentPhrase}</span>
      </>
    )}
  </nav>

  <header class="hero">
    <h1 class="hero-title">
      {currentPhrase ? `${currentPhrase} in Morse code` : "Phrase in Morse code"}
    </h1>
    <p class="muted hero-sub">
      Copy the Morse translation instantly, then practice in the translator or explore more phrases.
    </p>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="phrase-row">
      <span class="chip">{safePhrase}</span>
      <span class="muted">→</span>
      <span class="chip chip-morse">{morse || "(not available)"}</span>
    </div>

    <div class="actions" style="margin-top:12px;">
      <button id="copy" type="button" disabled={!morse}>Copy Morse</button>
      <a class="nav-link" href={translatorHref}>Practice in translator</a>
      <a class="nav-link" href="/phrases/">Browse all phrases</a>
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">More common phrases</h2>
      <p class="muted" style="margin:0;">Tap any phrase to open it.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;" role="list">
      {more.map((item) => (
        <a role="listitem" href={`/phrases/${item.slug}/`}>{item.phrase}</a>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ morse }}>
    const btn = document.getElementById("copy");
    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch { return false; }
      }
    }

    btn?.addEventListener("click", async () => {
      const value = (morse || "").toString();
      if (!value) return;
      const ok = await copyText(value);
      if (!ok) return;
      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>

  <style>
    .hero { margin-top: 10px; }
    .hero-title { margin-bottom: 8px; }
    .hero-sub { margin-top: 0; max-width: 72ch; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size: 13px;
      opacity: .92;
      margin-top: 2px;
    }

    .crumb{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      padding: 6px 10px;
      border-radius: 999px;
      color: rgba(255,255,255,0.92);
    }

    .sep { opacity: .65; }

    .crumb-current{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.015);
      color: rgba(255,255,255,0.78);
    }

    .phrase-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }

    .chip-morse{
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .4px;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
  </style>
</Layout>
