---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

export function getStaticPaths() {
  return data.phrases.map(([slug, phrase]) => ({
    params: { slug },
    props: { phrase, slug },
  }));
}

const { phrase, slug } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

// Guard: ensure we always have a map and a phrase
const map = data?.morseMap ?? {};
const safePhrase = (phrase ?? "").toString();

// Convert using your existing util
const morse = textToMorse(safePhrase, map, " ");

const title = `${safePhrase} in Morse code`;
const description = `See how to write ${safePhrase} in Morse code. Copy it instantly and use it for learning and practice.`;

// Build “popular phrases” links from the same source of truth
const popular = (data?.phrases ?? []).slice(0, 18).map(([s, p]) => ({ slug: s, phrase: p }));

// Breadcrumb URLs
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  { name: safePhrase, url: `${site}/phrases/${slug}/` },
];

// Structured data: BreadcrumbList + FAQPage
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": crumbs.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": c.name,
    "item": c.url,
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How do you write ${safePhrase} in Morse code?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": morse
          ? `${safePhrase} in Morse code is ${morse}.`
          : `This phrase contains characters that may not be supported by the current Morse map.`,
      },
    },
    {
      "@type": "Question",
      "name": "How do you separate letters and words in Morse code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use spaces between letters and use “/” between words.",
      },
    },
  ],
};
---

<Layout title={title} description={description}>
  <!-- Breadcrumbs (visible) -->
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/phrases/">Phrases</a>
    <span aria-hidden="true">›</span>
    <span class="current">{safePhrase}</span>
  </nav>

  <header style="margin-top:10px;">
    <h1 style="margin-bottom:8px;">{safePhrase} in Morse code</h1>
    <p class="muted" style="margin-top:0; max-width: 72ch;">
      Copy the Morse translation instantly, then practice in the translator or explore more phrases.
    </p>
  </header>

  <section class="card" style="margin-top:16px;">
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <span class="k">{safePhrase}</span>
      <span class="muted">→</span>
      <span class="k">{morse || "(not available)"}</span>
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; align-items:center;">
      <button id="copy" type="button">Copy Morse</button>
      <a class="muted" href="/translate/" style="text-decoration:none;">Open translator</a>
      <a class="muted" href="/phrases/" style="text-decoration:none;">Browse all phrases</a>
    </div>

    <p class="muted" style="margin-top:12px;">
      Learning tip: start slow, focus on accuracy, then increase speed (WPM) gradually.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">More common phrases</h2>
    <div class="pill-grid" style="margin-top:12px;">
      {popular.map((item) => (
        <a href={`/phrases/${item.slug}/`}>{item.phrase}</a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>
    <p>
      <strong>How do you separate letters and words in Morse code?</strong><br />
      <span class="muted">Use spaces between letters and use “/” between words.</span>
    </p>
    <p>
      <strong>Can I decode Morse back to text?</strong><br />
      <span class="muted">Yes — paste Morse into the translator and click <span class="k">Morse → Text</span>.</span>
    </p>
  </section>

  <p class="muted" style="margin-top:16px">
    Explore:
    <a href="/morse-code/a/">alphabet</a> •
    <a href="/morse-code/numbers/">numbers</a> •
    <a href="/morse-code/punctuation/">punctuation</a> •
    <a href="/">home</a>
  </p>

  <!-- Copy button -->
  <script is:inline define:vars={{ morse }}>
    const btn = document.getElementById("copy");
    btn?.addEventListener("click", async () => {
      const value = (morse || "").toString();
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const old = btn.textContent;
        btn.textContent = "Copied ✓";
        setTimeout(() => (btn.textContent = old), 1200);
      } catch {}
    });
  </script>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)}></script>

  <style>
    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size: 13px;
      opacity: .92;
    }
    .crumbs a{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      padding: 6px 10px;
      border-radius: 999px;
      color: rgba(255,255,255,0.92);
    }
    .crumbs a:hover{
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.18);
    }
    .crumbs .current{
      color: rgba(255,255,255,0.78);
    }
  </style>
</Layout>
