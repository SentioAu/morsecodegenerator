---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// ------------------------------------------------------------
// ✅ Runtime helpers (NOT used by getStaticPaths)
// ------------------------------------------------------------
function slugify(input) {
  return (
    String(input ?? "")
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "phrase"
  );
}

function normalizePhraseList(raw) {
  const out = [];
  if (!Array.isArray(raw)) return out;

  // pairs: [slug, phrase]
  if (raw.length && Array.isArray(raw[0])) {
    for (const row of raw) {
      const sl = row?.[0];
      const ph = row?.[1];
      if (!sl || !ph) continue;
      out.push({ slug: String(sl), phrase: String(ph) });
    }
    return out;
  }

  // objects
  for (const p of raw) {
    if (!p) continue;
    const ph = p.phrase ?? p.text ?? p.value ?? p.name;
    if (!ph) continue;
    const sl = p.slug ?? slugify(ph);
    out.push({ slug: String(sl), phrase: String(ph) });
  }

  return out;
}

// ------------------------------------------------------------
// ✅ getStaticPaths (FULLY self-contained for Cloudflare build)
// ------------------------------------------------------------
export function getStaticPaths() {
  // Keep everything inside this function (Cloudflare-safe)
  function localSlugify(input) {
    return (
      String(input ?? "")
        .toLowerCase()
        .trim()
        .replace(/['"]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 80) || "phrase"
    );
  }

  // Widen to any[]: morse.json types `phrases` as [slug, phrase] pairs,
  // but this loader also accepts object entries ({slug, phrase|text|...}).
  const raw: any[] = data?.phrases ?? [];
  const items = [];

  if (Array.isArray(raw)) {
    // pairs: [slug, phrase]
    if (raw.length && Array.isArray(raw[0])) {
      for (const row of raw) {
        const sl = row?.[0];
        const ph = row?.[1];
        if (!sl || !ph) continue;
        items.push({ slug: String(sl), phrase: String(ph) });
      }
    } else {
      // objects
      for (const p of raw) {
        if (!p) continue;
        const ph = p.phrase ?? p.text ?? p.value ?? p.name;
        if (!ph) continue;
        const sl = p.slug ?? localSlugify(ph);
        items.push({ slug: String(sl), phrase: String(ph) });
      }
    }
  }

  if (!items.length) return [];

  return items.map((item) => ({
    params: { slug: item.slug },
    props: { phrase: item.phrase, slug: item.slug },
  }));
}

// ------------------------------------------------------------
// Map for rendering (normalized)
// ------------------------------------------------------------
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// ------------------------------------------------------------
// Page runtime
// ------------------------------------------------------------
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const { phrase: propPhrase, slug: propSlug } = Astro.props;

const slug = String(propSlug ?? Astro.params?.slug ?? "").trim();
const phrase = String(propPhrase ?? "").trim();

// Canonical must follow trailingSlash: "always"
const canonical = `${site}/phrases/${encodeURIComponent(slug)}/`;

const morse = phrase ? textToMorse(phrase, map, " ") : "";
const hasUnknown = morse.includes("?");

// Only index pages with valid phrase and clean output
const robots = phrase && morse && !hasUnknown ? "index,follow" : "noindex,follow";

const title = phrase ? `${phrase} in Morse code` : "Phrase in Morse code";
const description = phrase
  ? `See how to write ${phrase} in Morse code. Copy it instantly and practice with the translator.`
  : `See how to write common phrases in Morse code. Copy them instantly and practice.`;

const translatorHref = phrase
  ? `/translate/?q=${encodeURIComponent(phrase)}`
  : "/translate/";

// ---------------------------------------------------------------------
// Per-phrase breakdown + timing.
//
// These 56 pages were the thinnest indexable cluster on the site: 150-160
// words, of which almost all was navigation. 18 of them sit in GSC's
// "Crawled – currently not indexed", which is what that profile earns. The
// word pages (/{word}-in-morse-code/) carry a letter breakdown and are
// noticeably healthier, so this ports the same proven pattern rather than
// inventing filler.
//
// Everything here is computed from morse.json, so it stays correct if the
// data changes and it is genuinely unique per phrase.
// ---------------------------------------------------------------------
const breakdown = (phrase && morse && !hasUnknown)
  ? String(phrase).toUpperCase().split(/\s+/).filter(Boolean).map((word) => ({
      word,
      chars: word.split("").map((ch) => ({ ch, code: map[ch] || "" })).filter((x) => x.code),
    })).filter((w) => w.chars.length)
  : [];

const allChars = breakdown.flatMap((w) => w.chars);
const ditCount = allChars.reduce((n, c) => n + (c.code.match(/\./g) || []).length, 0);
const dahCount = allChars.reduce((n, c) => n + (c.code.match(/-/g) || []).length, 0);

// Duration in dot-units, using the standard spacing the whole site uses:
// dit 1, dah 3, intra-character gap 1, inter-character gap 3, word gap 7.
const totalUnits = (() => {
  if (!allChars.length) return 0;
  let units = 0;
  breakdown.forEach((w, wi) => {
    w.chars.forEach((c, ci) => {
      const symbols = c.code.split("");
      symbols.forEach((sym, si) => {
        units += sym === "-" ? 3 : 1;
        if (si < symbols.length - 1) units += 1;   // intra-character gap
      });
      if (ci < w.chars.length - 1) units += 3;      // letter gap
    });
    if (wi < breakdown.length - 1) units += 7;      // word gap
  });
  return units;
})();

// unit = 1200/wpm ms (site-wide convention, see CLAUDE.md §11)
const secondsAt = (wpm) => (totalUnits * (1200 / wpm)) / 1000;
const timings = [5, 13, 20].map((wpm) => ({ wpm, secs: secondsAt(wpm) }));

// Related phrases
const phraseList = normalizePhraseList(data?.phrases ?? []);
const related = phraseList.filter((p) => p.slug !== slug).slice(0, 10);

// Practice phrases block — every entry must exist in morse.json's phrases list
const practiceWords = [
  ["hello", "Hello"],
  ["help", "Help"],
  ["sos", "SOS"],
  ["yes", "Yes"],
  ["no", "No"],
  ["thank-you", "Thank you"],
  ["please", "Please"],
  ["good-morning", "Good morning"],
  ["good-night", "Good night"],
  ["i-love-you", "I love you"],
  ["im-safe", "I'm safe"],
  ["i-need-help", "I need help"],
];

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  ...(phrase ? [{ name: phrase, url: canonical }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    {phrase && (
      <>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{phrase}</span>
      </>
    )}
  </nav>

  <header class="page-hero">
    <p class="page-hero-kicker">Phrase · Copy · Practice</p>
    <h1 class="page-hero-title">{title}</h1>
    <p class="muted page-hero-sub">
      Copy the Morse translation, hear it played back, or open it in the translator.
      {!phrase ? " (This phrase wasn't found.)" : ""}
    </p>
  </header>

  {/* Big phrase → Morse showcase */}
  {phrase && morse ? (
    <section class="phrase-show">
      <div class="phrase-show-row">
        <span class="phrase-show-text">{phrase}</span>
        <svg class="phrase-show-arrow" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </div>
      <div class="phrase-show-morse mono" id="morseText">{morse}</div>
      <div id="rhythm" class="rhythm" aria-hidden="true"></div>

      {hasUnknown && (
        <p class="phrase-show-warn">
          Note: this output includes <span class="k">?</span> for unsupported characters.
        </p>
      )}

      <div class="phrase-show-actions">
        <button id="copy" type="button" class="primary-action" disabled={!morse || hasUnknown}>
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy Morse
        </button>
        <button id="play" type="button" class="ghost" disabled={!morse}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 3v18l14-9L5 3z"/></svg>
          Play
        </button>
        <a class="btn ghost" href={translatorHref}>Open in translator →</a>
      </div>
    </section>
  ) : (
    <section class="card">
      <p class="muted">This phrase isn't available. Try the <a href="/phrases/">phrase list</a> or the <a href="/translate/">translator</a>.</p>
    </section>
  )}

  {breakdown.length > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="page-hero-kicker">Letter by letter</p>
          <h2 class="section-title">How “{phrase}” is built</h2>
        </div>
        <p class="section-sub muted">
          {allChars.length} characters · {ditCount} dits · {dahCount} dahs
        </p>
      </div>
      <div class="ph-breakdown">
        {breakdown.map((w) => (
          <div class="ph-word">
            <p class="ph-word-label">{w.word}</p>
            <div class="ph-chars">
              {w.chars.map((c) => (
                <div class="ph-char">
                  <span class="ph-char-letter">{c.ch}</span>
                  <span class="ph-char-code mono">{c.code}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="muted ph-note">
        Each letter is separated by a gap three dot-units long, and each word by
        a gap of seven. That spacing is what keeps
        {" "}<span class="k">{allChars.map((c) => c.code).join("")}</span>{" "}
        readable as “{phrase}” instead of one run-on string — the most common
        reason hand-copied Morse decodes wrong. The
        {" "}<a href="/decoder/">decoder</a> shows the difference if you paste
        it with and without the gaps.
      </p>
    </section>
  )}

  {totalUnits > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="page-hero-kicker">Timing</p>
          <h2 class="section-title">How long “{phrase}” takes to send</h2>
        </div>
      </div>
      <div class="tablewrap">
        <table>
          <thead>
            <tr><th>Speed</th><th>Dot length</th><th>Time to send</th></tr>
          </thead>
          <tbody>
            {timings.map((t) => (
              <tr>
                <td><strong>{t.wpm} WPM</strong></td>
                <td class="k">{Math.round(1200 / t.wpm)} ms</td>
                <td>{t.secs < 10 ? t.secs.toFixed(1) : Math.round(t.secs)} seconds</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted ph-note">
        The whole phrase is {totalUnits} dot-units long including the gaps. 5 WPM
        is a beginner's copying speed, 13 WPM was the old US licence requirement,
        and 20 WPM is comfortable conversational CW. Work out any other speed
        with the <a href="/timing-calculator/">timing calculator</a>, or hear it
        at your own pace on the <a href="/practice/">practice trainer</a>.
      </p>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <div>
        <p class="page-hero-kicker">Practice words</p>
        <h2 class="section-title">Open any word as its own page</h2>
      </div>
      <p class="section-sub muted">Each word has its own Morse reference page.</p>
    </div>
    <div class="pill-grid">
      {practiceWords.map(([s, label]) => (
        <a href={`/phrases/${s}/`}>{label}</a>
      ))}
    </div>
    <p class="muted explore-row" style="margin-top: var(--s-4);">
      Browse more on <a href="/morse-code/words/">the words hub</a>.
    </p>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="section-head">
        <div>
          <p class="page-hero-kicker">Related phrases</p>
          <h2 class="section-title">Keep practicing</h2>
        </div>
      </div>
      <div class="phrase-grid">
        {related.map((p) => (
          <a class="phrase-card" href={`/phrases/${p.slug}/`}>
            <span class="phrase-name">{p.phrase}</span>
            <svg class="phrase-arrow" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        ))}
      </div>
    </section>
  )}

  <script is:inline define:vars={{ morse, hasUnknown }}>
    const copyBtn = document.getElementById("copy");
    const playBtn = document.getElementById("play");

    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch { return false; }
      }
    }

    copyBtn?.addEventListener("click", async () => {
      if (hasUnknown) return;
      const value = (morse || "").toString();
      if (!value) return;
      const ok = await copyText(value);
      if (!ok) return;
      const old = copyBtn.innerHTML;
      copyBtn.textContent = "Copied ✓";
      setTimeout(() => (copyBtn.innerHTML = old), 1200);
    });

    // --- Rhythm bar visualization ---
    const rhythmEl = document.getElementById("rhythm");
    let rhythmTimers = [];
    function clearRhythm() {
      rhythmTimers.forEach((id) => clearTimeout(id));
      rhythmTimers = [];
      if (rhythmEl) { rhythmEl.innerHTML = ""; rhythmEl.classList.remove("playing"); }
    }
    function renderRhythm(seq, wpm) {
      clearRhythm();
      if (!rhythmEl || !seq) return;
      const unit = 1200 / wpm;
      const cleaned = seq.replace(/[^.\-\/\s]/g, "").trim();
      if (!cleaned) return;
      const parts = cleaned.split(/\s+/);
      const segs = [];
      let offset = 0;
      for (const part of parts) {
        if (part === "/") { offset += unit * 7; continue; }
        for (const sym of part) {
          const dur = sym === "-" ? unit * 3 : unit;
          segs.push({ start: offset, dur, sym });
          offset += dur + unit;
        }
        offset += unit * 2;
      }
      const total = Math.max(offset, 1);
      for (const s of segs) {
        const el = document.createElement("span");
        el.className = "rhythm-seg" + (s.sym === "-" ? " dash" : " dot");
        el.style.left = `${(s.start / total) * 100}%`;
        el.style.width = `${(s.dur / total) * 100}%`;
        rhythmEl.appendChild(el);
        rhythmTimers.push(setTimeout(() => el.classList.add("on"), s.start));
        rhythmTimers.push(setTimeout(() => el.classList.remove("on"), s.start + s.dur));
      }
      rhythmEl.classList.add("playing");
      rhythmTimers.push(setTimeout(() => rhythmEl.classList.remove("playing"), total + 80));
    }

    // Inline audio playback (shares timing with the translator)
    let audioCtx;
    let stopFlag = false;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      // Browser autoplay policy may leave the context suspended until a
      // user gesture; resume on each access so the next play() works.
      if (audioCtx.state === "suspended") {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }
    async function playMorse(sequence, wpm) {
      if (!sequence) return;
      const ctx = getAudioCtx();
      const unit = 1200 / wpm;
      let t = ctx.currentTime + 0.05;
      const cleaned = sequence.replace(/[^.\-\/\s]/g, "").trim();
      if (!cleaned) return;
      const parts = cleaned.split(/\s+/);
      for (const part of parts) {
        if (stopFlag) return;
        if (part === "/") { t += (unit * 7) / 1000; continue; }
        for (const sym of part) {
          if (stopFlag) return;
          const dur = sym === "-" ? unit * 3 : unit;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.value = 600;
          gain.gain.setValueAtTime(0.001, t);
          gain.gain.exponentialRampToValueAtTime(0.18, t + 0.01);
          gain.gain.exponentialRampToValueAtTime(0.001, t + dur / 1000);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + dur / 1000);
          t += dur / 1000;
          t += unit / 1000;
        }
        t += (unit * 2) / 1000;
      }
    }

    playBtn?.addEventListener("click", async () => {
      stopFlag = false;
      const value = (morse || "").toString();
      if (!value) return;
      const old = playBtn.innerHTML;
      playBtn.textContent = "Playing…";
      renderRhythm(value, 18);
      await playMorse(value, 18);
      setTimeout(() => (playBtn.innerHTML = old), 600);
    });

    // Stop playback and release the AudioContext when the tab is hidden
    // or the page is unloaded. Prevents ghost audio in a backgrounded
    // tab and keeps the per-origin Web Audio budget clean.
    function teardownAudio() {
      stopFlag = true;
      if (audioCtx) { try { audioCtx.close(); } catch {} audioCtx = undefined; }
    }
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") teardownAudio();
    });
    window.addEventListener("pagehide", teardownAudio);
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .ph-breakdown{ display: grid; gap: var(--s-4); }
    .ph-word-label{
      font-weight: 600; margin: 0 0 var(--s-2);
      letter-spacing: .04em; color: var(--text-muted);
      font-size: var(--fs-sm); text-transform: uppercase;
    }
    .ph-chars{ display: flex; flex-wrap: wrap; gap: var(--s-2); }
    .ph-char{
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      min-width: 3.25rem; padding: var(--s-2) var(--s-3);
      border: 1px solid var(--line); border-radius: var(--r-md);
      background: var(--surface-2);
    }
    .ph-char-letter{ font-weight: 700; font-size: var(--fs-md); }
    .ph-char-code{ font-size: var(--fs-sm); color: var(--text-muted); white-space: nowrap; }
    .ph-note{ max-width: var(--content); margin-top: var(--s-4); line-height: 1.7; }
    /* Phrase showcase */
    .phrase-show{
      margin-top: var(--s-3);
      padding: var(--s-6);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-xl);
    }
    .phrase-show-row{
      display: flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .phrase-show-text{
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .phrase-show-arrow{ color: var(--text-subtle); }
    .phrase-show-morse{
      margin-top: var(--s-4);
      padding: var(--s-4);
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--accent);
      font-size: clamp(16px, 2.4vw, 22px);
      letter-spacing: 0.08em;
      word-break: break-all;
    }
    /* Rhythm bar */
    .rhythm{
      position: relative;
      margin-top: var(--s-3);
      height: 8px;
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      overflow: hidden;
      opacity: 0.35;
      transition: opacity .2s ease;
    }
    .rhythm.playing{ opacity: 1; }
    .rhythm-seg{
      position: absolute;
      top: 1px;
      bottom: 1px;
      border-radius: var(--r-pill);
      background: var(--text-subtle);
      transition: background .08s ease, box-shadow .08s ease, transform .08s ease;
    }
    .rhythm-seg.on{
      background: var(--accent);
      box-shadow: 0 0 0 1px var(--accent), 0 0 12px var(--accent-soft);
      transform: scaleY(1.15);
    }
    @media (prefers-reduced-motion: reduce){
      .rhythm-seg{ transition: none; }
      .rhythm-seg.on{ transform: none; }
    }

    .phrase-show-warn{
      margin-top: var(--s-3);
      font-size: var(--fs-sm);
      color: var(--warn);
    }
    .phrase-show-actions{
      margin-top: var(--s-5);
      display: flex;
      gap: var(--s-2);
      flex-wrap: wrap;
      align-items: center;
    }
    .phrase-show-actions button[disabled]{ opacity: 0.5; cursor: not-allowed; }

    /* Related phrase grid (matches the hub) */
    .phrase-grid{
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--s-2);
    }
    .phrase-card{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-4);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      color: var(--text);
      text-decoration: none;
      font-size: var(--fs-sm);
      font-weight: 500;
      transition: background .12s ease, border-color .12s ease, color .12s ease;
    }
    .phrase-card:hover{
      background: var(--surface-2);
      border-color: var(--accent-line);
      color: var(--accent);
      text-decoration: none;
    }
    .phrase-arrow{ flex-shrink: 0; color: var(--text-subtle); transition: color .12s ease, transform .12s ease; }
    .phrase-card:hover .phrase-arrow{ color: var(--accent); transform: translateX(2px); }
    .phrase-name{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  </style>
</Layout>
