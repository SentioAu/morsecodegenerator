---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// -------------------------
// Helpers
// -------------------------
function slugify(s) {
  return (
    String(s || "")
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "phrase"
  );
}

// Normalize morse map: uppercase keys, ignore " " key if present
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// Robust phrase parsing (supports:
// 1) [["sos","SOS"], ...]
// 2) [{slug:"sos", phrase:"SOS"}, ...]
// 3) [{slug:"sos", text:"SOS"}, ...]
const rawPhrases = data?.phrases;
let phrases = [];

if (Array.isArray(rawPhrases)) {
  if (rawPhrases.length && Array.isArray(rawPhrases[0])) {
    phrases = rawPhrases
      .map((row) => {
        const slug = row?.[0];
        const phrase = row?.[1];
        if (!slug || !phrase) return null;
        return { slug: String(slug), phrase: String(phrase) };
      })
      .filter(Boolean);
  } else {
    phrases = rawPhrases
      .map((p) => {
        if (!p) return null;
        const phrase = p.phrase ?? p.text ?? p.value ?? p.name;
        if (!phrase) return null;
        const slug = p.slug ?? slugify(phrase);
        return { slug: String(slug), phrase: String(phrase) };
      })
      .filter(Boolean);
  }
}

// Fallback phrases (so build + pages still work even if data.phrases is missing)
const fallback = [
  "SOS",
  "HELP",
  "MAYDAY",
  "EMERGENCY",
  "DANGER",
  "STOP",
  "WAIT",
  "COME HERE",
  "CALL ME",
  "CALL POLICE",
  "CALL AMBULANCE",
  "I NEED HELP",
  "I AM LOST",
  "WHERE ARE YOU",
  "I AM HERE",
  "MEET ME",
  "OK",
  "YES",
  "NO",
  "HELLO",
  "THANK YOU",
  "PLEASE",
  "SORRY",
  "I LOVE YOU",
].map((phrase) => ({ slug: slugify(phrase), phrase }));

const hasRealPhrases = phrases.length > 0;
const all = hasRealPhrases ? phrases : fallback;

// IMPORTANT: never reference external vars here; keep everything self-contained
export function getStaticPaths() {
  return all.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug, phrase: item.phrase, hasRealPhrases },
  }));
}

const { phrase, slug, hasRealPhrases: hasReal } = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const safePhrase = (phrase ?? "").toString().trim();
const morse = safePhrase ? textToMorse(safePhrase, map, " ") : "";

// SEO
const title = safePhrase ? `${safePhrase} in Morse code` : "Phrase in Morse code";
const description = safePhrase
  ? `See how to write ${safePhrase} in Morse code. Copy it instantly and use it for learning and practice.`
  : `See how to write common phrases in Morse code. Copy them instantly and practice.`;

// More phrases (exclude current)
const popular = all
  .filter((p) => p.slug !== slug)
  .slice(0, 24);

// Breadcrumb URLs
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  ...(safePhrase ? [{ name: safePhrase, url: `${site}/phrases/${slug}/` }] : []),
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: safePhrase
        ? `How do you write ${safePhrase} in Morse code?`
        : "How do you write a phrase in Morse code?",
      acceptedAnswer: {
        "@type": "Answer",
        text: morse
          ? `${safePhrase} in Morse code is ${morse}.`
          : `This phrase contains characters that may not be supported by the current Morse map.`,
      },
    },
    {
      "@type": "Question",
      name: "How do you separate letters and words in Morse code?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use spaces between letters and use “/” between words.",
      },
    },
  ],
};

const translatorHref = safePhrase
  ? `/translate/?q=${encodeURIComponent(safePhrase)}`
  : "/translate/";
---

<Layout title={title} description={description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span aria-hidden="true" class="sep">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    {safePhrase && (
      <>
        <span aria-hidden="true" class="sep">›</span>
        <span class="crumb-current">{safePhrase}</span>
      </>
    )}
  </nav>

  <header class="hero">
    <h1 class="hero-title">{safePhrase ? `${safePhrase} in Morse code` : "Phrase in Morse code"}</h1>
    <p class="muted hero-sub">
      Copy the Morse translation instantly, then practice in the translator or explore more phrases.
    </p>

    {!hasReal && (
      <p class="muted warn">
        Showing a fallback phrase list because <span class="k">data.phrases</span> is missing/empty in{" "}
        <span class="k">src/data/morse.json</span>. Add phrases there to fully control SEO phrase pages.
      </p>
    )}
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="phrase-row">
      <span class="chip">{safePhrase || "(unknown phrase)"}</span>
      <span class="muted">→</span>
      <span class="chip chip-morse">{morse || "(not available)"}</span>
    </div>

    <div class="actions" style="margin-top:12px;">
      <button id="copy" type="button" disabled={!morse}>Copy Morse</button>
      <a class="nav-link" href={translatorHref}>Open translator</a>
      <a class="nav-link" href="/phrases/">Browse all phrases</a>
    </div>

    <p class="muted" style="margin-top:12px;">
      Learning tip: start slow, focus on accuracy, then increase speed (WPM) gradually.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">More common phrases</h2>
      <p class="muted" style="margin:0;">Tap any phrase to open its page.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;" role="list">
      {popular.map((item) => (
        <a role="listitem" href={`/phrases/${item.slug}/`}>{item.phrase}</a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>
    <p>
      <strong>How do you separate letters and words in Morse code?</strong><br />
      <span class="muted">Use spaces between letters and use “/” between words.</span>
    </p>
    <p>
      <strong>Can I decode Morse back to text?</strong><br />
      <span class="muted">Yes — paste Morse into the translator and click <span class="k">Morse → Text</span>.</span>
    </p>
  </section>

  <p class="muted" style="margin-top:16px">
    Explore:
    <a href="/morse-code/a/">alphabet</a> •
    <a href="/morse-code/numbers/">numbers</a> •
    <a href="/morse-code/punctuation/">punctuation</a> •
    <a href="/">home</a>
  </p>

  <script is:inline define:vars={{ morse }}>
    const btn = document.getElementById("copy");

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    btn?.addEventListener("click", async () => {
      const value = (morse || "").toString();
      if (!value) return;

      const ok = await copyText(value);
      if (!ok) return;

      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)}></script>

  <style>
    .hero { margin-top: 10px; }
    .hero-title { margin-bottom: 8px; }
    .hero-sub { margin-top: 0; max-width: 72ch; }
    .warn { margin-top: 12px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; background: rgba(255,255,255,0.03); }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size: 13px;
      opacity: .92;
      margin-top: 2px;
    }

    .crumb{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      padding: 6px 10px;
      border-radius: 999px;
      color: rgba(255,255,255,0.92);
    }

    .crumb:hover{
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.18);
    }

    .sep { opacity: .65; }

    .crumb-current{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.015);
      color: rgba(255,255,255,0.78);
    }

    .phrase-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }

    .chip-morse{
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .4px;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
  </style>
</Layout>
