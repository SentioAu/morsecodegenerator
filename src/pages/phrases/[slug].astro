---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// ------------------------------------------------------------
// ✅ Hoisted helpers (Cloudflare-safe)
// ------------------------------------------------------------
function slugify(input) {
  return (
    String(input ?? "")
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "phrase"
  );
}

function normalizePhraseList(raw) {
  const out = [];
  if (!Array.isArray(raw)) return out;

  // pairs: [slug, phrase]
  if (raw.length && Array.isArray(raw[0])) {
    for (const row of raw) {
      const sl = row?.[0];
      const ph = row?.[1];
      if (!sl || !ph) continue;
      out.push({ slug: String(sl), phrase: String(ph) });
    }
    return out;
  }

  // objects
  for (const p of raw) {
    if (!p) continue;
    const ph = p.phrase ?? p.text ?? p.value ?? p.name;
    if (!ph) continue;
    const sl = p.slug ?? slugify(ph);
    out.push({ slug: String(sl), phrase: String(ph) });
  }

  return out;
}

// ------------------------------------------------------------
// ✅ getStaticPaths (pure, self-contained)
// ------------------------------------------------------------
export function getStaticPaths() {
  const list = normalizePhraseList(data?.phrases ?? []);
  if (!list.length) return [];

  return list.map((item) => ({
    params: { slug: item.slug },
    props: { phrase: item.phrase, slug: item.slug },
  }));
}

// ------------------------------------------------------------
// Map for rendering (normalized)
// ------------------------------------------------------------
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

// ------------------------------------------------------------
// Page runtime
// ------------------------------------------------------------
const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const { phrase: propPhrase, slug: propSlug } = Astro.props;

const slug = String(propSlug ?? Astro.params?.slug ?? "").trim();
const phrase = String(propPhrase ?? "").trim();

// Canonical must follow trailingSlash: "always"
const canonical = `${site}/phrases/${encodeURIComponent(slug)}/`;

const morse = phrase ? textToMorse(phrase, map, " ") : "";
const hasUnknown = morse.includes("?");

// Only index pages with valid phrase and clean output
const robots = phrase && morse && !hasUnknown ? "index,follow" : "noindex,follow";

const title = phrase ? `${phrase} in Morse code` : "Phrase in Morse code";
const description = phrase
  ? `See how to write ${phrase} in Morse code. Copy it instantly and practice with the translator.`
  : `See how to write common phrases in Morse code. Copy them instantly and practice.`;

const translatorHref = phrase
  ? `/translate/?q=${encodeURIComponent(phrase)}`
  : "/translate/";

// Related phrases
const phraseList = normalizePhraseList(data?.phrases ?? []);
const related = phraseList.filter((p) => p.slug !== slug).slice(0, 10);

// Practice words block
const practiceWords = [
  ["hello", "Hello"],
  ["help", "Help"],
  ["sos", "SOS"],
  ["yes", "Yes"],
  ["no", "No"],
  ["thank-you", "Thank you"],
  ["please", "Please"],
  ["good-morning", "Good morning"],
  ["good-night", "Good night"],
  ["i-love-you", "I love you"],
  ["im-safe", "I’m safe"],
  ["need-help", "Need help"],
];

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  ...(phrase ? [{ name: phrase, url: canonical }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};
---

<Layout title={title} description={description} robots={robots} canonical={canonical}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    {phrase && (
      <>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{phrase}</span>
      </>
    )}
  </nav>

  <header class="hero">
    <p class="muted kicker">Copy • Practice • Learn</p>

    <h1 class="hero-title">{title}</h1>

    <p class="muted hero-sub">
      Copy the Morse translation, then practice it in the translator.
      {!phrase ? " (This phrase wasn’t found.)" : ""}
    </p>

    <div class="hero-actions">
      <a class="btn primary" href={translatorHref}>Open in translator</a>
      <a class="btn" href="/phrases/">Browse all phrases</a>
      <a class="btn" href="/morse-code/">Learn hub</a>
      <a class="btn" href="/morse-code/words/">Practice words</a>
    </div>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="phrase-row">
      <span class="chip">{phrase || "(Unknown phrase)"}</span>
      <span class="muted">→</span>
      <span class="chip chip-morse">{morse || "(not available)"}</span>
    </div>

    {hasUnknown ? (
      <p class="muted" style="margin-top:10px;">
        Note: this output includes <span class="k">?</span> for unsupported characters.
      </p>
    ) : null}

    <div class="actions" style="margin-top:12px;">
      <button id="copy" type="button" disabled={!morse || hasUnknown}>Copy Morse</button>
      <a class="btn" href={translatorHref}>Practice</a>
      <a class="btn ghost" href="/translate/?q=SOS">Try SOS</a>
    </div>

    <p class="muted" style="margin-top:12px;">
      Format: spaces between letters • “/” between words.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">Practice words</h2>
      <p class="muted" style="margin:0;">Open a dedicated word page, or practice in the translator.</p>
    </div>

    <div class="pill-grid" style="margin-top:12px;" role="list">
      {practiceWords.map(([s, label]) => (
        <a role="listitem" href={`/${s}-in-morse-code/`}>{label}</a>
      ))}
    </div>

    <p class="muted" style="margin-top:10px;">
      Browse more on <a href="/morse-code/words/">the words hub</a>.
    </p>
  </section>

  {related.length > 0 && (
    <section class="card" style="margin-top:16px;">
      <div class="section-head">
        <h2 style="margin:0;">Related phrases</h2>
        <p class="muted" style="margin:0;">Keep practicing with these next.</p>
      </div>

      <div class="pill-grid" style="margin-top:12px;">
        {related.map((p) => (
          <a href={`/phrases/${p.slug}/`}>{p.phrase}</a>
        ))}
      </div>
    </section>
  )}

  <script is:inline define:vars={{ morse, hasUnknown }}>
    const btn = document.getElementById("copy");

    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch { return false; }
      }
    }

    btn?.addEventListener("click", async () => {
      if (hasUnknown) return;
      const value = (morse || "").toString();
      if (!value) return;
      const ok = await copyText(value);
      if (!ok) return;
      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <style>
    .hero { margin-top: 10px; }
    .kicker{ margin: 0 0 10px; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }
    .hero-title { margin-bottom: 8px; }
    .hero-sub { margin-top: 0; max-width: 72ch; }
    .hero-actions{ margin-top: 12px; display:flex; gap: 10px; flex-wrap:wrap; }

    .crumbs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size: 13px; opacity: .92; margin-top: 2px; }
    .crumb{ text-decoration:none; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.02); padding: 6px 10px; border-radius: 999px; color: rgba(255,255,255,0.92); }
    .sep { opacity: .65; }
    .crumb-current{ display:inline-flex; align-items:center; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.10); background: rgba(255,255,255,0.015); color: rgba(255,255,255,0.78); }

    .phrase-row{ display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
    .chip{ display:inline-flex; align-items:center; justify-content:center; padding: 8px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.92); font-weight: 650; }
    .chip-morse{ font-family: ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .4px; }

    .actions{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .section-head{ display:flex; flex-wrap:wrap; gap: 6px 14px; align-items: baseline; justify-content: space-between; }
  </style>
</Layout>
