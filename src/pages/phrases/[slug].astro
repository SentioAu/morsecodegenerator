---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

export function getStaticPaths() {
  return data.phrases.map(([slug, phrase]) => ({
    params: { slug },
    props: { phrase, slug },
  }));
}

const { phrase, slug } = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

// Guard: ensure we always have a map and a phrase
const map = data?.morseMap ?? {};
const safePhrase = (phrase ?? "").toString().trim();

// Convert using your existing util
const morse = textToMorse(safePhrase, map, " ");

const title = `${safePhrase} in Morse code`;
const description = `See how to write ${safePhrase} in Morse code. Copy it instantly and use it for learning and practice.`;

// Build “popular phrases” links from the same source of truth
const popular = (data?.phrases ?? [])
  .filter(([s]) => s !== slug) // avoid duplicating current page
  .slice(0, 20)
  .map(([s, p]) => ({ slug: s, phrase: p }));

// Breadcrumb URLs
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  { name: safePhrase, url: `${site}/phrases/${slug}/` },
];

// Structured data: BreadcrumbList + FAQPage
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `How do you write ${safePhrase} in Morse code?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: morse
          ? `${safePhrase} in Morse code is ${morse}.`
          : `This phrase contains characters that may not be supported by the current Morse map.`,
      },
    },
    {
      "@type": "Question",
      name: "How do you separate letters and words in Morse code?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use spaces between letters and use “/” between words.",
      },
    },
  ],
};

const translatorHref = `/translate/?q=${encodeURIComponent(safePhrase)}`;
---

<Layout title={title} description={description}>
  <!-- Breadcrumbs (visible) -->
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span aria-hidden="true" class="sep">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    <span aria-hidden="true" class="sep">›</span>
    <span class="crumb-current">{safePhrase}</span>
  </nav>

  <header class="hero">
    <h1 class="hero-title">{safePhrase} in Morse code</h1>
    <p class="muted hero-sub">
      Copy the Morse translation instantly, then practice in the translator or explore more phrases.
    </p>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="phrase-row">
      <span class="chip">{safePhrase}</span>
      <span class="muted">→</span>
      <span class="chip chip-morse">{morse || "(not available)"}</span>
    </div>

    <div class="actions" style="margin-top:12px;">
      <button id="copy" type="button">Copy Morse</button>
      <a class="btn ghost" href={translatorHref}>Open translator</a>
      <a class="btn ghost" href="/phrases/">Browse all phrases</a>
    </div>

    <p class="muted" style="margin-top:12px;">
      Learning tip: start slow, focus on accuracy, then increase speed (WPM) gradually.
    </p>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-head">
      <h2 style="margin:0;">More common phrases</h2>
      <p class="muted" style="margin:0;">Tap any phrase to open its page.</p>
    </div>

    <!-- IMPORTANT: explicit pill class + safe separators to prevent glued text if CSS ever fails -->
    <div class="pill-grid" style="margin-top:12px;" role="list">
      {popular.map((item) => (
        <>
          <a role="listitem" class="pill" href={`/phrases/${item.slug}/`}>{item.phrase}</a>{" "}
        </>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2 style="margin-top:0;">FAQ</h2>
    <p>
      <strong>How do you separate letters and words in Morse code?</strong><br />
      <span class="muted">Use spaces between letters and use “/” between words.</span>
    </p>
    <p>
      <strong>Can I decode Morse back to text?</strong><br />
      <span class="muted">Yes — paste Morse into the translator and click <span class="k">Morse → Text</span>.</span>
    </p>
  </section>

  <p class="muted" style="margin-top:16px">
    Explore:
    <a href="/morse-code/a/">alphabet</a> •
    <a href="/morse-code/numbers/">numbers</a> •
    <a href="/morse-code/punctuation/">punctuation</a> •
    <a href="/">home</a>
  </p>

  <!-- Copy button -->
  <script is:inline define:vars={{ morse }}>
    const btn = document.getElementById("copy");

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      }
    }

    btn?.addEventListener("click", async () => {
      const value = (morse || "").toString();
      if (!value) return;

      const ok = await copyText(value);
      if (!ok) return;

      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline>
    {JSON.stringify(breadcrumbJsonLd)}
  </script>
  <script type="application/ld+json" is:inline>
    {JSON.stringify(faqJsonLd)}
  </script>

  <style>
    .hero { margin-top: 10px; }
    .hero-title { margin-bottom: 8px; }
    .hero-sub { margin-top: 0; max-width: 72ch; }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size: 13px;
      opacity: .92;
      margin-top: 2px;
    }

    .crumb{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      padding: 6px 10px;
      border-radius: 999px;
      color: rgba(255,255,255,0.92);
    }

    .crumb:hover{
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.18);
    }

    .sep { opacity: .65; }

    .crumb-current{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.015);
      color: rgba(255,255,255,0.78);
    }

    .phrase-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }

    .chip-morse{
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .4px;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    /* CTA links (local only) */
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 10px 12px;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid rgba(138,180,255,0.35);
      background: rgba(138,180,255,0.14);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }
    .btn:hover{ opacity: .95; }
    .btn.ghost{
      border-color: rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.03);
    }

    /* Local pills (explicit, so we don’t depend on Layout’s pill-grid rules) */
    .pill-grid{
      display:grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    @media (min-width: 860px){
      .pill-grid{ grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }

    .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      text-decoration:none;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }
    .pill:hover{
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.20);
    }
  </style>
</Layout>
