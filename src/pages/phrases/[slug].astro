---
import Layout from "../../components/Layout.astro";
import data from "../../data/morse.json";
import { textToMorse } from "../../utils/morse";

// Hoisted helper (safe)
function slugify(input) {
  return String(input ?? "")
    .toLowerCase()
    .trim()
    .replace(/['"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80) || "phrase";
}

export function getStaticPaths() {
  // ✅ EVERYTHING defined locally (no hoisting traps)
  const rawPhrases = data?.phrases ?? [];
  let list = [];

  if (Array.isArray(rawPhrases)) {
    if (rawPhrases.length && Array.isArray(rawPhrases[0])) {
      // pairs: [slug, phrase]
      list = rawPhrases
        .map((row) => {
          const slug = row?.[0];
          const phrase = row?.[1];
          if (!slug || !phrase) return null;
          return { slug: String(slug), phrase: String(phrase) };
        })
        .filter(Boolean);
    } else {
      // objects: {slug, phrase} or variants
      list = rawPhrases
        .map((p) => {
          if (!p) return null;
          const phrase = p.phrase ?? p.text ?? p.value ?? p.name;
          if (!phrase) return null;
          const slug = p.slug ?? slugify(phrase);
          return { slug: String(slug), phrase: String(phrase) };
        })
        .filter(Boolean);
    }
  }

  return list.map((item) => ({
    params: { slug: item.slug },
    props: { phrase: item.phrase, slug: item.slug },
  }));
}

// Build map once for rendering
const rawMap = data?.morseMap ?? {};
const map = Object.fromEntries(
  Object.entries(rawMap)
    .filter(([k, v]) => k && v && k !== " ")
    .map(([k, v]) => [String(k).toUpperCase(), String(v)])
);

const { phrase: propPhrase, slug: propSlug } = Astro.props;
const slug = String(propSlug ?? Astro.params.slug ?? "");
const phrase = String(propPhrase ?? "").trim();

const morse = phrase ? textToMorse(phrase, map, " ") : "";

const title = phrase ? `${phrase} in Morse code` : "Phrase in Morse code";
const description = phrase
  ? `See how to write ${phrase} in Morse code. Copy it instantly and practice with the translator.`
  : `See how to write common phrases in Morse code. Copy them instantly and practice.`;

const translatorHref = phrase ? `/translate/?q=${encodeURIComponent(phrase)}` : "/translate/";

// Breadcrumb JSON-LD
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";
const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "Phrases", url: `${site}/phrases/` },
  ...(phrase ? [{ name: phrase, url: `${site}/phrases/${slug}/` }] : []),
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};
---

<Layout title={title} description={description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="crumb" href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a class="crumb" href="/phrases/">Phrases</a>
    {phrase && (
      <>
        <span class="sep" aria-hidden="true">›</span>
        <span class="crumb-current">{phrase}</span>
      </>
    )}
  </nav>

  <header class="hero">
    <h1 class="hero-title">{title}</h1>
    <p class="muted hero-sub">
      Copy the Morse translation instantly, then practice in the translator.
    </p>
  </header>

  <section class="card" style="margin-top:16px;">
    <div class="phrase-row">
      <span class="chip">{phrase || "(Unknown phrase)"}</span>
      <span class="muted">→</span>
      <span class="chip chip-morse">{morse || "(not available)"}</span>
    </div>

    <div class="actions" style="margin-top:12px;">
      <button id="copy" type="button" disabled={!morse}>Copy Morse</button>
      <a class="nav-link" href={translatorHref}>Practice in translator</a>
      <a class="nav-link" href="/phrases/">Browse all phrases</a>
    </div>
  </section>

  <script is:inline define:vars={{ morse }}>
    const btn = document.getElementById("copy");
    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch { return false; }
      }
    }

    btn?.addEventListener("click", async () => {
      const value = (morse || "").toString();
      if (!value) return;
      const ok = await copyText(value);
      if (!ok) return;
      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1200);
    });
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>

  <style>
    .hero { margin-top: 10px; }
    .hero-title { margin-bottom: 8px; }
    .hero-sub { margin-top: 0; max-width: 72ch; }

    .crumbs{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
      font-size: 13px;
      opacity: .92;
      margin-top: 2px;
    }

    .crumb{
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.02);
      padding: 6px 10px;
      border-radius: 999px;
      color: rgba(255,255,255,0.92);
    }

    .sep { opacity: .65; }

    .crumb-current{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.015);
      color: rgba(255,255,255,0.78);
    }

    .phrase-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
      color: rgba(255,255,255,0.92);
      font-weight: 650;
    }

    .chip-morse{
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .4px;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
  </style>
</Layout>
