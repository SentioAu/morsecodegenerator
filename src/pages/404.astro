---
import Layout from "../components/Layout.astro";

const title = "Page not found (404)";
const description = "The page you requested does not exist.";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const canonical = `${site}/404/`;

// Keep 404 out of index; allow bots to follow links out
const robots = "noindex,follow";

const crumbs = [
  { name: "Home", url: `${site}/` },
  { name: "404", url: canonical },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: "Morse Code Generator", url: site },
    },
  ],
};

// Popular, canonical recovery links
const quickLinks = [
  { href: "/translate/", label: "Open translator" },
  { href: "/morse-code/", label: "Learn Morse" },
  { href: "/morse-code/numbers/", label: "Numbers (0–9)" },
  { href: "/morse-code/punctuation/", label: "Punctuation" },
  { href: "/morse-code/words/", label: "Words A–Z" },
  { href: "/phrases/", label: "Common phrases" },
  { href: "/phrases/sos/", label: "SOS" },
];
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <!-- Help crawlers treat this as a real 404 page (plus stable social URL) -->
  <head>
    <meta property="og:url" content={canonical} />
    <meta name="twitter:url" content={canonical} />
  </head>

  <header class="hero">
    <p class="muted kicker">404 · <span class="k" aria-hidden="true">....- ----- ....-</span></p>
    <h1 class="title">Page not found</h1>
    <p class="muted sub">
      That URL doesn’t exist (or it moved). Use the quick tools below to recover fast.
    </p>

    <div class="actions">
      <a class="btn" href="/translate/">Open translator</a>
      <a class="btn ghost" href="/morse-code/">Learn Morse</a>
      <a class="btn ghost" href="/phrases/">Common phrases</a>
      <a class="btn ghost" href="/">Homepage</a>
    </div>
  </header>

  <section class="card recovery-card">
    <h2 class="recovery-card-h">Translate anything right now</h2>

    <form id="search" class="search" autocomplete="off">
      <label class="muted recovery-label" for="q">
        Paste text (or Morse) and we’ll open the translator.
      </label>

      <div class="row">
        <input
          id="q"
          name="q"
          type="text"
          inputmode="text"
          maxlength="5000"
          placeholder="Example: SOS or HELLO or ... --- ..."
          aria-label="Enter text or Morse to open the translator"
        />
        <button type="submit">Open</button>
      </div>

      <p class="muted recovery-tip">
        Tip: Words are separated by <span class="k">/</span> in our Morse format.
      </p>
    </form>
  </section>

  <section class="card recovery-card">
    <div class="section-head">
      <h2 class="recovery-card-h tight">Popular pages</h2>
      <p class="muted tight">Canonical links that always work.</p>
    </div>

    <div class="pill-grid recovery-grid">
      {quickLinks.map((x) => (
        <a href={x.href}>{x.label}</a>
      ))}
    </div>

    <p class="muted recovery-foot">
      If you found a broken link, please report it on the <a href="/contact/">contact page</a>.
    </p>
  </section>

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (function () {
      const form = document.getElementById("search");
      const input = document.getElementById("q");

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const q = (input?.value || "").trim();
        const url = q ? `/translate/?q=${encodeURIComponent(q)}` : "/translate/";
        window.location.href = url;
      });
    })();
  </script>

  <style>
    .hero{ margin-top: var(--s-1); }
    .kicker{
      margin: 0 0 var(--s-3);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: var(--fs-xs);
    }
    .title{ margin: 0 0 var(--s-3); }
    .sub{ margin: 0; max-width: var(--content); }

    /* Recovery cards stack under the hero. */
    .recovery-card{ margin-top: var(--s-4); }
    .recovery-card-h{ margin: 0 0 var(--s-3); }
    .recovery-card-h.tight{ margin: 0; }
    .tight{ margin: 0; }
    .recovery-label{ display: block; margin: 0 0 var(--s-2); }
    .recovery-tip{ margin: var(--s-3) 0 0; }
    .recovery-grid{ margin-top: var(--s-3); }
    .recovery-foot{ margin-top: var(--s-3); }

    .actions{
      margin-top: var(--s-4);
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      align-items: center;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 10px 14px;
      border-radius: 999px;
      text-decoration:none;
      border: 1px solid var(--line);
      background: var(--surface-2);
      color: var(--text);
      font-weight: 800;
      line-height: 1;
    }
    .btn.ghost{
      border-color: var(--line);
      background: var(--surface-2);
      font-weight: 750;
    }

    .section-head{
      display:flex;
      flex-wrap:wrap;
      gap: 6px 14px;
      align-items: baseline;
      justify-content: space-between;
    }

    .row{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }
    .row input{
      flex: 1 1 320px;
      min-width: 220px;
    }

    @media (max-width: 600px){
      .actions > a{ width:100%; justify-content:center; }
      .row > *{ width:100%; }
    }
  </style>
</Layout>
