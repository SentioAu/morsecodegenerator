---
const {
  title = "Morse Code Generator",
  description = "Translate text to Morse code instantly, learn the alphabet, and practice common phrases.",
  robots = "index,follow",
} = Astro.props;

// Keep email available for the /contact page (do NOT use mailto in header nav)
const CONTACT_EMAIL = "morsecodegenerator@gmail.com";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const path = Astro.url.pathname || "/";

// Canonical must follow trailingSlash: "always"
const normalizedPath =
  path === "/" ? "/" : path.endsWith("/") ? path : `${path}/`;

const canonical = `${site}${normalizedPath}`;

// Active nav helper
const isActive = (href) => {
  const p = (normalizedPath || "/").replace(/\/$/, "") || "/";
  const h = (href || "/").replace(/\/$/, "") || "/";
  return p === h || (h !== "/" && p.startsWith(h));
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}#org`,
      name: "MorseCodeGenerator.com",
      url: site,
      // Intentionally omit "email" to avoid Cloudflare email-protection rewriting issues
    },
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: "Morse Code Generator",
      publisher: { "@id": `${site}#org` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${site}/translate/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Typography (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Morse Code Generator" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="application-name" content="Morse Code Generator" />
    <meta name="theme-color" content="#0b0b0b" />
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>

    <!-- Google AdSense (loader only) -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7616383336440831"
      crossorigin="anonymous"
    ></script>

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1K9JZ9ZQ2L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1K9JZ9ZQ2L', { anonymize_ip: true });
    </script>
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="MorseCodeGenerator.com home">
          <span class="brand-mark" aria-hidden="true">·–</span>
          <span class="brand-text">MorseCodeGenerator.com</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a
            class:list={["nav-link", isActive("/translate/") && "active"]}
            href="/translate/"
            aria-current={isActive("/translate/") ? "page" : undefined}
          >Translate</a>

          <a
            class:list={["nav-link", isActive("/morse-code/") && "active"]}
            href="/morse-code/a/"
            aria-current={isActive("/morse-code/") ? "page" : undefined}
          >Alphabet</a>

          <a
            class:list={["nav-link", isActive("/phrases/") && "active"]}
            href="/phrases/"
            aria-current={isActive("/phrases/") ? "page" : undefined}
          >Phrases</a>

          <a
            class:list={["nav-link", isActive("/about/") && "active"]}
            href="/about/"
            aria-current={isActive("/about/") ? "page" : undefined}
          >About</a>

          <!-- ✅ Never mailto in header nav on Cloudflare Pages -->
          <a
            class:list={["nav-link", isActive("/contact/") && "active", "contact"]}
            href="/contact/"
            aria-current={isActive("/contact/") ? "page" : undefined}
          >Contact</a>
        </nav>
      </div>
    </header>

    <main id="content" class="wrap main-wrap">
      <div class="panel">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap foot-inner">
        <small class="foot-text">
          © {new Date().getFullYear()} MorseCodeGenerator.com • Free Morse translator, references & learning tools
        </small>

        <small class="foot-brand">
          Project by
          <a href="https://sentioaurum.com/" target="_blank" rel="noopener noreferrer">SentioAurum</a>
        </small>
      </div>
    </footer>

    <style>
      :root{
        color-scheme: dark;

        --bg: #0b0b0b;
        --bg2: rgba(255,255,255,0.02);

        --panel: rgba(255,255,255,0.045);
        --panel2: rgba(255,255,255,0.02);

        --border: rgba(255,255,255,0.11);
        --border2: rgba(255,255,255,0.16);

        --text: rgba(255,255,255,0.94);
        --muted: rgba(255,255,255,0.74);

        --accent: #8ab4ff;
        --accentBg: rgba(138,180,255,0.14);

        --shadow: 0 14px 40px rgba(0,0,0,0.45);

        --contentMax: 74ch;
        --focus: rgba(138,180,255,0.55);

        --radius-xl: 24px;
        --radius-lg: 18px;
      }

      *{ box-sizing:border-box; }
      html, body{ height:100%; }
      html{ overflow-x: clip; }
      body{ overflow-x: clip; }

      body{
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        margin:0;
        line-height:1.65;
        background:
          radial-gradient(1200px 600px at 50% -10%, rgba(138,180,255,0.11), transparent 60%),
          radial-gradient(900px 500px at 90% 30%, rgba(138,180,255,0.06), transparent 55%),
          var(--bg);
        color: var(--text);
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        min-height: 100vh;
        display:flex;
        flex-direction:column;
      }

      .skip{
        position:absolute;
        left:-9999px;
        top:auto;
        width:1px;height:1px;
        overflow:hidden;
      }
      .skip:focus{
        left: 14px;
        top: 14px;
        width:auto;height:auto;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0,0,0,0.75);
        border: 1px solid var(--border);
        z-index: 999;
      }

      h1,h2,h3{ line-height:1.18; letter-spacing:-0.012em; margin:0 0 10px; }
      h1{ font-size: clamp(30px, 3.1vw, 44px); }
      h2{ font-size: clamp(20px, 2.0vw, 28px); margin-top: 22px; }
      h3{ font-size: 16px; margin-top: 12px; }

      p{ margin:10px 0; }
      ol, ul{ margin:10px 0 0; }
      li{ margin:6px 0; }
      p,ol,ul{ max-width: var(--contentMax); }

      a{ color: var(--accent); text-underline-offset: 3px; }
      a:hover{ opacity:0.92; }

      .wrap{
        width:100%;
        max-width: 1120px;
        margin-left:auto;
        margin-right:auto;
        padding: 18px;
      }

      .site-header{
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(12px);
        background: rgba(11,11,11,0.70);
        border-bottom: 1px solid var(--border);
      }

      .header-inner{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: 14px;
      }

      .brand{
        display:inline-flex;
        align-items:center;
        gap: 10px;
        text-decoration:none;
        color: var(--text);
        font-weight: 850;
        white-space: nowrap;
        letter-spacing: -0.01em;
      }

      .brand-mark{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.03);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 14px;
      }

      .nav{
        display:flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content:flex-end;
        align-items:center;
      }

      .nav-link{
        text-decoration:none;
        color: var(--text);
        padding: 9px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.025);
        font-weight: 700;
        transition: background .12s ease, border-color .12s ease, transform .12s ease;
      }
      .nav-link:hover{
        border-color: rgba(255,255,255,0.20);
        background: rgba(255,255,255,0.055);
      }
      .nav-link:active{ transform: translateY(1px); }

      .nav-link.active{
        border-color: rgba(138,180,255,0.32);
        background: rgba(138,180,255,0.10);
      }
      .nav-link.contact{
        border-color: rgba(138,180,255,0.30);
        background: rgba(138,180,255,0.10);
      }

      .main-wrap{
        flex: 1;
        display:flex;
        justify-content:center;
        padding-top: 18px;
        padding-bottom: 18px;
      }

      .panel{
        width:100%;
        background: linear-gradient(to bottom, var(--panel), var(--panel2));
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
        padding: 26px;
        overflow:hidden;
      }

      /* Normalize all form controls */
      textarea, input, select, button{
        font-family: inherit;
        font-size: 16px;
        line-height: 1.45;
      }

      textarea, input, select{
        width:100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border2);
        background: rgba(0,0,0,0.18);
        color: var(--text);
        outline:none;
      }

      textarea{
        resize: none;
        min-height: 180px;
      }

      textarea::placeholder, input::placeholder{
        color: rgba(255,255,255,0.50);
      }

      /* Crisp for dots/dashes */
      #mcg-input, #mcg-output{
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .2px;
      }

      select{
        appearance:none;
        -webkit-appearance:none;
        -moz-appearance:none;
        padding-right:36px;
        background-image:
          linear-gradient(45deg, transparent 50%, rgba(255,255,255,0.65) 50%),
          linear-gradient(135deg, rgba(255,255,255,0.65) 50%, transparent 50%);
        background-position:
          calc(100% - 18px) calc(50% - 3px),
          calc(100% - 12px) calc(50% - 3px);
        background-size: 6px 6px, 6px 6px;
        background-repeat:no-repeat;
      }

      select option{
        background: #0b0b0b;
        color: rgba(255,255,255,0.92);
      }

      textarea:focus, input:focus, select:focus, button:focus, a.nav-link:focus{
        box-shadow: 0 0 0 3px var(--focus);
        border-color: rgba(138,180,255,0.38);
      }

      button{
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid rgba(138,180,255,0.35);
        background: var(--accentBg);
        color: var(--text);
        cursor:pointer;
        font-weight: 800;
        transition: opacity .12s ease, transform .12s ease;
      }
      button:hover{ opacity:0.95; }
      button:active{ transform: translateY(1px); }

      .card{
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 16px;
        background: rgba(255,255,255,0.02);
      }

      .grid{
        display:grid;
        grid-template-columns: 1fr;
        gap: 14px;
        align-items: start;
      }
      @media (min-width: 900px){
        .grid{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
      }

      .muted{ color: var(--muted); }
      .k{ font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

      .pill-grid{
        display:grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        list-style:none;
        padding:0;
        margin:0;
      }
      @media (min-width: 900px){
        .pill-grid{ grid-template-columns: repeat(4, minmax(0,1fr)); }
      }

      .pill-grid a{
        display:block;
        text-decoration:none;
        color: var(--text);
        text-align:center;
        padding: 10px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.02);
        font-weight: 700;
        transition: background .12s ease, border-color .12s ease, transform .12s ease;
      }
      .pill-grid a:hover{
        border-color: rgba(255,255,255,0.22);
        background: rgba(255,255,255,0.06);
      }
      .pill-grid a:active{ transform: translateY(1px); }

      .site-footer{
        border-top: 1px solid var(--border);
        margin-top: 10px;
        padding-bottom: 26px;
      }

      .foot-inner{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: 12px;
      }
      .foot-text{ color: rgba(255,255,255,0.70); }
      .foot-brand{ color: rgba(255,255,255,0.70); white-space: nowrap; }
      .foot-brand a{ color: var(--accent); text-decoration:none; }
      .foot-brand a:hover{ opacity:0.92; text-decoration: underline; }

      @media (max-width: 820px){
        .wrap{ padding: 14px; }
        .panel{ padding: 18px; }
        .header-inner{ flex-direction: column; align-items: flex-start; }
        .nav{ justify-content:flex-start; width:100%; }
        .nav-link{ padding: 9px 11px; }
        p, ol, ul{ max-width: 100%; }
        .foot-inner{ flex-direction: column; align-items: flex-start; }
        .foot-brand{ white-space: normal; }
      }
    </style>
  </body>
</html>
