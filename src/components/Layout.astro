---
import { ogUrlForPath } from "../data/og-pages.js";

// Self-hosted fonts (privacy: no visitor IP sent to Google's font CDN —
// consistent with our Consent Mode posture — and no render-blocking
// third-party request). @fontsource ships font-display: swap. Weights
// match the old Google Fonts request: Inter 400/500/700/800, Space
// Grotesk 600/700. Mono stays system-only.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";

const {
  title = "Morse Code Generator",
  description = "Translate text to Morse code instantly, learn the alphabet, and practice common phrases.",
  robots = "index,follow",
  canonical: canonicalProp,
  ogType = "website",
  keywords,
  publishedTime,
  modifiedTime,
  prevUrl,
  nextUrl,
  // i18n: pages with a localized URL (e.g. /es/...) set `lang` to force
  // the document language, and `alternates` to declare cross-language
  // hreflang siblings: [{ lang: "en", href }, { lang: "es", href }].
  lang: langProp,
  alternates,
} = Astro.props;

const CONTACT_EMAIL = "morsecodegenerator@gmail.com";

// Donation / sponsor link — env-driven so we can swap providers (Ko-fi,
// Buy Me a Coffee, GitHub Sponsors) without code changes. When unset the
// footer link points to the affiliate-disclosure page's "Support" anchor,
// which itself explains how to help if no donation channel is open.
const DONATE_URL =
  import.meta.env.DONATE_URL || "https://ko-fi.com/sentioaurum";

// Analytics + ads IDs are env-configurable so the owner can point them at
// their OWN Google properties without a code edit. Defaults are the
// project's existing IDs (kept for backward compatibility). Set GA4_ID
// (e.g. "G-XXXXXXX") and ADSENSE_CLIENT ("ca-pub-…") on Cloudflare Pages.
const GA4_ID = import.meta.env.GA4_ID || "G-1K9JZ9ZQ2L";
const ADSENSE_CLIENT = import.meta.env.ADSENSE_CLIENT || "ca-pub-7616383336440831";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const path = Astro.url.pathname || "/";

// Canonical must follow trailingSlash: "always"
const normalizedPath =
  path === "/" ? "/" : path.endsWith("/") ? path : `${path}/`;

// Open Graph image — per-page PNG when the page is in the curated set
// (see src/data/og-pages.js), otherwise the static brand SVG. PNG is
// preferred by Twitter/Facebook/LinkedIn; SVG works elsewhere.
const ogRelativeUrl = ogUrlForPath(normalizedPath);
const ogImageUrl = ogRelativeUrl ? `${site}${ogRelativeUrl}` : `${site}/og-image.svg`;
const ogImageType = ogRelativeUrl ? "image/png" : "image/svg+xml";

// Default canonical (auto)
const canonicalAuto = `${site}${normalizedPath}`;

// Final canonical (page override wins)
const canonical = String(canonicalProp || canonicalAuto);

// Locale handling. A `lang` prop (set by /es/ pages) wins; otherwise we
// honour the legacy ?lang=es query param used on /translate/.
const lang = (langProp || Astro.url.searchParams.get("lang") || "en").toLowerCase();
const htmlLang = lang === "es" ? "es" : "en";
const ogLocale = htmlLang === "es" ? "es_ES" : "en_US";
const ogLocaleAlt = htmlLang === "es" ? "en_US" : "es_ES";

// hreflang alternates.
//  - Preferred: an explicit `alternates` prop with real localized URLs
//    (used by the /es/ pages, each pointing at its EN sibling and back).
//  - Legacy fallback: /translate/ still advertises its ?lang=es variant.
// Everywhere else we emit nothing, so Google never sees a soft-404 ES URL.
const explicitAlternates = Array.isArray(alternates) && alternates.length > 0;
const hasEsVersion = !explicitAlternates && /\/translate\/?$/.test(normalizedPath);
const hrefEn = canonical.replace(/[?&]lang=es/, "");
const hrefEs = canonical.includes("?")
  ? canonical.replace(/([?&])lang=[a-z]{2}/i, "") + (canonical.includes("?lang=") ? "" : "&lang=es")
  : `${canonical}?lang=es`;

// Active nav helper
const isActive = (href) => {
  const p = (normalizedPath || "/").replace(/\/$/, "") || "/";
  const h = (href || "/").replace(/\/$/, "") || "/";
  return p === h || (h !== "/" && p.startsWith(h));
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}#org`,
      name: "MorseCodeGenerator.com",
      alternateName: ["Morse Code Generator", "MorseGen"],
      url: site,
      email: CONTACT_EMAIL,
      logo: {
        "@type": "ImageObject",
        url: `${site}/favicon.svg`,
        width: 512,
        height: 512,
      },
      sameAs: ["https://sentioaurum.com/"],
    },
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: "Morse Code Generator",
      description: "The hub of Morse code: translator, learning tools, audio practice, and reference.",
      inLanguage: ["en", "es"],
      publisher: { "@id": `${site}#org` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${site}/translate/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site}#app`,
      name: "Morse Code Translator",
      applicationCategory: "EducationalApplication",
      operatingSystem: "Any (web browser)",
      url: `${site}/translate/`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: [
        "Text to Morse code conversion",
        "Morse to text decoding",
        "Audio playback (Web Audio)",
        "Adjustable speed (10–30 WPM)",
        "Koch-method practice",
        "Shareable links",
      ],
      /*
        We intentionally do NOT emit aggregateRating here. Google's
        structured-data guidelines require ratings to be backed by
        publicly-visible reviews on the page (Trustpilot, App Store,
        a real <Review> list, etc.). Emitting a hard-coded
        ratingValue/ratingCount without that backing risks a manual
        action that would strip rich results across the whole site.
        Re-introduce only once we render real reviews on /translate/
        and reference them via @id here.
      */
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="author" content="MorseCodeGenerator.com" />
    <meta name="generator" content="Astro" />

    {/*
      Search-console / webmaster verification tags.
      Each meta is emitted only when the corresponding env var is set on the
      build host (e.g. Cloudflare Pages → Environment variables). They never
      leak through git. See /integrations/ for setup instructions.
    */}
    {import.meta.env.GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.BING_SITE_VERIFICATION} />
    )}
    {import.meta.env.YANDEX_VERIFICATION && (
      <meta name="yandex-verification" content={import.meta.env.YANDEX_VERIFICATION} />
    )}
    {import.meta.env.PINTEREST_VERIFICATION && (
      <meta name="p:domain_verify" content={import.meta.env.PINTEREST_VERIFICATION} />
    )}
    {import.meta.env.FACEBOOK_DOMAIN_VERIFICATION && (
      <meta name="facebook-domain-verification" content={import.meta.env.FACEBOOK_DOMAIN_VERIFICATION} />
    )}

    {/* hreflang — explicit localized siblings (e.g. EN ⇄ ES /es/ pages) */}
    {explicitAlternates && (
      <>
        {alternates.map((a) => (
          <link rel="alternate" href={a.href} hreflang={a.lang} />
        ))}
        <link rel="alternate" href={(alternates.find((a) => a.lang === "en") || alternates[0]).href} hreflang="x-default" />
      </>
    )}

    {/* hreflang — legacy ?lang=es variant on /translate/ */}
    {hasEsVersion && (
      <>
        <link rel="alternate" href={hrefEn} hreflang="en" />
        <link rel="alternate" href={hrefEs} hreflang="es" />
        <link rel="alternate" href={hrefEn} hreflang="x-default" />
      </>
    )}

    {/* Favicon + PWA — favicon.ico can be added later; SVG covers all modern browsers */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- AI / agent discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs map (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full content for LLMs" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="MorseCodeGenerator.com Blog (RSS)" />

    <!-- Typography: Inter + Space Grotesk are self-hosted (imported in the
         frontmatter) — no third-party font CDN, no visitor-IP leak, no
         render-blocking external request. -->
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Preload core data so tools start fast -->
    <link rel="preload" as="fetch" href="/morse.json" type="application/json" crossorigin="anonymous" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Morse Code Generator" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Morse Code Generator preview banner" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="application-name" content="Morse Code Generator" />
    <meta name="apple-mobile-web-app-title" content="MorseGen" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />

    <!-- ✅ JSON-LD must be unescaped -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>

    {/*
      Analytics + AdSense — gated behind cookie consent.

      Behaviour:
       - On first visit `localStorage["mcg-consent"]` is missing → banner
         renders, NO third-party scripts load.
       - If the visitor clicks "Accept all", consent flips to "all", the
         loader fires, GA4 + AdSense are injected, and any rendered
         <ins class="adsbygoogle"> elements get `(adsbygoogle = ...).push({})`
         so they fill.
       - If they click "Essential only", consent flips to "essential" and
         loaders are skipped on every subsequent visit.

      The banner script (further down in <body>) dispatches a
      `mcg:consent` CustomEvent({detail:"all"|"essential"}) when the
      visitor decides. We listen for that event AND check
      localStorage on boot so cross-tab decisions are respected too.
    */}
    <script is:inline define:vars={{ GA4_ID, ADSENSE_CLIENT }}>
      (function () {
        function consent() {
          try { return localStorage.getItem("mcg-consent"); } catch (e) { return null; }
        }

        // ---- Google Consent Mode v2 ----
        // Everything starts DENIED: no cookies, no device storage. In the
        // denied state GA4 sends only cookieless, non-identifying pings,
        // which Google uses for behavioural modelling — so we get fuller
        // (modelled) analytics from the silent majority who never touch the
        // banner, WITHOUT storing anything on their device. Storage (and
        // ads) only turn on if the visitor explicitly clicks "Accept all".
        // Someone who explicitly clicks "Essential only" gets nothing
        // loaded at all — we honour the opt-out literally.
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag("consent", "default", {
          ad_storage: "denied",
          analytics_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          wait_for_update: 500
        });

        var gaLoaded = false, adsLoaded = false;
        function loadGA() {
          if (gaLoaded) return; gaLoaded = true;
          gtag("js", new Date());
          gtag("config", GA4_ID, { anonymize_ip: true });
          var ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=" + GA4_ID;
          document.head.appendChild(ga);
        }
        function loadAds() {
          if (adsLoaded) return; adsLoaded = true;
          var ad = document.createElement("script");
          ad.async = true;
          ad.crossOrigin = "anonymous";
          ad.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + ADSENSE_CLIENT;
          ad.onload = function () {
            try {
              document.querySelectorAll("ins.adsbygoogle:not([data-adsbygoogle-status])").forEach(function () {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              });
            } catch (e) { /* AdSense will retry */ }
          };
          document.head.appendChild(ad);
        }
        function grantAll() {
          gtag("consent", "update", {
            ad_storage: "granted",
            analytics_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted"
          });
          loadGA();
          loadAds();
        }
        function idle(fn) {
          if ("requestIdleCallback" in window) requestIdleCallback(fn, { timeout: 2500 });
          else if (document.readyState === "complete") setTimeout(fn, 0);
          else window.addEventListener("load", function () { setTimeout(fn, 800); });
        }

        var c = consent();
        if (c === "all") {
          // Returning visitor who accepted — full consent + ads.
          idle(grantAll);
        } else if (c === "essential") {
          // Explicit opt-out — load nothing, send nothing.
        } else {
          // No choice yet — privacy-preserving cookieless analytics only
          // (denied consent state; modelled, no storage). No ads.
          idle(loadGA);
        }

        // Same-tab path: the banner dispatches this when the visitor decides.
        window.addEventListener("mcg:consent", function (e) {
          if (e && e.detail === "all") grantAll();
          // "essential" → stays denied; nothing further loads.
        });
        // Cross-tab path: another tab may accept.
        window.addEventListener("storage", function (e) {
          if (e.key === "mcg-consent" && e.newValue === "all") grantAll();
        });
      })();
    </script>

    {/*
      mcgEvent — site-wide GA4 event helper. Tool pages call
      `mcgEvent("play_audio", {wpm: 18})` without caring whether
      analytics is loaded: if the visitor hasn't accepted the "ads"
      consent category, `window.gtag` never exists and the call is a
      silent no-op. Events before consent are intentionally dropped,
      not queued.
    */}
    <script is:inline>
      window.mcgEvent = function (name, params) {
        try {
          if (typeof window.gtag === "function" && name) {
            window.gtag("event", String(name), params || {});
          }
        } catch (e) { /* analytics must never break a tool */ }
      };
      // Delegated affiliate-click tracking: any <a data-aff="..."> fires
      // one event. Lives here (not per-page) so every current and future
      // monetized page gets it for free.
      document.addEventListener("click", function (e) {
        var a = e.target && e.target.closest ? e.target.closest("a[data-aff]") : null;
        if (a) window.mcgEvent("affiliate_click", { item: a.getAttribute("data-aff"), page: location.pathname });
      });
    </script>

    {/* Service worker: pre-caches the app shell so the site keeps working offline.
        Registration is deferred to first idle so it never competes with first paint. */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        var register = function () {
          navigator.serviceWorker.register("/sw.js", { scope: "/" })
            .catch(function () { /* ignore — SW is a nice-to-have */ });
        };
        if ("requestIdleCallback" in window) {
          requestIdleCallback(register, { timeout: 4000 });
        } else {
          window.addEventListener("load", function () { setTimeout(register, 1200); });
        }
      }
    </script>
  </head>

