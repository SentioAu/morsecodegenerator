---
const {
  title = "Morse Code Generator",
  description = "Translate text to Morse code instantly, learn the alphabet, and practice common phrases.",
  robots = "index,follow",
  canonical: canonicalProp,
  ogType = "website",
  keywords,
  publishedTime,
  modifiedTime,
} = Astro.props;

const CONTACT_EMAIL = "morsecodegenerator@gmail.com";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://morsecodegenerator.com";

const path = Astro.url.pathname || "/";

// Canonical must follow trailingSlash: "always"
const normalizedPath =
  path === "/" ? "/" : path.endsWith("/") ? path : `${path}/`;

// Default canonical (auto)
const canonicalAuto = `${site}${normalizedPath}`;

// Final canonical (page override wins)
const canonical = String(canonicalProp || canonicalAuto);

// Locale handling (?lang=es supported across pages)
const lang = (Astro.url.searchParams.get("lang") || "en").toLowerCase();
const htmlLang = lang === "es" ? "es" : "en";
const ogLocale = htmlLang === "es" ? "es_ES" : "en_US";
const ogLocaleAlt = htmlLang === "es" ? "en_US" : "es_ES";

// hreflang alternates — only emit when the page actually has ES content.
// Right now only /translate/ ships Spanish strings; everywhere else, advertising
// ?lang=es would point Google at a non-localized page (= soft 404 risk).
const hasEsVersion = /\/translate\/?$/.test(normalizedPath);
const hrefEn = canonical.replace(/[?&]lang=es/, "");
const hrefEs = canonical.includes("?")
  ? canonical.replace(/([?&])lang=[a-z]{2}/i, "") + (canonical.includes("?lang=") ? "" : "&lang=es")
  : `${canonical}?lang=es`;

// Active nav helper
const isActive = (href) => {
  const p = (normalizedPath || "/").replace(/\/$/, "") || "/";
  const h = (href || "/").replace(/\/$/, "") || "/";
  return p === h || (h !== "/" && p.startsWith(h));
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}#org`,
      name: "MorseCodeGenerator.com",
      alternateName: ["Morse Code Generator", "MorseGen"],
      url: site,
      email: CONTACT_EMAIL,
      logo: {
        "@type": "ImageObject",
        url: `${site}/favicon.svg`,
        width: 512,
        height: 512,
      },
      sameAs: ["https://sentioaurum.com/"],
    },
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: "Morse Code Generator",
      description: "The hub of Morse code: translator, learning tools, audio practice, and reference.",
      inLanguage: ["en", "es"],
      publisher: { "@id": `${site}#org` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${site}/translate/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site}#app`,
      name: "Morse Code Translator",
      applicationCategory: "EducationalApplication",
      operatingSystem: "Any (web browser)",
      url: `${site}/translate/`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: [
        "Text to Morse code conversion",
        "Morse to text decoding",
        "Audio playback (Web Audio)",
        "Adjustable speed (10–30 WPM)",
        "Koch-method practice",
        "Shareable links",
      ],
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        ratingCount: "412",
        bestRating: "5",
      },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="author" content="MorseCodeGenerator.com" />
    <meta name="generator" content="Astro" />

    {/* hreflang — only on pages that actually have a localized version */}
    {hasEsVersion && (
      <>
        <link rel="alternate" href={hrefEn} hreflang="en" />
        <link rel="alternate" href={hrefEs} hreflang="es" />
        <link rel="alternate" href={hrefEn} hreflang="x-default" />
      </>
    )}

    <!-- Favicon + PWA -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- AI / agent discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs map (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full content for LLMs" />

    <!-- Typography (Inter + Space Grotesk) — trimmed weights, async-ish via media swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Preload core data so tools start fast -->
    <link rel="preload" as="fetch" href="/morse.json" type="application/json" crossorigin="anonymous" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Morse Code Generator" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={`${site}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Morse Code Generator preview banner" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.svg`} />

    <meta name="application-name" content="Morse Code Generator" />
    <meta name="apple-mobile-web-app-title" content="MorseGen" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />

    <!-- ✅ JSON-LD must be unescaped -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>

    {/* Analytics + AdSense — loaded after first idle to keep LCP fast */}
    <script is:inline>
      (function () {
        function load() {
          if (window.__mcgLoadedAds) return;
          window.__mcgLoadedAds = true;

          // GA4
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", "G-1K9JZ9ZQ2L", { anonymize_ip: true });
          var ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-1K9JZ9ZQ2L";
          document.head.appendChild(ga);

          // AdSense loader (no slots = no requests, just sets up adsbygoogle)
          var ad = document.createElement("script");
          ad.async = true;
          ad.crossOrigin = "anonymous";
          ad.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7616383336440831";
          document.head.appendChild(ad);
        }
        if ("requestIdleCallback" in window) {
          requestIdleCallback(load, { timeout: 2500 });
        } else {
          window.addEventListener("load", function () { setTimeout(load, 800); });
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="MorseCodeGenerator.com home">
          <span class="brand-mark" aria-hidden="true">·–</span>
          <span class="brand-text">MorseCodeGenerator.com</span>
        </a>

        <nav class="nav" id="primaryNav" aria-label="Primary">
          <a
            class:list={["nav-link", isActive("/translate/") && "active"]}
            href="/translate/"
            aria-current={isActive("/translate/") ? "page" : undefined}
          >Translate</a>

          <a
            class:list={["nav-link", isActive("/practice/") && "active"]}
            href="/practice/"
            aria-current={isActive("/practice/") ? "page" : undefined}
          >Practice</a>

          <a
            class:list={["nav-link", isActive("/morse-code/") && "active"]}
            href="/morse-code/"
            aria-current={isActive("/morse-code/") ? "page" : undefined}
          >Learn</a>

          <a
            class:list={["nav-link", isActive("/chart/") && "active"]}
            href="/chart/"
            aria-current={isActive("/chart/") ? "page" : undefined}
          >Chart</a>

          <a
            class:list={["nav-link", isActive("/phrases/") && "active"]}
            href="/phrases/"
            aria-current={isActive("/phrases/") ? "page" : undefined}
          >Phrases</a>

          <a
            class:list={["nav-link", isActive("/faq/") && "active"]}
            href="/faq/"
            aria-current={isActive("/faq/") ? "page" : undefined}
          >FAQ</a>
        </nav>

        <div class="header-tools" aria-label="Site controls">
          {hasEsVersion && (
            <label class="lang-select">
              <span class="sr-only">Language</span>
              <select id="langToggle" aria-label="Language">
                <option value="en">English</option>
                <option value="es">Español</option>
              </select>
            </label>
          )}

          <button class="nav-toggle" type="button" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="primaryNav">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/>
            </svg>
          </button>

          <button class="theme-toggle" type="button" id="themeToggle" aria-label="Toggle theme">
            <svg class="ic-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg class="ic-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="content" class="wrap main-wrap">
      <div class="panel">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-mega" role="navigation" aria-label="Footer">
          <div class="foot-col">
            <h4 class="foot-h">Tools</h4>
            <ul>
              <li><a href="/translate/">Translator</a></li>
              <li><a href="/practice/">Practice / Koch trainer</a></li>
              <li><a href="/chart/">Printable chart</a></li>
              <li><a href="/embed/">Embed widget</a></li>
              <li><a href="/api/">Developer API</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4 class="foot-h">Learn</h4>
            <ul>
              <li><a href="/morse-code/">Alphabet (A–Z)</a></li>
              <li><a href="/morse-code/numbers/">Numbers (0–9)</a></li>
              <li><a href="/morse-code/punctuation/">Punctuation</a></li>
              <li><a href="/morse-code/words/">Words A–Z</a></li>
              <li><a href="/prosigns/">Prosigns</a></li>
              <li><a href="/abbreviations/">CW abbreviations</a></li>
              <li><a href="/q-codes/">Q-codes</a></li>
              <li><a href="/nato/">NATO phonetic</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4 class="foot-h">Reference</h4>
            <ul>
              <li><a href="/phrases/">Common phrases</a></li>
              <li><a href="/history/">History of Morse</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/morse.json">/morse.json (data)</a></li>
              <li><a href="/llms.txt">/llms.txt</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4 class="foot-h">Site</h4>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
              <li><a href="/sitemap.xml">Sitemap</a></li>
            </ul>
          </div>
        </div>

        <div class="foot-inner">
          <small class="foot-text">
            © {new Date().getFullYear()} MorseCodeGenerator.com — the hub of Morse code.
          </small>
          <small class="foot-brand">
            <a class="foot-link" href={`mailto:${CONTACT_EMAIL}`}>Email</a>
            <span class="dot" aria-hidden="true">•</span>
            Project by
            <a
              class="foot-link"
              href="https://sentioaurum.com/"
              target="_blank"
              rel="noopener noreferrer"
            >SentioAurum</a>
          </small>
        </div>
      </div>
    </footer>

    <style>
      :root{
        color-scheme: dark;

        --bg: #0b0b0b;
        --bg2: rgba(255,255,255,0.02);

        --panel: rgba(255,255,255,0.050);
        --panel2: rgba(255,255,255,0.020);

        --border: rgba(255,255,255,0.11);
        --border2: rgba(255,255,255,0.16);

        --text: rgba(255,255,255,0.94);
        --muted: rgba(255,255,255,0.74);

        --accent: #8ab4ff;
        --accentBg: rgba(138,180,255,0.14);
        --accentStrong: #a7c5ff;
        --accentSoft: rgba(138,180,255,0.22);
        --accentAlt: #7ef0ff;

        --shadow: 0 14px 40px rgba(0,0,0,0.45);

        --contentMax: 74ch;
        --focus: rgba(138,180,255,0.55);

        --radius-xl: 24px;
        --radius-lg: 18px;

        --font-body: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        --font-display: "Space Grotesk", "Inter", system-ui, sans-serif;

        --pageMax: 1160px;
        --panelMax: 1080px;
      }

      :root[data-theme="light"]{
        color-scheme: light;
        --bg: #f6f7fb;
        --bg2: rgba(0,0,0,0.04);
        --panel: rgba(255,255,255,0.9);
        --panel2: rgba(255,255,255,0.7);
        --border: rgba(0,0,0,0.08);
        --border2: rgba(0,0,0,0.12);
        --text: rgba(14,18,24,0.96);
        --muted: rgba(14,18,24,0.65);
        --accent: #2b6dff;
        --accentBg: rgba(43,109,255,0.15);
        --accentStrong: #1f5ae8;
        --accentSoft: rgba(43,109,255,0.20);
        --accentAlt: #1db4c7;
        --shadow: 0 18px 36px rgba(15,20,30,0.15);
      }
      *{ box-sizing:border-box; }
      html, body{ height:100%; }
      html{ overflow-x: clip; }
      body{ overflow-x: clip; }

      body{
        font-family: var(--font-body);
        margin:0;
        line-height:1.65;
        background:
          radial-gradient(1200px 600px at 50% -10%, rgba(138,180,255,0.10), transparent 65%),
          radial-gradient(900px 520px at 90% 18%, rgba(126,240,255,0.08), transparent 60%),
          radial-gradient(800px 460px at 10% 65%, rgba(138,180,255,0.06), transparent 60%),
          var(--bg);
        color: var(--text);
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        min-height: 100vh;
        display:flex;
        flex-direction:column;
      }

      .skip{
        position:absolute;
        left:-9999px;
        top:auto;
        width:1px;height:1px;
        overflow:hidden;
      }
      .skip:focus{
        left: 14px;
        top: 14px;
        width:auto;height:auto;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0,0,0,0.82);
        border: 1px solid var(--border);
        box-shadow: 0 0 0 3px var(--focus);
        z-index: 999;
      }

      h1,h2,h3{ line-height:1.12; letter-spacing:-0.02em; margin:0 0 10px; font-family: var(--font-display); }
      h1{ font-size: clamp(30px, 3.1vw, 44px); }
      h2{ font-size: clamp(20px, 2.0vw, 28px); margin-top: 22px; }
      h3{ font-size: 16px; margin-top: 12px; }

      p{ margin:10px 0; }
      ol, ul{ margin:10px 0 0; }
      li{ margin:6px 0; }
      p,ol,ul{ max-width: var(--contentMax); }

      a{ color: var(--accent); text-underline-offset: 3px; }
      a:hover{ opacity:0.92; }

      .wrap{
        width:100%;
        max-width: var(--pageMax);
        margin-left:auto;
        margin-right:auto;
        padding: 18px;
      }

      .site-header{
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(12px);
        background: rgba(11,11,11,0.70);
        border-bottom: 1px solid var(--border);
      }
      :root[data-theme="light"] .site-header{
        background: rgba(246,247,251,0.86);
      }

      /* Slightly tighter header padding than the rest of the page */
      .site-header .wrap{
        padding-top: 14px;
        padding-bottom: 14px;
      }

      .header-inner{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: 14px;
      }

      .header-tools{
        display:flex;
        align-items:center;
        gap: 8px;
      }
      .nav-toggle{
        display: none;
        min-height: 36px;
        min-width: 36px;
        align-items:center;
        justify-content:center;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--panel2);
        color: var(--text);
        padding: 0;
      }
      .ic-sun{ display: none; }
      .ic-moon{ display: inline-block; }
      :root[data-theme="light"] .ic-sun{ display: inline-block; }
      :root[data-theme="light"] .ic-moon{ display: none; }
      .lang-select select{
        min-height: 36px;
        padding: 6px 28px 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.03);
        color: var(--text);
        font-size: 14px;
        width: auto;
      }
      :root[data-theme="light"] .lang-select select{
        border-color: rgba(0,0,0,0.12);
        background: rgba(255,255,255,0.8);
      }
      .theme-toggle{
        min-height: 36px;
        min-width: 36px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.03);
        color: var(--text);
      }
      :root[data-theme="light"] .theme-toggle{
        border-color: rgba(0,0,0,0.12);
        background: rgba(255,255,255,0.8);
      }

      .sr-only{
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        border: 0;
      }

      .brand{
        display:inline-flex;
        align-items:center;
        gap: 10px;
        text-decoration:none;
        color: var(--text);
        font-weight: 850;
        white-space: nowrap;
        letter-spacing: -0.01em;
      }

      .brand-mark{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.03);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 14px;
      }

      .nav{
        display:flex;
        gap: 10px;
        justify-content:flex-end;
        align-items:center;

        /* ✅ Mobile UX: keep pills in a single row and allow horizontal scroll */
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .nav::-webkit-scrollbar{ display:none; }

      .nav-link{
        flex: 0 0 auto;
        text-decoration:none;
        color: var(--text);
        padding: 9px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.025);
        font-weight: 750;
        transition: background .12s ease, border-color .12s ease, transform .12s ease;
        white-space: nowrap;
      }
      .nav-link:hover{
        border-color: rgba(255,255,255,0.20);
        background: rgba(255,255,255,0.055);
      }
      .nav-link:active{ transform: translateY(1px); }

      .nav-link.active{
        border-color: rgba(138,180,255,0.32);
        background: rgba(138,180,255,0.10);
      }
      .nav-link.contact{
        border-color: rgba(138,180,255,0.30);
        background: rgba(138,180,255,0.10);
      }

      .main-wrap{
        flex: 1;
        display:flex;
        justify-content:center;
        padding-top: 18px;
        padding-bottom: 22px;
      }

      .panel{
        width:100%;
        max-width: var(--panelMax);
        margin-left:auto;
        margin-right:auto;
        background:
          linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.02));
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
        padding: 26px;
        overflow:hidden;
      }

      /* ---------- Global UI primitives (used across pages) ---------- */
      .muted{ color: var(--muted); }
      .k{ font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .2px; }

      .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        text-decoration:none;
        border: 1px solid rgba(255,255,255,0.16);
        background: rgba(255,255,255,0.03);
        color: rgba(255,255,255,0.92);
        font-weight: 850;
        line-height: 1;
        gap: 8px;
        transition: opacity .12s ease, transform .12s ease, border-color .12s ease, background .12s ease;
      }
      .btn:hover{ opacity: .95; }
      .btn:active{ transform: translateY(1px); }
      .btn.primary{
        border-color: rgba(138,180,255,0.45);
        background: linear-gradient(120deg, rgba(138,180,255,0.30), rgba(126,240,255,0.16));
        box-shadow: 0 10px 24px rgba(74,110,192,0.28);
      }
      .btn.secondary{
        border-color: rgba(255,255,255,0.22);
        background: rgba(255,255,255,0.07);
        font-weight: 750;
      }
      .btn.ghost{
        border-color: rgba(255,255,255,0.16);
        background: rgba(255,255,255,0.03);
        font-weight: 750;
      }

      .chip{
        display:inline-flex;
        align-items:center;
        padding: 7px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.82);
        font-size: 13px;
        line-height: 1.2;
      }

      .card{
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 18px;
        background: rgba(255,255,255,0.025);
      }
      .card.soft{
        border-color: rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.02);
      }
      .card.glow{
        border-color: rgba(138,180,255,0.30);
        background: linear-gradient(180deg, rgba(138,180,255,0.10), rgba(255,255,255,0.02));
        box-shadow: 0 18px 38px rgba(12,20,48,0.40);
      }

      .section{
        margin-top: 32px;
      }
      .section.alt{
        padding: 22px;
        border-radius: 20px;
        border: 1px solid rgba(138,180,255,0.18);
        background: linear-gradient(140deg, rgba(138,180,255,0.08), rgba(255,255,255,0.02));
      }
      .section-head{
        display:flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 18px;
      }
      .section-title{
        margin: 0;
        font-size: clamp(22px, 2.2vw, 32px);
      }
      .section-sub{
        margin: 0;
        max-width: 72ch;
      }

      .page-hero{
        margin: 6px 0 18px;
      }
      .page-hero.center{ text-align:center; }
      .page-hero-kicker{
        margin: 0 0 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 12px;
        color: var(--accentStrong);
      }
      .page-hero-title{ margin: 0 0 10px; font-size: clamp(28px, 3vw, 44px); }
      .page-hero-sub{ margin: 0; max-width: 72ch; }
      .page-hero-actions{
        margin-top: 14px;
        display:flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items:center;
      }
      .page-hero.center .page-hero-actions{ justify-content:center; }
      .page-hero-chips{
        margin-top: 14px;
        display:flex;
        flex-wrap:wrap;
        gap: 8px;
        align-items:center;
      }

      .grid{
        display:grid;
        grid-template-columns: 1fr;
        gap: 14px;
        align-items: start;
      }
      @media (min-width: 900px){
        .grid{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
      }

      .pill-grid{
        display:grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        list-style:none;
        padding:0;
        margin:0;
      }
      @media (min-width: 900px){
        .pill-grid{ grid-template-columns: repeat(4, minmax(0,1fr)); }
      }

      .pill-grid a{
        display:block;
        text-decoration:none;
        color: var(--text);
        text-align:center;
        padding: 10px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.02);
        font-weight: 750;
        transition: background .12s ease, border-color .12s ease, transform .12s ease;
      }
      .pill-grid a:hover{
        border-color: rgba(255,255,255,0.22);
        background: rgba(255,255,255,0.06);
      }
      .pill-grid a:active{ transform: translateY(1px); }

      /* ---------- Prose + tables (for dense reference pages) ---------- */
      .prose{ max-width: var(--contentMax); }
      .prose h2{ margin-top: 28px; }
      .prose hr{
        border:0;
        border-top:1px solid var(--border);
        margin: 18px 0;
      }

      table{
        width:100%;
        border-collapse: separate;
        border-spacing: 0;
        border:1px solid var(--border);
        border-radius: 14px;
        overflow:hidden;
        background: rgba(255,255,255,0.015);
      }
      th, td{
        text-align:left;
        padding: 10px 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        vertical-align: top;
      }
      th{
        color: rgba(255,255,255,0.86);
        font-weight: 800;
        background: rgba(255,255,255,0.02);
      }
      tr:last-child td{ border-bottom: 0; }

      /* ---------- Form controls ---------- */
      textarea, input, select, button{
        font-family: inherit;
        font-size: 16px;
        line-height: 1.45;
      }

      textarea, input, select{
        width:100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border2);
        background: rgba(0,0,0,0.18);
        color: var(--text);
        outline:none;
      }

      textarea{
        resize: vertical;
        min-height: 180px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      textarea::placeholder, input::placeholder{
        color: rgba(255,255,255,0.50);
      }

      select{
        appearance:none;
        -webkit-appearance:none;
        -moz-appearance:none;
        padding-right:36px;
        background-image:
          linear-gradient(45deg, transparent 50%, rgba(255,255,255,0.65) 50%),
          linear-gradient(135deg, rgba(255,255,255,0.65) 50%, transparent 50%);
        background-position:
          calc(100% - 18px) calc(50% - 3px),
          calc(100% - 12px) calc(50% - 3px);
        background-size: 6px 6px, 6px 6px;
        background-repeat:no-repeat;
      }

      select option{
        background: #0b0b0b;
        color: rgba(255,255,255,0.92);
      }

      textarea:focus, input:focus, select:focus, button:focus,
      a.nav-link:focus, a.btn:focus{
        box-shadow: 0 0 0 3px var(--focus);
        border-color: rgba(138,180,255,0.38);
      }

      button{
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid rgba(138,180,255,0.35);
        background: var(--accentBg);
        color: var(--text);
        cursor:pointer;
        font-weight: 850;
        transition: opacity .12s ease, transform .12s ease;
      }
      button:hover{ opacity:0.95; }
      button:active{ transform: translateY(1px); }

      /* ---------- Footer ---------- */
      .site-footer{
        border-top: 1px solid var(--border);
        margin-top: 10px;
        padding-bottom: 26px;
      }
      .foot-mega{
        display:grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 22px 28px;
        padding: 22px 0 6px;
      }
      @media (min-width: 760px){
        .foot-mega{ grid-template-columns: repeat(4, minmax(0,1fr)); }
      }
      .foot-col h4{
        margin: 0 0 10px;
        font-size: 13px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
        font-family: var(--font-display);
      }
      .foot-col ul{
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 6px;
      }
      .foot-col li{ margin: 0; }
      .foot-col a{
        text-decoration: none;
        color: var(--text);
        opacity: .88;
      }
      .foot-col a:hover{ opacity: 1; text-decoration: underline; }

      .foot-inner{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: 12px;
        padding-top: 16px;
        border-top: 1px dashed var(--border);
      }
      .foot-text{ color: rgba(255,255,255,0.70); }
      .foot-brand{ color: rgba(255,255,255,0.70); white-space: nowrap; }
      .foot-link{ color: var(--accent); text-decoration:none; }
      .foot-link:hover{ opacity:0.92; text-decoration: underline; }
      .dot{ opacity:.55; margin: 0 8px; }

      @media (min-width: 980px){
        .section-head{ flex-direction: row; align-items: flex-end; justify-content: space-between; }
        .section-sub{ text-align: right; }
      }

      @media (max-width: 820px){
        .wrap{ padding: 14px; }
        .panel{ padding: 18px; }
        .site-header .wrap{ padding-top: 12px; padding-bottom: 12px; }
        .header-inner{ display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items:center; }

        .nav-toggle{ display: inline-flex; order: 2; }

        .nav{
          grid-column: 1 / -1;
          order: 3;
          flex-direction: column;
          align-items: stretch;
          background: var(--panel);
          border: 1px solid var(--border);
          border-radius: 16px;
          padding: 8px;
          gap: 4px;
          max-height: 0;
          overflow: hidden;
          opacity: 0;
          transition: max-height .2s ease, opacity .15s ease, padding .15s ease;
        }
        .nav.open{
          max-height: 80vh;
          opacity: 1;
          padding: 8px;
        }
        .nav-link{
          width: 100%;
          text-align: left;
          padding: 11px 14px;
        }
        .header-tools{ order: 1; gap: 6px; }

        p, ol, ul{ max-width: 100%; }
        .foot-inner{ flex-direction: column; align-items: flex-start; }
        .foot-brand{ white-space: normal; }
        .dot{ display:none; }
      }
      @media (prefers-reduced-motion: reduce){
        .nav, .nav-link, .btn, .theme-toggle, .nav-toggle{ transition: none !important; }
      }
    </style>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const savedTheme = localStorage.getItem("mcg-theme");
        const systemDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme = savedTheme || (systemDark ? "dark" : "light");
        root.dataset.theme = initialTheme;

        const themeBtn = document.getElementById("themeToggle");
        themeBtn?.addEventListener("click", () => {
          const next = root.dataset.theme === "light" ? "dark" : "light";
          root.dataset.theme = next;
          localStorage.setItem("mcg-theme", next);
        });

        const langSelect = document.getElementById("langToggle");
        if (langSelect) {
          const url = new URL(window.location.href);
          const current = url.searchParams.get("lang") || "en";
          langSelect.value = current;
          langSelect.addEventListener("change", () => {
            const nextLang = langSelect.value;
            if (nextLang === "en") url.searchParams.delete("lang");
            else url.searchParams.set("lang", nextLang);
            window.location.href = url.toString();
          });
        }

        const navToggle = document.getElementById("navToggle");
        const primaryNav = document.getElementById("primaryNav");
        if (navToggle && primaryNav) {
          const close = () => {
            primaryNav.classList.remove("open");
            navToggle.setAttribute("aria-expanded", "false");
            navToggle.setAttribute("aria-label", "Open menu");
          };
          const open = () => {
            primaryNav.classList.add("open");
            navToggle.setAttribute("aria-expanded", "true");
            navToggle.setAttribute("aria-label", "Close menu");
          };
          navToggle.addEventListener("click", () => {
            primaryNav.classList.contains("open") ? close() : open();
          });
          // Auto-close on nav-link click (mobile)
          primaryNav.querySelectorAll("a.nav-link").forEach((a) => {
            a.addEventListener("click", close);
          });
          // Auto-close when leaving mobile breakpoint
          const mq = window.matchMedia("(min-width: 821px)");
          const onMq = (e) => { if (e.matches) close(); };
          mq.addEventListener?.("change", onMq);
        }
      })();
    </script>
  </body>
</html>
